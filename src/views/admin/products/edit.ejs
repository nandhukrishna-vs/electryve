<div class="container-fluid py-4">

    <!-- Page Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                Edit Product

            </h2>

            <p class="text-muted mb-0">

                Update Product Information

            </p>

        </div>

        <a
            href="/admin/products"
            class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-2"></i>

            Back

        </a>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <% if(message){ %>

                <div class="alert alert-danger">

                    <%= message %>

                </div>

            <% } %>

            <form
                id="productForm"
                action="/admin/products/edit/<%= product._id %>"
                method="POST"
                enctype="multipart/form-data">

                <!-- Product Name -->

                <div class="mb-3">

                    <label class="form-label fw-semibold">

                        Product Name

                    </label>

                    <input
                        type="text"
                        name="name"
                        class="form-control <%= errors.name ? 'is-invalid' : '' %>"
                        value="<%= product.name || '' %>">

                    <% if(errors.name){ %>

                        <div class="invalid-feedback">

                            <%= errors.name %>

                        </div>

                    <% } %>

                </div>

                <!-- Description -->

                <div class="mb-3">

                    <label class="form-label fw-semibold">

                        Description

                    </label>

                    <textarea
                        rows="5"
                        name="description"
                        class="form-control <%= errors.description ? 'is-invalid' : '' %>"><%= product.description || "" %></textarea>

                    <% if(errors.description){ %>

                        <div class="invalid-feedback">

                            <%= errors.description %>

                        </div>

                    <% } %>

                </div>

                <div class="row">

                    <!-- Category -->

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-semibold">

                            Category

                        </label>

                        <select
                            name="category"
                            class="form-select <%= errors.category ? 'is-invalid' : '' %>">

                            <option value="">

                                Select Category

                            </option>

                            <% categories.forEach(category=>{ %>

                                <option
                                    value="<%= category._id %>"
                                    <%= (product.category && (typeof product.category === 'object' ? product.category._id.toString() : product.category.toString()) === category._id.toString()) ? "selected" : "" %>>

                                    <%= category.name %>

                                </option>

                            <% }) %>

                        </select>

                        <% if(errors.category){ %>

                            <div class="invalid-feedback">

                                <%= errors.category %>

                            </div>

                        <% } %>

                    </div>

                    <!-- Brand -->

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-semibold">

                            Brand

                        </label>

                        <select
                            name="brand"
                            class="form-select <%= errors.brand ? 'is-invalid' : '' %>">

                            <option value="">

                                Select Brand

                            </option>

                            <% brands.forEach(brand=>{ %>

                                <option
                                    value="<%= brand._id %>"
                                    <%= (product.brand && (typeof product.brand === 'object' ? product.brand._id.toString() : product.brand.toString()) === brand._id.toString()) ? "selected" : "" %>>

                                    <%= brand.name %>

                                </option>

                            <% }) %>

                        </select>

                        <% if(errors.brand){ %>

                            <div class="invalid-feedback">

                                <%= errors.brand %>

                            </div>

                        <% } %>

                    </div>

                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <h4 class="fw-bold mb-0">

                        Product Variants

                    </h4>

                    <button
                        type="button"
                        class="btn btn-dark"
                        id="addVariantBtn">

                        <i class="bi bi-plus-circle me-2"></i>

                        Add Variant

                    </button>

                </div>

                

<div id="variantContainer"></div>


<template id="variantTemplate">

    <div class="card shadow-sm border-0 mb-4 variant-card">

        <div class="card-header d-flex justify-content-between align-items-center">

            <div>

                <h5 class="mb-0 variant-title">

                    Variant 1

                </h5>

                <small class="text-muted variant-subtitle">

                    New Variant

                </small>

            </div>

            <button
                type="button"
                class="btn btn-outline-danger btn-sm removeVariant">

                <i class="bi bi-trash me-1"></i>

                Remove

            </button>

        </div>

        <div class="card-body">

            <input type="hidden" data-field="_id" class="variant-id">

            <div class="row">

                <!-- Color -->

                <div class="col-md-6 mb-3">

                    <label class="form-label fw-semibold">

                        Color

                    </label>

                    <input
                        type="text"
                        class="form-control variant-color"
                        data-field="color"
                        placeholder="Black">

                </div>

                <!-- Capacity -->

                <div class="col-md-6 mb-3">

                    <label class="form-label fw-semibold">

                        Capacity

                    </label>

                    <input
                        type="text"
                        class="form-control variant-capacity"
                        data-field="storage"
                        placeholder="128 GB">

                </div>

                <!-- SKU -->

                <div class="col-md-6 mb-3">

                    <label class="form-label fw-semibold">

                        SKU

                    </label>

                    <input
                        type="text"
                        class="form-control"
                        data-field="sku"
                        placeholder="APL-IP16-BLK-128">

                </div>

                <!-- Regular Price -->

                <div class="col-md-6 mb-3">

                    <label class="form-label fw-semibold">

                        Regular Price

                    </label>

                    <input
                        type="number"
                        class="form-control"
                        data-field="regularPrice">

                </div>

                <!-- Sale Price -->

                <div class="col-md-6 mb-3">

                    <label class="form-label fw-semibold">

                        Sale Price

                    </label>

                    <input
                        type="number"
                        class="form-control"
                        data-field="salePrice">

                </div>

                <!-- Stock -->

                <div class="col-md-6 mb-3">

                    <label class="form-label fw-semibold">

                        Stock

                    </label>

                    <input
                        type="number"
                        class="form-control"
                        data-field="stock">

                </div>

                <!-- Images -->

                <div class="col-12 mb-3">

                    <label class="form-label fw-semibold">

                        Variant Images

                    </label>

                    <input
                        type="file"
                        class="form-control variantImages"
                        multiple
                        accept="image/*">

                    <small class="text-muted">

                        Upload 3 to 5 images.

                    </small>

                </div>

                <!-- Preview -->

                <!-- Existing Images -->

<div class="col-12 mb-3">

    <label class="form-label fw-semibold">

        Existing Images

    </label>

    <div class="row existingImageContainer"></div>

</div>

<!-- New Images -->

<div class="col-12">

    <label class="form-label fw-semibold">

        New Images

    </label>

    <div class="row newImagePreviewContainer"></div>

</div>

            </div>

        </div>

    </div>

</template>
<div class="d-flex justify-content-end gap-3 mt-4">

    <a
        href="/admin/products"
        class="btn btn-outline-secondary">
        Cancel
    </a>

    <button
        type="submit"
        class="btn btn-dark">
        <i class="bi bi-check-circle me-2"></i>
        Save Changes
    </button>

</div>
</form>

</div>

</div>
<!-- ================= Image Crop Modal ================= -->
<div class="modal fade crop-modal-wrapper" id="cropModal" tabindex="-1" aria-labelledby="cropModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered crop-modal-dialog">
        <div class="modal-content border-0 shadow-lg crop-modal-content">
            <!-- Modal Header -->
            <div class="modal-header bg-dark text-white px-4 py-3 border-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="crop-modal-icon-badge">
                        <i class="bi bi-crop text-white"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0 text-white" id="cropModalLabel">
                            <span id="cropModalTitle">Crop & Adjust Image</span>
                        </h5>
                        <small class="text-white-50" id="cropImageInfo">Standardize product image to 1:1 aspect ratio</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-secondary text-light px-2 py-1" id="cropBatchIndicator" style="display: none;">
                        Image 1 of 3
                    </span>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="cropModalCloseBtn"></button>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="modal-body crop-modal-body p-3 p-md-4 bg-light">
                <!-- Controls Toolbar -->
                <div class="crop-toolbar card border-0 shadow-sm mb-3">
                    <div class="card-body p-2 d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <!-- Zoom Controls -->
                        <div class="btn-group btn-group-sm" role="group" aria-label="Zoom controls">
                            <button type="button" class="btn btn-outline-secondary" id="cropZoomInBtn" title="Zoom In">
                                <i class="bi bi-zoom-in"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary" id="cropZoomOutBtn" title="Zoom Out">
                                <i class="bi bi-zoom-out"></i>
                            </button>
                        </div>

                        <!-- Rotation Controls -->
                        <div class="btn-group btn-group-sm" role="group" aria-label="Rotation controls">
                            <button type="button" class="btn btn-outline-secondary" id="cropRotateLeftBtn" title="Rotate Counterclockwise 90°">
                                <i class="bi bi-arrow-counterclockwise"></i> Rotate -90°
                            </button>
                            <button type="button" class="btn btn-outline-secondary" id="cropRotateRightBtn" title="Rotate Clockwise 90°">
                                <i class="bi bi-arrow-clockwise"></i> Rotate +90°
                            </button>
                        </div>

                        <!-- Flip Controls -->
                        <div class="btn-group btn-group-sm" role="group" aria-label="Flip controls">
                            <button type="button" class="btn btn-outline-secondary" id="cropFlipHBtn" title="Flip Horizontal">
                                <i class="bi bi-symmetry-vertical"></i> Flip H
                            </button>
                            <button type="button" class="btn btn-outline-secondary" id="cropFlipVBtn" title="Flip Vertical">
                                <i class="bi bi-symmetry-horizontal"></i> Flip V
                            </button>
                        </div>

                        <!-- Aspect Ratio Presets -->
                        <div class="btn-group btn-group-sm" role="group" aria-label="Aspect ratio">
                            <button type="button" class="btn btn-dark active" id="cropAspect11Btn" title="Product Square 1:1">
                                1:1 Square
                            </button>
                            <button type="button" class="btn btn-outline-secondary" id="cropAspectFreeBtn" title="Free Aspect Ratio">
                                Free
                            </button>
                        </div>

                        <!-- Reset -->
                        <button type="button" class="btn btn-outline-danger btn-sm ms-auto" id="cropResetBtn" title="Reset Changes">
                            <i class="bi bi-arrow-counterclockwise"></i> Reset
                        </button>
                    </div>
                </div>

                <!-- Canvas Workspace Container -->
                <div class="crop-workspace-container">
                    <img id="cropImage" class="crop-workspace-image" src="" alt="To be cropped">
                </div>

                <!-- Helper Footer Note -->
                <div class="crop-helper-note d-flex justify-content-between align-items-center mt-2 px-1">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i> Drag to reposition or resize the crop area. Scroll to zoom.
                    </small>
                    <small class="text-muted fw-semibold" id="cropResolutionInfo">
                        Output: 800 × 800 px (WebP)
                    </small>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer bg-white px-4 py-3 border-top">
                <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal" id="cropCancelBtn">
                    Cancel
                </button>
                <button type="button" class="btn btn-secondary px-3" id="cropSkipBtn" style="display: none;">
                    Skip This Image
                </button>
                <button type="button" class="btn btn-primary px-4 fw-semibold shadow-sm" id="cropSaveBtn">
                    <i class="bi bi-check-lg me-1"></i> Apply Crop
                </button>
            </div>
        </div>
    </div>
</div>
<script>

window.isEditPage = true;

window.existingVariants =
<%- JSON.stringify(product.variants || []) %>;

</script>

