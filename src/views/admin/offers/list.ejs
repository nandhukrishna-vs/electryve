<div class="container-fluid p-0">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">Offer Management</h2>
            <p class="text-muted small mb-0">Create, manage, and configure product, category, and referral offers.</p>
        </div>
        <div>
            <a href="/admin/offers/add" class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3 shadow-sm fw-medium">
                <i class="bi bi-plus-circle"></i>
                <span>Add Offer</span>
            </a>
        </div>
    </div>

    <!-- Flash Messages -->
    <% if (typeof successMessage !== "undefined" && successMessage) { %>
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <%= successMessage %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <% if (typeof errorMessage !== "undefined" && errorMessage) { %>
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <%= errorMessage %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form action="/admin/offers" method="GET" class="row g-2 align-items-center">
                <div class="col-12 col-sm-6 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input
                            type="text"
                            name="search"
                            class="form-control border-start-0 ps-0"
                            placeholder="Search by offer name or referral code..."
                            value="<%= search || '' %>"
                        >
                    </div>
                </div>

                <div class="col-6 col-sm-3 col-md-2">
                    <select name="scope" class="form-select">
                        <option value="">All Scopes</option>
                        <option value="PRODUCT" <%= scope === 'PRODUCT' ? 'selected' : '' %>>Product</option>
                        <option value="CATEGORY" <%= scope === 'CATEGORY' ? 'selected' : '' %>>Category</option>
                        <option value="REFERRAL" <%= scope === 'REFERRAL' ? 'selected' : '' %>>Referral</option>
                    </select>
                </div>

                <div class="col-6 col-sm-3 col-md-2">
                    <select name="status" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
                        <option value="scheduled" <%= status === 'scheduled' ? 'selected' : '' %>>Scheduled</option>
                        <option value="expired" <%= status === 'expired' ? 'selected' : '' %>>Expired</option>
                        <option value="inactive" <%= status === 'inactive' ? 'selected' : '' %>>Disabled</option>
                    </select>
                </div>

                <div class="col-auto d-flex gap-2">
                    <button type="submit" class="btn btn-dark px-3 fw-medium">Filter</button>
                    <% if (search || scope || status) { %>
                        <a href="/admin/offers" class="btn btn-outline-secondary px-3">Clear</a>
                    <% } %>
                </div>

                <div class="col-12 col-sm-auto ms-sm-auto text-muted small text-sm-end mt-2 mt-sm-0">
                    Showing <strong><%= offers.length %></strong> of <strong><%= totalOffers %></strong> offers
                </div>
            </form>
        </div>
    </div>

    <!-- Offers Table Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
        <div class="card-body p-0">
            <div class="table-responsive" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
                <table class="table table-hover align-middle mb-0" style="min-width: 960px;">
                    <thead class="table-light border-bottom text-uppercase fs-7 text-muted fw-semibold">
                        <tr>
                            <th scope="col" class="ps-3 py-3" style="width: 45px;">#</th>
                            <th scope="col" class="py-3" style="min-width: 180px;">Offer Name</th>
                            <th scope="col" class="py-3" style="min-width: 100px;">Scope</th>
                            <th scope="col" class="py-3" style="min-width: 140px;">Discount</th>
                            <th scope="col" class="py-3" style="min-width: 150px;">Target</th>
                            <th scope="col" class="py-3 text-center" style="min-width: 80px;">Priority</th>
                            <th scope="col" class="py-3" style="min-width: 160px;">Validity</th>
                            <th scope="col" class="py-3 text-center" style="min-width: 90px;">Usage</th>
                            <th scope="col" class="py-3 text-center" style="min-width: 100px;">Status</th>
                            <th scope="col" class="py-3 text-center pe-3" style="min-width: 130px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (offers && offers.length > 0) { %>
                            <% offers.forEach((offer, index) => { %>
                                <%
                                    const now = new Date();
                                    let statusLabel = "Active";
                                    let statusBadgeClass = "bg-success";

                                    if (!offer.isActive) {
                                        statusLabel = "Disabled";
                                        statusBadgeClass = "bg-secondary";
                                    } else if (now < new Date(offer.startAt)) {
                                        statusLabel = "Scheduled";
                                        statusBadgeClass = "bg-info text-dark";
                                    } else if (now > new Date(offer.expiryAt)) {
                                        statusLabel = "Expired";
                                        statusBadgeClass = "bg-danger";
                                    } else if (offer.usageLimit && offer.usedCount >= offer.usageLimit) {
                                        statusLabel = "Exhausted";
                                        statusBadgeClass = "bg-dark";
                                    }

                                    let scopeBadgeClass = "bg-primary-subtle text-primary border border-primary-subtle";
                                    if (offer.scope === 'CATEGORY') scopeBadgeClass = "bg-warning-subtle text-warning-emphasis border border-warning-subtle";
                                    if (offer.scope === 'REFERRAL') scopeBadgeClass = "bg-info-subtle text-info-emphasis border border-info-subtle";
                                %>
                                <tr>
                                    <td class="ps-3 text-muted small">
                                        <%= ((currentPage - 1) * limit) + index + 1 %>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark"><%= offer.name %></div>
                                        <% if (offer.description) { %>
                                            <div class="text-muted small text-truncate" style="max-width: 220px;" title="<%= offer.description %>"><%= offer.description %></div>
                                        <% } %>
                                    </td>
                                    <td>
                                        <span class="badge <%= scopeBadgeClass %> px-2 py-1 fw-semibold" style="font-size: 0.72rem; letter-spacing: 0.3px;">
                                            <%= offer.scope %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if (offer.discountType === 'PERCENTAGE') { %>
                                            <span class="fw-bold text-success"><%= offer.discountValue %>% OFF</span>
                                            <% if (offer.maxDiscountAmount) { %>
                                                <span class="text-muted small d-block" style="font-size: 0.72rem;">Cap: ₹<%= offer.maxDiscountAmount.toLocaleString('en-IN') %></span>
                                            <% } else { %>
                                                <span class="text-muted small d-block" style="font-size: 0.72rem;">No Cap</span>
                                            <% } %>
                                        <% } else { %>
                                            <span class="fw-bold text-primary">₹<%= offer.discountValue.toLocaleString('en-IN') %> OFF</span>
                                            <span class="text-muted small d-block" style="font-size: 0.72rem;">Flat Off</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (offer.scope === 'PRODUCT') { %>
                                            <% const pCount = (offer.products || []).length; %>
                                            <span class="text-dark small fw-medium">
                                                <%= pCount %> <%= pCount === 1 ? 'Product' : 'Products' %>
                                            </span>
                                            <% if (pCount > 0 && offer.products[0]?.name) { %>
                                                <span class="text-muted small d-block text-truncate" style="max-width: 140px;" title="<%= offer.products.map(p => p.name).join(', ') %>">
                                                    <%= offer.products[0].name %><%= pCount > 1 ? ' +' + (pCount - 1) : '' %>
                                                </span>
                                            <% } %>
                                        <% } else if (offer.scope === 'CATEGORY') { %>
                                            <% const cCount = (offer.categories || []).length; %>
                                            <span class="text-dark small fw-medium">
                                                <%= cCount %> <%= cCount === 1 ? 'Category' : 'Categories' %>
                                            </span>
                                            <% if (cCount > 0 && offer.categories[0]?.name) { %>
                                                <span class="text-muted small d-block text-truncate" style="max-width: 140px;" title="<%= offer.categories.map(c => c.name).join(', ') %>">
                                                    <%= offer.categories[0].name %><%= cCount > 1 ? ' +' + (cCount - 1) : '' %>
                                                </span>
                                            <% } %>
                                        <% } else if (offer.scope === 'REFERRAL') { %>
                                            <span class="badge bg-light text-dark border font-monospace px-2 py-1" style="font-size: 0.75rem;">
                                                <%= offer.referralCode %>
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border px-2 py-1" style="font-size: 0.78rem;">
                                            <%= offer.priority || 0 %>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="small lh-sm text-nowrap">
                                            <span class="text-dark fw-medium"><%= new Date(offer.startAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></span>
                                            <span class="text-muted d-block" style="font-size: 0.72rem;">to <%= new Date(offer.expiryAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-center">
                                            <span class="fw-semibold text-dark small"><%= offer.usedCount || 0 %></span>
                                            <span class="text-muted small"> / <%= offer.usageLimit ? offer.usageLimit : '∞' %></span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-center">
                                            <span class="badge <%= statusBadgeClass %> rounded-pill px-2.5 py-1 text-uppercase fw-semibold" style="font-size: 0.68rem; letter-spacing: 0.3px;">
                                                <%= statusLabel %>
                                            </span>
                                        </div>
                                    </td>
                                    <td class="text-center pe-3 text-nowrap">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a
                                                href="/admin/offers/<%= offer._id %>/edit"
                                                class="btn btn-outline-primary"
                                                title="Edit Offer"
                                            >
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <button
                                                type="button"
                                                class="btn <%= offer.isActive ? 'btn-outline-warning' : 'btn-outline-success' %> toggle-btn"
                                                data-id="<%= offer._id %>"
                                                data-name="<%= offer.name %>"
                                                data-active="<%= offer.isActive %>"
                                                title="<%= offer.isActive ? 'Disable Offer' : 'Enable Offer' %>"
                                            >
                                                <i class="bi <%= offer.isActive ? 'bi-eye-slash' : 'bi-eye' %>"></i>
                                            </button>

                                            <button
                                                type="button"
                                                class="btn btn-outline-danger delete-btn"
                                                data-id="<%= offer._id %>"
                                                data-name="<%= offer.name %>"
                                                title="Delete Offer"
                                            >
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="10" class="text-center py-5">
                                    <div class="py-4">
                                        <i class="bi bi-tag display-4 text-muted"></i>
                                        <h5 class="mt-3 fw-bold">No Offers Found</h5>
                                        <p class="text-muted mb-3">
                                            <%= (search || scope || status) ? 'No offers match your search criteria.' : 'No promotional offers created yet.' %>
                                        </p>
                                        <a href="/admin/offers/add" class="btn btn-sm btn-primary">
                                            <i class="bi bi-plus-circle me-1"></i> Create First Offer
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
            <div class="card-footer bg-white border-top py-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <div class="text-muted small">
                    Page <strong><%= currentPage %></strong> of <strong><%= totalPages %></strong>
                </div>
                <nav aria-label="Offers page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="/admin/offers?page=<%= currentPage - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= scope ? '&scope=' + scope : '' %><%= status ? '&status=' + status : '' %>">
                                Previous
                            </a>
                        </li>

                        <%
                            const maxPagesToShow = 5;
                            let startPage = Math.max(1, currentPage - Math.floor(maxPagesToShow / 2));
                            let endPage = Math.min(totalPages, startPage + maxPagesToShow - 1);
                            if (endPage - startPage + 1 < maxPagesToShow) {
                                startPage = Math.max(1, endPage - maxPagesToShow + 1);
                            }
                        %>

                        <% for (let i = startPage; i <= endPage; i++) { %>
                            <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                <a class="page-link" href="/admin/offers?page=<%= i %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= scope ? '&scope=' + scope : '' %><%= status ? '&status=' + status : '' %>">
                                    <%= i %>
                                </a>
                            </li>
                        <% } %>

                        <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                            <a class="page-link" href="/admin/offers?page=<%= currentPage + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= scope ? '&scope=' + scope : '' %><%= status ? '&status=' + status : '' %>">
                                Next
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        <% } %>
    </div>
</div>

<!-- SweetAlert2 for interactive confirm prompts -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
document.addEventListener("DOMContentLoaded", () => {
    // Status Toggle Handler
    document.querySelectorAll(".toggle-btn").forEach(btn => {
        btn.addEventListener("click", async function() {
            const offerId = this.dataset.id;
            const offerName = this.dataset.name;
            const isCurrentlyActive = this.dataset.active === "true";
            const actionText = isCurrentlyActive ? "disable" : "enable";

            const confirmation = await Swal.fire({
                title: `Are you sure?`,
                text: `Do you want to ${actionText} the offer "${offerName}"?`,
                icon: "question",
                showCancelButton: true,
                confirmButtonColor: isCurrentlyActive ? "#ffc107" : "#198754",
                cancelButtonColor: "#6c757d",
                confirmButtonText: `Yes, ${actionText} it!`
            });

            if (confirmation.isConfirmed) {
                try {
                    const res = await fetch(`/admin/offers/${offerId}/status`, {
                        method: "PATCH",
                        headers: { "Content-Type": "application/json" }
                    });
                    const data = await res.json();
                    if (data.success) {
                        Swal.fire({
                            title: "Updated!",
                            text: data.message,
                            icon: "success",
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => window.location.reload());
                    } else {
                        Swal.fire("Error", data.message || "Failed to update offer status.", "error");
                    }
                } catch (err) {
                    console.error("Toggle error:", err);
                    Swal.fire("Error", "Network error occurred.", "error");
                }
            }
        });
    });

    // Delete Handler
    document.querySelectorAll(".delete-btn").forEach(btn => {
        btn.addEventListener("click", async function() {
            const offerId = this.dataset.id;
            const offerName = this.dataset.name;

            const confirmation = await Swal.fire({
                title: "Delete Offer?",
                text: `Are you sure you want to delete "${offerName}"? This action cannot be undone.`,
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#dc3545",
                cancelButtonColor: "#6c757d",
                confirmButtonText: "Yes, delete it!"
            });

            if (confirmation.isConfirmed) {
                try {
                    const res = await fetch(`/admin/offers/${offerId}/delete`, {
                        method: "PATCH",
                        headers: { "Content-Type": "application/json" }
                    });
                    const data = await res.json();
                    if (data.success) {
                        Swal.fire({
                            title: "Deleted!",
                            text: data.message,
                            icon: "success",
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => window.location.reload());
                    } else {
                        Swal.fire("Error", data.message || "Failed to delete offer.", "error");
                    }
                } catch (err) {
                    console.error("Delete error:", err);
                    Swal.fire("Error", "Network error occurred.", "error");
                }
            }
        });
    });
});
</script>
