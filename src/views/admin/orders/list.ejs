<div class="container-fluid py-4">

    <!-- Page Header & Title Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                Order Management
            </h2>
            <p class="text-muted small mb-0">
                Track, inspect, and manage all customer orders and lifecycle states.
            </p>
        </div>
    </div>

    <!-- Search & Filter Toolbar -->
    <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-body py-3">
            <form method="GET" action="/admin/orders" id="orderSearchForm" class="row g-2 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted py-2">
                            <i class="bi bi-search"></i>
                        </span>
                        <input
                            type="text"
                            class="form-control border-start-0 ps-0 py-2"
                            name="search"
                            id="orderSearchInput"
                            placeholder="Search by Order ID (ELV-...), Customer Name, Email, or Phone..."
                            value="<%= search %>"
                        >
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <select name="status" id="statusFilter" class="form-select py-2 rounded-3 border-light-subtle shadow-sm text-secondary">
                        <option value="">All Statuses</option>
                        <option value="PLACED" <%= status === 'PLACED' ? 'selected' : '' %>>PLACED</option>
                        <option value="SHIPPED" <%= status === 'SHIPPED' ? 'selected' : '' %>>SHIPPED</option>
                        <option value="DELIVERED" <%= status === 'DELIVERED' ? 'selected' : '' %>>DELIVERED</option>
                        <option value="CANCELLED" <%= status === 'CANCELLED' ? 'selected' : '' %>>CANCELLED</option>
                        <option value="RETURNED" <%= status === 'RETURNED' ? 'selected' : '' %>>RETURNED</option>
                    </select>
                </div>

                <div class="col-6 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100 py-2 rounded-3 fw-medium">
                        Search
                    </button>
                    <% if (search || status) { %>
                        <a href="/admin/orders" class="btn btn-light border w-100 py-2 rounded-3 fw-medium text-secondary text-center text-decoration-none">
                            Reset
                        </a>
                    <% } %>
                </div>
            </form>
        </div>
    </div>

    <!-- Orders Table -->
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom text-uppercase fs-7 text-muted fw-semibold">
                        <tr>
                            <th class="ps-4 py-3" width="60">#</th>
                            <th class="py-3" width="180">Order ID</th>
                            <th class="py-3">Customer</th>
                            <th class="py-3" width="130">Date</th>
                            <th class="py-3 text-center" width="100">Items</th>
                            <th class="py-3" width="130">Total</th>
                            <th class="py-3" width="140">Payment</th>
                            <th class="py-3 text-center" width="130">Status</th>
                            <th class="py-3 pe-4 text-end" width="100">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    <% if (orders && orders.length > 0) { %>
                        <% orders.forEach((order, index) => { %>
                        <tr>
                            <td class="ps-4 text-muted fw-medium fs-7">
                                <%= ((currentPage - 1) * limit) + index + 1 %>
                            </td>
                            <td>
                                <span class="fw-bold text-dark font-monospace" style="font-size: 0.9rem;">
                                    <%= order.orderNumber %>
                                </span>
                            </td>
                            <td>
                                <div>
                                    <span class="fw-semibold text-dark d-block">
                                        <%= order.user?.fullName || order.shippingAddress?.fullName || 'Customer' %>
                                    </span>
                                    <span class="text-muted small">
                                        <%= order.user?.email || 'N/A' %>
                                    </span>
                                </div>
                            </td>
                            <td class="text-secondary small">
                                <%= new Date(order.createdAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                            </td>
                            <td class="text-center text-secondary small fw-medium">
                                <%= order.items ? order.items.length : 0 %> <%= order.items && order.items.length === 1 ? 'item' : 'items' %>
                            </td>
                            <td class="fw-bold text-dark">
                                ₹<%= order.finalAmount ? order.finalAmount.toLocaleString('en-IN') : '0' %>
                            </td>
                            <td>
                                <div class="d-flex flex-column gap-1">
                                    <span class="badge bg-light text-dark border rounded-pill px-2 py-0.5 text-uppercase align-self-start" style="font-size: 0.65rem;">
                                        <%= order.paymentMethod %>
                                    </span>
                                    <% if (order.paymentStatus === 'COMPLETED') { %>
                                        <span class="text-success small fw-medium" style="font-size: 0.72rem;">
                                            <i class="bi bi-check-circle-fill me-1"></i>Paid
                                        </span>
                                    <% } else { %>
                                        <span class="text-warning-emphasis small fw-medium" style="font-size: 0.72rem;">
                                            <i class="bi bi-clock-fill me-1"></i>Pending
                                        </span>
                                    <% } %>
                                </div>
                            </td>
                            <td class="text-center">
                                <% if (order.orderStatus === 'PLACED') { %>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 fw-semibold">
                                        PLACED
                                    </span>
                                <% } else if (order.orderStatus === 'SHIPPED') { %>
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-2.5 py-1 fw-semibold">
                                        SHIPPED
                                    </span>
                                <% } else if (order.orderStatus === 'DELIVERED') { %>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 fw-semibold">
                                        DELIVERED
                                    </span>
                                <% } else if (order.orderStatus === 'CANCELLED') { %>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1 fw-semibold">
                                        CANCELLED
                                    </span>
                                <% } else if (order.orderStatus === 'RETURNED') { %>
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-2.5 py-1 fw-semibold">
                                        RETURNED
                                    </span>
                                <% } %>
                            </td>
                            <td class="pe-4 text-end">
                                <a
                                    href="/admin/orders/<%= order._id %>"
                                    class="btn btn-sm btn-dark rounded-3 px-2.5 py-1.5 d-inline-flex align-items-center gap-1.5"
                                    title="View Order Details"
                                >
                                    <i class="bi bi-eye"></i>
                                    <span class="d-none d-md-inline small">View</span>
                                </a>
                            </td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="9" class="text-center py-5">
                                <div class="text-muted mb-3">
                                    <i class="bi bi-inbox display-5"></i>
                                </div>
                                <h5 class="fw-semibold text-dark">No Orders Found</h5>
                                <p class="text-muted small mb-0">
                                    <% if (search || status) { %>
                                        No orders match your current search or filter criteria.
                                    <% } else { %>
                                        No customer orders have been placed yet.
                                    <% } %>
                                </p>
                            </td>
                        </tr>
                    <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination Section -->
    <% if (totalPages > 1) { %>
    <%
    const getUrlForPage = (pageNum) => {
        const params = new URLSearchParams(query || {});
        params.set('page', pageNum);
        return `/admin/orders?${params.toString()}`;
    };
    %>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="text-muted small">
            Showing Page <strong><%= currentPage %></strong> of <strong><%= totalPages %></strong> (Total <%= totalOrders %> orders)
        </span>
        <nav aria-label="Order pagination">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                    <a class="page-link" href="<%= getUrlForPage(currentPage - 1) %>">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                <% for (let i = 1; i <= totalPages; i++) { %>
                    <% if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) { %>
                        <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                            <a class="page-link" href="<%= getUrlForPage(i) %>"><%= i %></a>
                        </li>
                    <% } else if (i === currentPage - 2 || i === currentPage + 2) { %>
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    <% } %>
                <% } %>
                <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                    <a class="page-link" href="<%= getUrlForPage(currentPage + 1) %>">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
    <% } %>

</div>
