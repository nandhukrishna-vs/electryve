<div class="container-fluid py-4">

    <!-- Back Navigation & Breadcrumb -->
    <div class="mb-3">
        <a href="/admin/orders" class="text-decoration-none text-muted small fw-medium d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Back to Orders
        </a>
    </div>

    <!-- Order Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                <h2 class="fw-bold text-dark mb-0 font-monospace" style="font-size: 1.5rem;">
                    <%= order.orderNumber %>
                </h2>
                <% if (order.orderStatus === 'PLACED') { %>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1.5 fw-semibold">
                        PLACED
                    </span>
                <% } else if (order.orderStatus === 'SHIPPED') { %>
                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-3 py-1.5 fw-semibold">
                        SHIPPED
                    </span>
                <% } else if (order.orderStatus === 'OUT_FOR_DELIVERY') { %>
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1.5 fw-semibold">
                        OUT FOR DELIVERY
                    </span>
                <% } else if (order.orderStatus === 'DELIVERED') { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 fw-semibold">
                        DELIVERED
                    </span>
                <% } else if (order.orderStatus === 'CANCELLED') { %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1.5 fw-semibold">
                        CANCELLED
                    </span>
                <% } else if (order.orderStatus === 'RETURNED') { %>
                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-3 py-1.5 fw-semibold">
                        RETURNED
                    </span>
                <% } %>
            </div>
            <p class="text-muted small mb-0">
                Placed on <%= new Date(order.createdAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
            </p>
        </div>

        <!-- Action Header Buttons -->
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <a href="/admin/orders" class="btn btn-outline-secondary rounded-3 px-3 py-2 fw-medium d-inline-flex align-items-center gap-1.5 shadow-sm">
                <i class="bi bi-arrow-left"></i>
                Back to Orders
            </a>
        </div>
    </div>

    <!-- Main Grid -->
    <div class="row g-4">
        <!-- Left Column: Order Items & Status Management -->
        <div class="col-lg-8">
            
            <!-- Pending Return Request Review Card -->
            <% if (order.returnRequest && order.returnRequest.status === 'PENDING') { %>
            <div class="card shadow-sm border-warning border-2 rounded-3 mb-4 overflow-hidden">
                <div class="card-header bg-warning-subtle py-3 border-bottom border-warning-subtle d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill text-warning-emphasis fs-5"></i>
                        <h5 class="fw-bold text-dark mb-0 fs-6">Customer Return Request (Pending Review)</h5>
                    </div>
                    <span class="badge bg-warning text-dark rounded-pill px-2.5 py-1 fw-bold">ACTION REQUIRED</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <p class="text-muted small mb-1 fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Return Reason Provided</p>
                            <div class="p-3 bg-light rounded-3 border text-dark font-monospace small">
                                "<%= order.returnRequest.reason %>"
                            </div>
                            <p class="text-muted small mt-2 mb-0">
                                Requested on: <strong class="text-dark"><%= order.returnRequest.requestedAt ? new Date(order.returnRequest.requestedAt).toLocaleString('en-IN', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'N/A' %></strong>
                            </p>
                        </div>
                        <div class="col-md-4 d-flex flex-column justify-content-center gap-2 pt-2">
                            <button type="button" class="btn btn-success rounded-3 py-2.5 fw-semibold d-inline-flex align-items-center justify-content-center gap-2 shadow-sm" onclick="acceptReturnRequest('<%= order._id %>')">
                                <i class="bi bi-check-circle-fill"></i>
                                Accept Return
                            </button>
                            <button type="button" class="btn btn-outline-danger rounded-3 py-2.5 fw-semibold d-inline-flex align-items-center justify-content-center gap-2 shadow-sm" onclick="rejectReturnRequest('<%= order._id %>')">
                                <i class="bi bi-x-circle-fill"></i>
                                Reject Return
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>

            <!-- Reviewed Return Request Alerts (Approved or Rejected) -->
            <% if (order.returnRequest && order.returnRequest.status === 'APPROVED') { %>
            <div class="alert alert-secondary border rounded-3 p-3 mb-4 d-flex align-items-start gap-2.5">
                <i class="bi bi-check-circle-fill fs-5 text-success flex-shrink-0 mt-0.5"></i>
                <div>
                    <strong class="d-block text-dark small">Return Request Approved</strong>
                    <span class="text-secondary small">
                        Approved on <%= order.returnRequest.reviewedAt ? new Date(order.returnRequest.reviewedAt).toLocaleString('en-IN', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '' %>
                        • Reason: "<%= order.returnRequest.reason %>" • Inventory has been restored.
                    </span>
                </div>
            </div>
            <% } else if (order.returnRequest && order.returnRequest.status === 'REJECTED') { %>
            <div class="alert alert-danger border-danger-subtle rounded-3 p-3 mb-4 d-flex align-items-start gap-2.5">
                <i class="bi bi-x-circle-fill fs-5 text-danger flex-shrink-0 mt-0.5"></i>
                <div>
                    <strong class="d-block text-dark small">Return Request Rejected</strong>
                    <span class="text-secondary small">
                        Rejected on <%= order.returnRequest.reviewedAt ? new Date(order.returnRequest.reviewedAt).toLocaleString('en-IN', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '' %>
                        <% if (order.returnRequest.rejectionReason) { %>
                            • Reason: "<%= order.returnRequest.rejectionReason %>"
                        <% } %>
                    </span>
                </div>
            </div>
            <% } %>

            <!-- Order Lifecycle & Status Control Card -->
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark mb-0 fs-6">
                        <i class="bi bi-arrow-repeat me-2 text-muted"></i>Order Lifecycle
                    </h5>
                    <% if (order.orderStatus === 'DELIVERED') { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.72rem;">DELIVERED</span>
                    <% } else if (order.orderStatus === 'CANCELLED') { %>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.72rem;">CANCELLED</span>
                    <% } else if (order.orderStatus === 'RETURNED') { %>
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.72rem;">RETURNED</span>
                    <% } %>
                </div>
                <div class="card-body py-3">
                    <% if (['PLACED', 'SHIPPED', 'OUT_FOR_DELIVERY'].includes(order.orderStatus)) { %>
                    <div class="row g-3 align-items-center">
                        <div class="col-md-7">
                            <label for="nextStatusSelect" class="form-label small text-muted mb-1 fw-semibold">Next Allowed Status</label>
                            <select id="nextStatusSelect" class="form-select rounded-3">
                                <% if (order.orderStatus === 'PLACED') { %>
                                    <option value="SHIPPED">Mark as SHIPPED</option>
                                    <option value="CANCELLED">Mark as CANCELLED</option>
                                <% } else if (order.orderStatus === 'SHIPPED') { %>
                                    <option value="OUT_FOR_DELIVERY">Mark as OUT FOR DELIVERY</option>
                                    <option value="CANCELLED">Mark as CANCELLED</option>
                                <% } else if (order.orderStatus === 'OUT_FOR_DELIVERY') { %>
                                    <option value="DELIVERED">Mark as DELIVERED</option>
                                    <option value="CANCELLED">Mark as CANCELLED</option>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-md-5 d-flex align-items-end pt-md-4">
                            <button type="button" class="btn btn-dark w-100 rounded-3 py-2 fw-medium" onclick="submitStatusUpdate('<%= order._id %>')">
                                Confirm Status Update
                            </button>
                        </div>
                    </div>
                    <% } else if (order.orderStatus === 'DELIVERED') { %>
                    <div class="d-flex align-items-center justify-content-between p-2">
                        <div>
                            <span class="text-muted small d-block mb-1">Current Status</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 fw-bold fs-7">
                                🟢 DELIVERED
                            </span>
                        </div>
                        <p class="text-muted small mb-0 text-end">
                            This order is delivered.<br>No further lifecycle transitions permitted from this selector.
                        </p>
                    </div>
                    <% } else if (order.orderStatus === 'RETURNED') { %>
                    <div class="d-flex align-items-center justify-content-between p-2">
                        <div>
                            <span class="text-muted small d-block mb-1">Current Status</span>
                            <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-3 py-1.5 fw-bold fs-7">
                                ↩️ RETURNED
                            </span>
                        </div>
                        <p class="text-muted small mb-0 text-end">
                            This order was returned and inventory has been restored.<br>No further lifecycle transitions permitted.
                        </p>
                    </div>
                    <% } else if (order.orderStatus === 'CANCELLED') { %>
                    <div class="d-flex align-items-center justify-content-between p-2">
                        <div>
                            <span class="text-muted small d-block mb-1">Current Status</span>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1.5 fw-bold fs-7">
                                🔴 CANCELLED
                            </span>
                        </div>
                        <p class="text-muted small mb-0 text-end">
                            This order is cancelled.<br>No further lifecycle transitions permitted.
                        </p>
                    </div>
                    <% } %>
                </div>
            </div>

            <!-- Ordered Items Table Card -->
            <div class="card shadow-sm border-0 rounded-3 mb-4 overflow-hidden">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark mb-0 fs-6">
                        <i class="bi bi-box-seam me-2 text-muted"></i>Ordered Products (<%= order.items.length %>)
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light border-bottom text-uppercase fs-7 text-muted fw-semibold">
                                <tr>
                                    <th class="ps-4 py-3" width="70">Item</th>
                                    <th class="py-3">Product Information</th>
                                    <th class="py-3" width="120">Price</th>
                                    <th class="py-3 text-center" width="70">Qty</th>
                                    <th class="py-3 text-end" width="110">Total</th>
                                    <th class="py-3 text-center" width="130">Status</th>
                                    <th class="py-3 pe-4 text-end" width="140">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% order.items.forEach((item, index) => { %>
                                <% 
                                    const itemStatus = item.itemStatus || 'ACTIVE';
                                    const isItemActive = itemStatus === 'ACTIVE';
                                    const isItemCancelled = itemStatus === 'CANCELLED';
                                    const isItemReturned = itemStatus === 'RETURNED';
                                %>
                                <tr>
                                    <td class="ps-4">
                                        <div class="rounded-3 border overflow-hidden bg-white d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                            <% if (item.image) { %>
                                                <img src="<%= item.image %>" alt="<%= item.productName %>" style="max-width: 90%; max-height: 90%; object-fit: contain;">
                                            <% } else { %>
                                                <i class="bi bi-image text-muted"></i>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="min-w-0">
                                            <span class="text-uppercase text-muted fw-bold small d-block" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                                                <%= item.brandName %>
                                            </span>
                                            <span class="fw-semibold text-dark d-block text-truncate mb-0.5" style="max-width: 220px;" title="<%= item.productName %>">
                                                <%= item.productName %>
                                            </span>
                                            <span class="text-muted small d-block" style="font-size: 0.75rem;">
                                                <%= item.variantDetails %>
                                            </span>
                                            <% if (item.cancellationReason) { %>
                                                <span class="text-danger small d-block mt-0.5" style="font-size: 0.72rem;">
                                                    <i class="bi bi-info-circle me-1"></i>Cancelled: <%= item.cancellationReason %>
                                                </span>
                                            <% } else if (item.returnReason) { %>
                                                <span class="text-secondary small d-block mt-0.5" style="font-size: 0.72rem;">
                                                    <i class="bi bi-arrow-return-left me-1"></i>Returned: <%= item.returnReason %>
                                                </span>
                                            <% } %>
                                            <% if (item.returnRequest && item.returnRequest.status === 'PENDING') { %>
                                                <span class="text-warning-emphasis small d-block mt-1 font-monospace" style="font-size: 0.72rem;">
                                                    <i class="bi bi-clock-history me-1"></i>Return Reason: "<%= item.returnRequest.reason %>"
                                                </span>
                                            <% } else if (item.returnRequest && item.returnRequest.status === 'REJECTED' && item.returnRequest.rejectionReason) { %>
                                                <span class="text-danger small d-block mt-1" style="font-size: 0.72rem;">
                                                    <i class="bi bi-x-circle me-1"></i>Return Rejected: "<%= item.returnRequest.rejectionReason %>"
                                                </span>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td class="text-secondary small">
                                        ₹<%= item.salePrice.toLocaleString('en-IN') %>
                                    </td>
                                    <td class="text-center fw-medium text-dark">
                                        <%= item.quantity %>
                                    </td>
                                    <td class="text-end fw-bold text-dark">
                                        ₹<%= item.itemTotal.toLocaleString('en-IN') %>
                                    </td>
                                    <td class="text-center">
                                        <% if (isItemCancelled) { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-0.5" style="font-size: 0.65rem;">
                                                CANCELLED
                                            </span>
                                        <% } else if (isItemReturned) { %>
                                            <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-2 py-0.5" style="font-size: 0.65rem;">
                                                RETURNED
                                            </span>
                                        <% } else if (item.returnRequest && item.returnRequest.status === 'PENDING') { %>
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-0.5" style="font-size: 0.65rem;">
                                                RETURN REQUESTED
                                            </span>
                                        <% } else if (item.returnRequest && item.returnRequest.status === 'REJECTED') { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-0.5" style="font-size: 0.65rem;">
                                                RETURN REJECTED
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5" style="font-size: 0.65rem;">
                                                ACTIVE
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <% if (isItemActive && item.returnRequest && item.returnRequest.status === 'PENDING') { %>
                                            <div class="d-flex flex-column gap-1 align-items-end">
                                                <button type="button" class="btn btn-sm btn-success rounded-3 py-1 px-2 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm" style="font-size: 0.72rem;" onclick="acceptItemReturnRequest('<%= order._id %>', '<%= item._id %>')">
                                                    <i class="bi bi-check-lg"></i> Accept Return
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-danger rounded-3 py-1 px-2 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm" style="font-size: 0.72rem;" onclick="rejectItemReturnRequest('<%= order._id %>', '<%= item._id %>')">
                                                    <i class="bi bi-x-lg"></i> Reject Return
                                                </button>
                                            </div>
                                        <% } else if (isItemActive && (order.orderStatus === 'PLACED' || order.orderStatus === 'SHIPPED' || order.orderStatus === 'OUT_FOR_DELIVERY')) { %>
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-3 py-1 px-2" style="font-size: 0.72rem;" onclick='promptCancelItem("<%= order._id %>", "<%= item._id %>", <%- JSON.stringify(item.productName) %>)'>
                                                Cancel
                                            </button>
                                        <% } else { %>
                                            <span class="text-muted small" style="font-size: 0.75rem;">—</span>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Notes & Audit Card (if order cancellation or return reason exists) -->
            <% if (order.cancellationReason || order.returnReason) { %>
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold text-dark mb-0 fs-6">
                        <i class="bi bi-clock-history me-2 text-muted"></i>Audit History
                    </h5>
                </div>
                <div class="card-body">
                    <% if (order.cancellationReason) { %>
                        <div class="alert alert-danger mb-2 border-danger-subtle rounded-3 py-2 px-3 small">
                            <strong class="d-block mb-1"><i class="bi bi-x-circle me-1"></i>Order Cancellation Reason:</strong>
                            <%= order.cancellationReason %>
                            <% if (order.cancelledAt) { %>
                                <span class="text-muted d-block mt-1" style="font-size: 0.75rem;">
                                    Cancelled on <%= new Date(order.cancelledAt).toLocaleString('en-IN') %>
                                </span>
                            <% } %>
                        </div>
                    <% } %>
                    <% if (order.returnReason) { %>
                        <div class="alert alert-secondary mb-0 border-secondary-subtle rounded-3 py-2 px-3 small">
                            <strong class="d-block mb-1"><i class="bi bi-arrow-return-left me-1"></i>Order Return Reason:</strong>
                            <%= order.returnReason %>
                            <% if (order.returnedAt) { %>
                                <span class="text-muted d-block mt-1" style="font-size: 0.75rem;">
                                    Returned on <%= new Date(order.returnedAt).toLocaleString('en-IN') %>
                                </span>
                            <% } %>
                        </div>
                    <% } %>
                </div>
            </div>
            <% } %>

        </div>

        <!-- Right Column: Customer Info, Shipping Address & Cost Summary -->
        <div class="col-lg-4">
            
            <!-- Customer Information Card -->
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold text-dark mb-0 fs-6">
                        <i class="bi bi-person me-2 text-muted"></i>Customer Details
                    </h5>
                </div>
                <div class="card-body py-3 small">
                    <div class="mb-2">
                        <span class="text-muted d-block" style="font-size: 0.72rem;">FULL NAME</span>
                        <strong class="text-dark fs-6"><%= order.user?.fullName || order.shippingAddress?.fullName || 'Customer' %></strong>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted d-block" style="font-size: 0.72rem;">EMAIL</span>
                        <span class="text-dark"><%= order.user?.email || 'N/A' %></span>
                    </div>
                    <div>
                        <span class="text-muted d-block" style="font-size: 0.72rem;">PHONE</span>
                        <span class="text-dark"><%= order.shippingAddress?.phone || order.user?.phone || 'N/A' %></span>
                    </div>
                </div>
            </div>

            <!-- Shipping Address Snapshot Card -->
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold text-dark mb-0 fs-6">
                        <i class="bi bi-geo-alt me-2 text-muted"></i>Shipping Address Snapshot
                    </h5>
                </div>
                <div class="card-body py-3 small">
                    <% const addr = order.shippingAddress || {}; %>
                    <strong class="text-dark d-block mb-1"><%= addr.fullName %></strong>
                    <div class="text-secondary mb-1">
                        <%= addr.addressLine1 %>
                        <% if (addr.addressLine2) { %>, <%= addr.addressLine2 %><% } %>
                    </div>
                    <% if (addr.landmark) { %>
                        <div class="text-muted mb-1">Landmark: <%= addr.landmark %></div>
                    <% } %>
                    <div class="text-secondary mb-2">
                        <%= addr.city %>, <%= addr.state %> - <strong><%= addr.pinCode %></strong>
                    </div>
                    <div class="text-secondary">
                        <i class="bi bi-telephone-fill me-1 text-muted"></i> Phone: <%= addr.phone %>
                    </div>
                </div>
            </div>

            <!-- Price Summary Card -->
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold text-dark mb-0 fs-6">
                        <i class="bi bi-receipt me-2 text-muted"></i>Payment & Price Summary
                    </h5>
                </div>
                <div class="card-body py-3 small">
                    <div class="d-flex justify-content-between mb-2 text-secondary">
                        <span>Subtotal</span>
                        <span class="text-dark fw-medium">₹<%= order.subtotal.toLocaleString('en-IN') %></span>
                    </div>
                    <% if (order.discount > 0) { %>
                    <div class="d-flex justify-content-between mb-2 text-danger">
                        <span>Discount</span>
                        <span>-₹<%= order.discount.toLocaleString('en-IN') %></span>
                    </div>
                    <% } %>
                    <div class="d-flex justify-content-between mb-2 text-secondary">
                        <span>Shipping</span>
                        <span class="text-dark fw-medium"><%= order.shippingCharge === 0 ? 'FREE' : '₹' + order.shippingCharge.toLocaleString('en-IN') %></span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 text-secondary">
                        <span>Tax</span>
                        <span class="text-dark fw-medium">₹<%= order.tax.toLocaleString('en-IN') %></span>
                    </div>
                    <hr class="my-2 text-muted opacity-25">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <strong class="text-dark fs-6">Final Payable</strong>
                        <strong class="text-dark fs-5">₹<%= order.finalAmount.toLocaleString('en-IN') %></strong>
                    </div>
                    <div class="border rounded-3 p-2.5 bg-light d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted d-block" style="font-size: 0.7rem;">PAYMENT METHOD</span>
                            <strong class="text-dark text-uppercase"><%= order.paymentMethod %></strong>
                        </div>
                        <div>
                            <% if (order.paymentStatus === 'COMPLETED') { %>
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 fw-semibold">
                                    PAID
                                </span>
                            <% } else { %>
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1 fw-semibold">
                                    PENDING
                                </span>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
// 1. Status Update AJAX
async function submitStatusUpdate(orderId) {
    const select = document.getElementById("nextStatusSelect");
    if (!select) return;
    const status = select.value;

    const confirm = await Swal.fire({
        title: "Update Order Status?",
        text: `Are you sure you want to update this order's status to "${status}"?`,
        icon: "question",
        showCancelButton: true,
        confirmButtonColor: "#111827",
        cancelButtonColor: "#6c757d",
        confirmButtonText: "Yes, Update"
    });

    if (!confirm.isConfirmed) return;

    try {
        const res = await fetch(`/admin/orders/${orderId}/status`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ status })
        });
        const data = await res.json();
        if (data.success) {
            await Swal.fire({
                icon: "success",
                title: "Updated",
                text: data.message,
                timer: 1500,
                showConfirmButton: false
            });
            window.location.reload();
        } else {
            Swal.fire({
                icon: "error",
                title: "Update Failed",
                text: data.message || "Failed to update status."
            });
        }
    } catch (err) {
        console.error("Status update error:", err);
        Swal.fire({ icon: "error", title: "Error", text: "Network or server error." });
    }
}

// 2. Accept Customer Return Request
async function acceptReturnRequest(orderId) {
    const result = await Swal.fire({
        title: "Approve Return Request?",
        text: "This will approve the customer's return request, change the order status to RETURNED, and restore stock for all active items.",
        icon: "question",
        showCancelButton: true,
        confirmButtonColor: "#198754",
        cancelButtonColor: "#6c757d",
        confirmButtonText: "Yes, Approve Return"
    });

    if (!result.isConfirmed) return;

    try {
        Swal.fire({
            title: "Approving Return...",
            text: "Restoring inventory and updating order, please wait.",
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        const res = await fetch(`/admin/orders/${orderId}/return/approve`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" }
        });
        const data = await res.json();
        if (data.success) {
            await Swal.fire({
                icon: "success",
                title: "Return Approved",
                text: data.message,
                timer: 1800,
                showConfirmButton: false
            });
            window.location.reload();
        } else {
            Swal.fire({ icon: "error", title: "Approval Failed", text: data.message || "Failed to approve return request." });
        }
    } catch (err) {
        console.error("Approve return error:", err);
        Swal.fire({ icon: "error", title: "Error", text: "Network or server error." });
    }
}

// 3. Reject Customer Return Request
async function rejectReturnRequest(orderId) {
    const { value: reason, isConfirmed } = await Swal.fire({
        title: "Reject Return Request?",
        text: "Please provide a reason for rejecting this return request (visible to the customer):",
        input: "textarea",
        inputPlaceholder: "Enter rejection reason...",
        inputValidator: (value) => {
            if (!value || value.trim().length < 3) {
                return "A valid rejection reason (at least 3 characters) is required!";
            }
        },
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#dc3545",
        cancelButtonColor: "#6c757d",
        confirmButtonText: "Reject Request"
    });

    if (!isConfirmed || !reason) return;

    try {
        Swal.fire({
            title: "Rejecting Request...",
            text: "Updating order status, please wait.",
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        const res = await fetch(`/admin/orders/${orderId}/return/reject`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ rejectionReason: reason.trim() })
        });
        const data = await res.json();
        if (data.success) {
            await Swal.fire({
                icon: "success",
                title: "Return Request Rejected",
                text: data.message,
                timer: 1800,
                showConfirmButton: false
            });
            window.location.reload();
        } else {
            Swal.fire({ icon: "error", title: "Rejection Failed", text: data.message || "Failed to reject return request." });
        }
    } catch (err) {
        console.error("Reject return error:", err);
        Swal.fire({ icon: "error", title: "Error", text: "Network or server error." });
    }
}

// 3. Cancel Specific Item
async function promptCancelItem(orderId, itemId, productName) {
    const { value: reason, isConfirmed } = await Swal.fire({
        title: "Cancel This Item?",
        text: `Cancel "${productName}" and restore its stock quantity. Optional reason:`,
        input: "text",
        inputPlaceholder: "Enter optional cancellation reason...",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#dc3545",
        cancelButtonColor: "#6c757d",
        confirmButtonText: "Yes, Cancel Item"
    });

    if (!isConfirmed) return;

    try {
        const res = await fetch(`/admin/orders/${orderId}/items/${itemId}/cancel`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ reason: reason || "" })
        });
        const data = await res.json();
        if (data.success) {
            await Swal.fire({
                icon: "success",
                title: "Item Cancelled",
                text: data.message,
                timer: 1500,
                showConfirmButton: false
            });
            window.location.reload();
        } else {
            Swal.fire({ icon: "error", title: "Action Failed", text: data.message || "Could not cancel item." });
        }
    } catch (err) {
        console.error("Cancel item error:", err);
        Swal.fire({ icon: "error", title: "Error", text: "Network or server error." });
    }
}

// 4. Accept Item Return Request
async function acceptItemReturnRequest(orderId, itemId) {
    const result = await Swal.fire({
        title: "Approve Item Return?",
        text: "This will approve the return request for this item, mark it as RETURNED, and restore its inventory stock.",
        icon: "question",
        showCancelButton: true,
        confirmButtonColor: "#198754",
        cancelButtonColor: "#6c757d",
        confirmButtonText: "Yes, Approve Return"
    });

    if (!result.isConfirmed) return;

    try {
        Swal.fire({
            title: "Approving Item Return...",
            text: "Restoring inventory and updating item status, please wait.",
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        const res = await fetch(`/admin/orders/${orderId}/items/${itemId}/return/approve`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" }
        });
        const data = await res.json();
        if (data.success) {
            await Swal.fire({
                icon: "success",
                title: "Return Approved",
                text: data.message || "Item return approved successfully.",
                timer: 1800,
                showConfirmButton: false
            });
            window.location.reload();
        } else {
            Swal.fire({ icon: "error", title: "Approval Failed", text: data.message || "Failed to approve item return request." });
        }
    } catch (err) {
        console.error("Approve item return error:", err);
        Swal.fire({ icon: "error", title: "Error", text: "Network or server error." });
    }
}

// 5. Reject Item Return Request
async function rejectItemReturnRequest(orderId, itemId) {
    const { value: reason, isConfirmed } = await Swal.fire({
        title: "Reject Item Return?",
        text: "Please provide a reason for rejecting this item return request (visible to the customer):",
        input: "textarea",
        inputPlaceholder: "Enter rejection reason...",
        inputValidator: (value) => {
            if (!value || value.trim().length < 3) {
                return "A valid rejection reason (at least 3 characters) is required!";
            }
        },
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#dc3545",
        cancelButtonColor: "#6c757d",
        confirmButtonText: "Reject Request"
    });

    if (!isConfirmed || !reason) return;

    try {
        Swal.fire({
            title: "Rejecting Request...",
            text: "Updating item status, please wait.",
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        const res = await fetch(`/admin/orders/${orderId}/items/${itemId}/return/reject`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ rejectionReason: reason.trim() })
        });
        const data = await res.json();
        if (data.success) {
            await Swal.fire({
                icon: "success",
                title: "Return Request Rejected",
                text: data.message || "Item return request rejected.",
                timer: 1800,
                showConfirmButton: false
            });
            window.location.reload();
        } else {
            Swal.fire({ icon: "error", title: "Rejection Failed", text: data.message || "Failed to reject item return request." });
        }
    } catch (err) {
        console.error("Reject item return error:", err);
        Swal.fire({ icon: "error", title: "Error", text: "Network or server error." });
    }
}
</script>

