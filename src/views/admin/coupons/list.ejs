<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="h3 fw-bold mb-1">Coupon Management</h2>
            <p class="text-muted mb-0">Create, manage, and configure discount coupons for your store.</p>
        </div>
        <div>
            <a href="/admin/coupons/add" class="btn btn-primary d-inline-flex align-items-center gap-2">
                <i class="bi bi-plus-circle"></i>
                <span>Add Coupon</span>
            </a>
        </div>
    </div>

    <!-- Flash Messages -->
    <% if (typeof successMessage !== "undefined" && successMessage) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <%= successMessage %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <% if (typeof errorMessage !== "undefined" && errorMessage) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <%= errorMessage %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form action="/admin/coupons" method="GET" class="row g-2 align-items-center">
                <div class="col-md-5 col-sm-8">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input
                            type="text"
                            name="search"
                            class="form-control border-start-0"
                            placeholder="Search by coupon code..."
                            value="<%= search || '' %>"
                        >
                    </div>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-dark">Search</button>
                    <% if (search) { %>
                        <a href="/admin/coupons" class="btn btn-outline-secondary">Clear</a>
                    <% } %>
                </div>
                <div class="col-auto ms-auto text-muted small">
                    Showing <strong><%= coupons.length %></strong> of <strong><%= totalCoupons %></strong> coupons
                </div>
            </form>
        </div>
    </div>

    <!-- Coupons Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="text-nowrap small text-uppercase fw-semibold">
                            <th scope="col" class="ps-3" style="width: 50px;">#</th>
                            <th scope="col">Code</th>
                            <th scope="col">Discount</th>
                            <th scope="col">Min Purchase</th>
                            <th scope="col">Max Cap</th>
                            <th scope="col">Validity</th>
                            <th scope="col">Usage</th>
                            <th scope="col">Per User</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-center pe-3" style="width: 140px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (coupons && coupons.length > 0) { %>
                            <% coupons.forEach((coupon, index) => { %>
                                <% 
                                    // Compute real-time status
                                    const now = new Date();
                                    let statusLabel = "Active";
                                    let statusBadgeClass = "bg-success";

                                    if (!coupon.isActive) {
                                        statusLabel = "Inactive";
                                        statusBadgeClass = "bg-secondary";
                                    } else if (now < new Date(coupon.startDate)) {
                                        statusLabel = "Scheduled";
                                        statusBadgeClass = "bg-info text-dark";
                                    } else if (now > new Date(coupon.expiryDate)) {
                                        statusLabel = "Expired";
                                        statusBadgeClass = "bg-danger";
                                    } else if (coupon.usageLimit && coupon.usedCount >= coupon.usageLimit) {
                                        statusLabel = "Exhausted";
                                        statusBadgeClass = "bg-dark";
                                    }
                                %>
                                <tr>
                                    <td class="ps-3 text-muted small">
                                        <%= ((currentPage - 1) * limit) + index + 1 %>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-light text-dark border font-monospace fs-6 px-2 py-1">
                                                <%= coupon.code %>
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <% if (coupon.discountType === 'PERCENTAGE') { %>
                                            <span class="fw-bold text-success">
                                                <%= coupon.discountValue %>% OFF
                                            </span>
                                        <% } else { %>
                                            <span class="fw-bold text-primary">
                                                ₹<%= coupon.discountValue.toLocaleString('en-IN') %> OFF
                                            </span>
                                        <% } %>
                                        <div class="text-muted small">Type: <%= coupon.discountType %></div>
                                    </td>
                                    <td>
                                        ₹<%= (coupon.minPurchaseAmount || 0).toLocaleString('en-IN') %>
                                    </td>
                                    <td>
                                        <% if (coupon.discountType === 'PERCENTAGE' && coupon.maxDiscountAmount) { %>
                                            ₹<%= coupon.maxDiscountAmount.toLocaleString('en-IN') %>
                                        <% } else { %>
                                            <span class="text-muted">—</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="small">
                                            <div><span class="text-muted">Start:</span> <%= new Date(coupon.startDate).toLocaleDateString('en-IN') %></div>
                                            <div><span class="text-muted">End:</span> <%= new Date(coupon.expiryDate).toLocaleDateString('en-IN') %></div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <%= coupon.usedCount || 0 %> / <%= coupon.usageLimit ? coupon.usageLimit : '∞' %>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <%= coupon.perUserLimit ? coupon.perUserLimit : '∞' %>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge <%= statusBadgeClass %> px-2 py-1">
                                            <%= statusLabel %>
                                        </span>
                                    </td>
                                    <td class="text-center pe-3">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a
                                                href="/admin/coupons/<%= coupon._id %>/edit"
                                                class="btn btn-outline-primary"
                                                title="Edit Coupon"
                                            >
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <button
                                                type="button"
                                                class="btn btn-outline-warning toggle-btn"
                                                data-id="<%= coupon._id %>"
                                                data-code="<%= coupon.code %>"
                                                data-active="<%= coupon.isActive %>"
                                                title="<%= coupon.isActive ? 'Deactivate Coupon' : 'Activate Coupon' %>"
                                            >
                                                <i class="bi <%= coupon.isActive ? 'bi-eye-slash' : 'bi-eye' %>"></i>
                                            </button>

                                            <button
                                                type="button"
                                                class="btn btn-outline-danger delete-btn"
                                                data-id="<%= coupon._id %>"
                                                data-code="<%= coupon.code %>"
                                                title="Delete Coupon"
                                            >
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="10" class="text-center py-5">
                                    <div class="py-4">
                                        <i class="bi bi-ticket-perforated display-4 text-muted"></i>
                                        <h5 class="mt-3 fw-bold">No Coupons Found</h5>
                                        <p class="text-muted mb-3">
                                            <% if (search) { %>
                                                No coupons match your search query "<%= search %>".
                                            <% } else { %>
                                                You haven't created any coupons yet. Click below to add your first coupon.
                                            <% } %>
                                        </p>
                                        <% if (search) { %>
                                            <a href="/admin/coupons" class="btn btn-outline-secondary btn-sm me-2">Clear Search</a>
                                        <% } %>
                                        <a href="/admin/coupons/add" class="btn btn-primary btn-sm">Add New Coupon</a>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination Footer -->
        <% if (totalPages > 1) { %>
            <div class="card-footer bg-white border-0 py-3">
                <nav aria-label="Coupon pagination">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                            <a
                                class="page-link"
                                href="/admin/coupons?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(search) %>"
                                aria-label="Previous"
                            >
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>

                        <% for (let p = 1; p <= totalPages; p++) { %>
                            <li class="page-item <%= currentPage === p ? 'active' : '' %>">
                                <a
                                    class="page-link"
                                    href="/admin/coupons?page=<%= p %>&search=<%= encodeURIComponent(search) %>"
                                >
                                    <%= p %>
                                </a>
                            </li>
                        <% } %>

                        <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                            <a
                                class="page-link"
                                href="/admin/coupons?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(search) %>"
                                aria-label="Next"
                            >
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        <% } %>
    </div>
</div>

<!-- SweetAlert Action Script -->
<script>
document.addEventListener("DOMContentLoaded", () => {
    // Toggle Status
    document.querySelectorAll(".toggle-btn").forEach((button) => {
        button.addEventListener("click", async () => {
            const id = button.dataset.id;
            const code = button.dataset.code;
            const isActive = button.dataset.active === "true";
            const actionText = isActive ? "deactivate" : "activate";

            const result = await Swal.fire({
                title: `${isActive ? 'Deactivate' : 'Activate'} Coupon?`,
                text: `Are you sure you want to ${actionText} coupon "${code}"?`,
                icon: "question",
                showCancelButton: true,
                confirmButtonText: `Yes, ${actionText}`,
                cancelButtonText: "Cancel",
                confirmButtonColor: isActive ? "#d33" : "#198754"
            });

            if (!result.isConfirmed) return;

            try {
                const response = await fetch(`/admin/coupons/${id}/status`, {
                    method: "PATCH",
                    headers: {
                        "Accept": "application/json",
                        "Content-Type": "application/json"
                    }
                });

                const data = await response.json();
                if (data.success) {
                    Swal.fire({
                        icon: "success",
                        title: "Success",
                        text: data.message,
                        timer: 1200,
                        showConfirmButton: false
                    }).then(() => location.reload());
                } else {
                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: data.message || "Failed to update coupon status."
                    });
                }
            } catch (err) {
                console.error("Toggle Coupon Error:", err);
                Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: "An error occurred while updating the coupon status."
                });
            }
        });
    });

    // Soft Delete
    document.querySelectorAll(".delete-btn").forEach((button) => {
        button.addEventListener("click", async () => {
            const id = button.dataset.id;
            const code = button.dataset.code;

            const result = await Swal.fire({
                title: "Delete Coupon?",
                text: `Are you sure you want to delete coupon "${code}"? This will move it to trash.`,
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes, delete",
                cancelButtonText: "Cancel",
                confirmButtonColor: "#dc3545"
            });

            if (!result.isConfirmed) return;

            try {
                const response = await fetch(`/admin/coupons/${id}/delete`, {
                    method: "PATCH",
                    headers: {
                        "Accept": "application/json",
                        "Content-Type": "application/json"
                    }
                });

                const data = await response.json();
                if (data.success) {
                    Swal.fire({
                        icon: "success",
                        title: "Deleted",
                        text: data.message,
                        timer: 1200,
                        showConfirmButton: false
                    }).then(() => location.reload());
                } else {
                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: data.message || "Failed to delete coupon."
                    });
                }
            } catch (err) {
                console.error("Delete Coupon Error:", err);
                Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: "An error occurred while deleting the coupon."
                });
            }
        });
    });
});
</script>
