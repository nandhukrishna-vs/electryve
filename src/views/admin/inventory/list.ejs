<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Inventory Management</h2>
            <p class="text-secondary small mb-0">
                Track variant stock levels, manage out-of-stock items, and update quantities in real-time.
            </p>
        </div>
    </div>

    <!-- Summary Metrics Cards -->
    <div class="row g-3 mb-4">
        <!-- Total Variants -->
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-secondary small fw-semibold d-block mb-1">Total Variants</span>
                        <h3 class="fw-bold text-dark mb-0 font-monospace"><%= (summary && summary.total) || 0 %></h3>
                    </div>
                    <div class="p-2.5 rounded-3 bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-box-seam fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- In Stock -->
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-secondary small fw-semibold d-block mb-1">In Stock</span>
                        <h3 class="fw-bold text-success mb-0 font-monospace"><%= (summary && summary.inStock) || 0 %></h3>
                    </div>
                    <div class="p-2.5 rounded-3 bg-success bg-opacity-10 text-success">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Low Stock -->
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-secondary small fw-semibold d-block mb-1">Low Stock (≤ 5)</span>
                        <h3 class="fw-bold text-warning mb-0 font-monospace"><%= (summary && summary.lowStock) || 0 %></h3>
                    </div>
                    <div class="p-2.5 rounded-3 bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Out of Stock -->
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-secondary small fw-semibold d-block mb-1">Out of Stock</span>
                        <h3 class="fw-bold text-danger mb-0 font-monospace"><%= (summary && summary.outOfStock) || 0 %></h3>
                    </div>
                    <div class="p-2.5 rounded-3 bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-x-circle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-3 p-md-4">
            <form action="/admin/inventory" method="GET" class="row g-3 align-items-center">
                <div class="col-12 col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-light-subtle text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input
                            type="text"
                            name="search"
                            id="inventorySearchInput"
                            class="form-control border-light-subtle"
                            placeholder="Search by product name, SKU, color, or brand..."
                            value="<%= search || '' %>"
                        >
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <select name="status" id="statusFilter" class="form-select border-light-subtle text-secondary">
                        <option value="">All Stock Statuses</option>
                        <option value="IN_STOCK" <%= status === 'IN_STOCK' ? 'selected' : '' %>>In Stock (> 5)</option>
                        <option value="LOW_STOCK" <%= status === 'LOW_STOCK' ? 'selected' : '' %>>Low Stock (1 - 5)</option>
                        <option value="OUT_OF_STOCK" <%= status === 'OUT_OF_STOCK' ? 'selected' : '' %>>Out of Stock (0)</option>
                    </select>
                </div>

                <div class="col-6 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100 rounded-3 py-2 fw-medium">
                        Search
                    </button>
                    <% if (search || status) { %>
                        <a href="/admin/inventory" class="btn btn-light border w-100 py-2 rounded-3 fw-medium text-secondary text-center text-decoration-none">
                            Reset
                        </a>
                    <% } %>
                </div>
            </form>
        </div>
    </div>

    <!-- Inventory Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-dark mb-0 fs-6">
                <i class="bi bi-boxes me-2 text-muted"></i>Variant Inventory List
            </h5>
            <span class="text-secondary small">
                Showing <%= inventory ? inventory.length : 0 %> of <%= totalVariants || 0 %> variants
            </span>
        </div>

        <div class="table-responsive" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
            <table class="table align-middle mb-0" style="min-width: 900px;">
                <thead class="bg-light text-secondary border-bottom" style="font-size: 0.78rem; letter-spacing: 0.4px; text-transform: uppercase;">
                    <tr>
                        <th class="ps-4 py-3 fw-semibold" style="width: 45px;">#</th>
                        <th class="py-3 fw-semibold">Product</th>
                        <th class="py-3 fw-semibold">Variant Details</th>
                        <th class="py-3 fw-semibold">SKU</th>
                        <th class="py-3 fw-semibold text-center">Stock</th>
                        <th class="py-3 fw-semibold text-center">Status</th>
                        <th class="py-3 fw-semibold text-center">Last Updated</th>
                        <th class="pe-4 py-3 fw-semibold text-end" style="width: 130px;">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y text-dark" style="font-size: 0.88rem;">
                    <% if (inventory && inventory.length > 0) { %>
                        <% inventory.forEach((item, index) => { %>
                            <tr id="variant-row-<%= item.variantId %>">
                                <!-- Index -->
                                <td class="ps-4 py-3 text-secondary" style="font-size: 0.8rem;">
                                    <%= ((currentPage - 1) * limit) + index + 1 %>
                                </td>

                                <!-- Product Info -->
                                <td class="py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="border rounded-3 p-1 bg-light d-flex align-items-center justify-content-center overflow-hidden flex-shrink-0" style="width: 46px; height: 46px;">
                                            <% if (item.image) { %>
                                                <img src="<%= item.image %>" alt="<%= item.productName %>" style="max-width: 100%; max-height: 100%; object-fit: contain;">
                                            <% } else { %>
                                                <i class="bi bi-image text-muted"></i>
                                            <% } %>
                                        </div>
                                        <div class="min-w-0">
                                            <span class="text-uppercase text-muted fw-bold d-block mb-0.5" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                                                <%= item.brandName || 'ELECTRYVE' %>
                                            </span>
                                            <span class="fw-semibold text-dark text-truncate d-block" style="max-width: 220px;" title="<%= item.productName %>">
                                                <%= item.productName %>
                                            </span>
                                            <% if (item.categoryName) { %>
                                                <span class="text-secondary small" style="font-size: 0.72rem;">
                                                    <%= item.categoryName %>
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>
                                </td>

                                <!-- Variant Details -->
                                <td class="py-3">
                                    <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                        <span class="badge bg-light text-dark border rounded-2 px-2 py-1 small">
                                            Color: <strong><%= item.color %></strong>
                                        </span>
                                        <span class="badge bg-light text-dark border rounded-2 px-2 py-1 small">
                                            Storage: <strong><%= item.storage %></strong>
                                        </span>
                                    </div>
                                    <span class="text-secondary d-block mt-1" style="font-size: 0.75rem;">
                                        Sale Price: <strong>₹<%= (item.salePrice || 0).toLocaleString('en-IN') %></strong>
                                    </span>
                                </td>

                                <!-- SKU -->
                                <td class="py-3">
                                    <span class="font-monospace fw-bold text-dark px-2 py-1 bg-light rounded border small">
                                        <%= item.sku %>
                                    </span>
                                </td>

                                <!-- Stock Level -->
                                <td class="py-3 text-center">
                                    <span class="fw-bold font-monospace fs-6" id="stock-val-<%= item.variantId %>">
                                        <%= item.stock %>
                                    </span>
                                </td>

                                <!-- Status Badge -->
                                <td class="py-3 text-center" id="status-badge-cell-<%= item.variantId %>">
                                    <% if (item.stockStatus === 'In Stock') { %>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.75rem;">
                                            In Stock
                                        </span>
                                    <% } else if (item.stockStatus === 'Low Stock') { %>
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.75rem;">
                                            Low Stock (<%= item.stock %>)
                                        </span>
                                    <% } else { %>
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.75rem;">
                                            Out of Stock
                                        </span>
                                    <% } %>
                                </td>

                                <!-- Last Updated -->
                                <td class="py-3 text-center text-secondary" style="font-size: 0.8rem;">
                                    <%= item.updatedAt ? new Date(item.updatedAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—' %>
                                </td>

                                <!-- Action -->
                                <td class="pe-4 py-3 text-end">
                                    <button
                                        type="button"
                                        class="btn btn-sm btn-outline-dark rounded-3 px-2.5 py-1.5 fw-medium d-inline-flex align-items-center gap-1.5"
                                        onclick="openStockUpdateModal('<%= item.productId %>', '<%= item.variantId %>', '<%= item.sku %>', <%= item.stock %>)"
                                        title="Update Stock"
                                    >
                                        <i class="bi bi-pencil-square"></i>
                                        <span>Edit Stock</span>
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" class="text-center py-5 text-secondary">
                                <div class="py-3">
                                    <i class="bi bi-box-seam fs-1 text-muted d-block mb-2"></i>
                                    <h6 class="fw-bold text-dark">No Inventory Records Found</h6>
                                    <p class="small text-secondary mb-3">
                                        No product variants matched your search or status filter.
                                    </p>
                                    <% if (search || status) { %>
                                        <a href="/admin/inventory" class="btn btn-outline-dark btn-sm rounded-3">
                                            Clear Filters
                                        </a>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
            <div class="card-footer bg-white py-3 px-4 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="text-secondary small">
                    Page <%= currentPage %> of <%= totalPages %>
                </span>
                <nav aria-label="Inventory Pagination">
                    <ul class="pagination pagination-sm mb-0 gap-1">
                        <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                            <a class="page-link rounded-3 border text-dark" href="/admin/inventory?page=<%= currentPage - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= status ? '&status=' + encodeURIComponent(status) : '' %>">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        <% for (let p = 1; p <= totalPages; p++) { %>
                            <li class="page-item <%= currentPage === p ? 'active' : '' %>">
                                <a class="page-link rounded-3 border <%= currentPage === p ? 'bg-dark border-dark text-white' : 'text-dark' %>" href="/admin/inventory?page=<%= p %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= status ? '&status=' + encodeURIComponent(status) : '' %>">
                                    <%= p %>
                                </a>
                            </li>
                        <% } %>
                        <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                            <a class="page-link rounded-3 border text-dark" href="/admin/inventory?page=<%= currentPage + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= status ? '&status=' + encodeURIComponent(status) : '' %>">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        <% } %>
    </div>
</div>

<script>
/**
 * Prompt stock update with SweetAlert2 and submit AJAX PATCH request
 */
async function openStockUpdateModal(productId, variantId, sku, currentStock) {
    const { value: newStockStr, isConfirmed } = await Swal.fire({
        title: "Update Variant Stock",
        html: `
            <div class="text-start mb-3">
                <div class="mb-2">
                    <span class="text-secondary small">SKU:</span>
                    <strong class="font-monospace text-dark ms-1">${sku}</strong>
                </div>
                <div class="mb-3">
                    <span class="text-secondary small">Current Stock:</span>
                    <span class="badge bg-light text-dark border ms-1 font-monospace fs-6">${currentStock}</span>
                </div>
                <label for="swalNewStockInput" class="form-label small fw-bold text-dark">Enter New Stock Quantity:</label>
                <input
                    type="number"
                    id="swalNewStockInput"
                    class="form-control font-monospace"
                    min="0"
                    step="1"
                    value="${currentStock}"
                    placeholder="Enter whole number >= 0"
                >
            </div>
        `,
        focusConfirm: false,
        showCancelButton: true,
        confirmButtonText: "Save Stock",
        cancelButtonText: "Cancel",
        confirmButtonColor: "#111827",
        cancelButtonColor: "#6c757d",
        preConfirm: () => {
            const inputVal = document.getElementById("swalNewStockInput").value;
            if (inputVal === "" || inputVal === null) {
                Swal.showValidationMessage("Please enter a stock quantity.");
                return false;
            }
            const parsed = Number(inputVal);
            if (!Number.isInteger(parsed) || parsed < 0) {
                Swal.showValidationMessage("Stock must be a non-negative whole integer (0, 1, 2...).");
                return false;
            }
            return parsed;
        }
    });

    if (!isConfirmed || newStockStr === undefined) return;

    const newStock = Number(newStockStr);

    try {
        Swal.fire({
            title: "Updating Stock...",
            text: "Saving to database, please wait.",
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        const res = await fetch(`/admin/inventory/${productId}/${variantId}`, {
            method: "PATCH",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({ stock: newStock })
        });

        const data = await res.json();

        if (data.success) {
            await Swal.fire({
                icon: "success",
                title: "Stock Updated!",
                text: data.message,
                timer: 1500,
                showConfirmButton: false
            });

            // Update DOM directly without reload
            const stockValEl = document.getElementById(`stock-val-${variantId}`);
            if (stockValEl) stockValEl.textContent = newStock;

            const badgeCell = document.getElementById(`status-badge-cell-${variantId}`);
            if (badgeCell) {
                if (data.stockStatus === "In Stock") {
                    badgeCell.innerHTML = '<span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.75rem;">In Stock</span>';
                } else if (data.stockStatus === "Low Stock") {
                    badgeCell.innerHTML = `<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.75rem;">Low Stock (${newStock})</span>`;
                } else {
                    badgeCell.innerHTML = '<span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.75rem;">Out of Stock</span>';
                }
            }

            // Reload page smoothly to update summary cards and pagination counts
            window.location.reload();
        } else {
            Swal.fire({
                icon: "error",
                title: "Update Failed",
                text: data.message || "Could not update stock."
            });
        }
    } catch (err) {
        console.error("Stock update error:", err);
        Swal.fire({
            icon: "error",
            title: "Network Error",
            text: "Failed to communicate with server."
        });
    }
}
</script>
