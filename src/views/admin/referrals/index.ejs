<div class="container-fluid p-0">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">Referral Management</h2>
            <p class="text-muted small mb-0">Track referral signups, qualifying orders, and two-wallet reward disbursements.</p>
        </div>
        <div>
            <a href="/admin/referrals/program" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3 shadow-sm fw-medium">
                <i class="bi bi-gear-fill"></i>
                <span>Program Settings</span>
            </a>
        </div>
    </div>

    <!-- Flash Messages -->
    <% if (typeof successMessage !== "undefined" && successMessage) { %>
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <%= successMessage %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <% if (typeof errorMessage !== "undefined" && errorMessage) { %>
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <%= errorMessage %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <!-- Summary KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-2">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Total Referrals</span>
                    <span class="badge bg-primary-subtle text-primary rounded-pill p-1.5"><i class="bi bi-people"></i></span>
                </div>
                <h3 class="fs-4 fw-bold text-dark mb-0"><%= Number(adminStats?.totalReferrals || 0) %></h3>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-2">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Completed</span>
                    <span class="badge bg-success-subtle text-success rounded-pill p-1.5"><i class="bi bi-check2-circle"></i></span>
                </div>
                <h3 class="fs-4 fw-bold text-success mb-0"><%= Number(adminStats?.completedReferrals || 0) %></h3>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-2">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">In Progress</span>
                    <span class="badge bg-warning-subtle text-warning rounded-pill p-1.5"><i class="bi bi-clock-history"></i></span>
                </div>
                <h3 class="fs-4 fw-bold text-warning mb-0"><%= Number(adminStats?.pendingReferrals || 0) %></h3>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-2">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Reversed</span>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill p-1.5"><i class="bi bi-arrow-counterclockwise"></i></span>
                </div>
                <h3 class="fs-4 fw-bold text-secondary mb-0"><%= Number(adminStats?.reversedReferrals || 0) %></h3>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-2">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Referrer Rewards</span>
                    <span class="badge bg-info-subtle text-info rounded-pill p-1.5"><i class="bi bi-wallet2"></i></span>
                </div>
                <h3 class="fs-4 fw-bold text-dark mb-0">₹<%= Number(adminStats?.totalReferrerRewardsPaid || 0).toLocaleString('en-IN') %></h3>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-2">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Cashback Paid</span>
                    <span class="badge bg-info-subtle text-info rounded-pill p-1.5"><i class="bi bi-cash"></i></span>
                </div>
                <h3 class="fs-4 fw-bold text-dark mb-0">₹<%= Number(adminStats?.totalReferredCashbackPaid || 0).toLocaleString('en-IN') %></h3>
            </div>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form action="/admin/referrals" method="GET" class="row g-2 align-items-center">
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input
                            type="text"
                            name="search"
                            class="form-control border-start-0 ps-0"
                            placeholder="Search by user name, email, or referral code..."
                            value="<%= search || '' %>"
                        >
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <select name="status" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="PENDING_ORDER" <%= status === 'PENDING_ORDER' ? 'selected' : '' %>>Pending Order</option>
                        <option value="QUALIFYING_ORDER_PLACED" <%= status === 'QUALIFYING_ORDER_PLACED' ? 'selected' : '' %>>Order Placed</option>
                        <option value="ORDER_DELIVERED" <%= status === 'ORDER_DELIVERED' ? 'selected' : '' %>>Order Delivered</option>
                        <option value="COMPLETED" <%= status === 'COMPLETED' ? 'selected' : '' %>>Completed (Rewarded)</option>
                        <option value="REVERSED" <%= status === 'REVERSED' ? 'selected' : '' %>>Reversed (Returned)</option>
                        <option value="RECOVERY_REQUIRED" <%= status === 'RECOVERY_REQUIRED' ? 'selected' : '' %>>Recovery Required</option>
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <button type="submit" class="btn btn-primary w-100 fw-medium">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                </div>

                <div class="col-12 col-md-2">
                    <a href="/admin/referrals" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-arrow-repeat me-1"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Referrals Table -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0" style="font-size: 0.88rem;">
                <thead class="table-light text-secondary text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.6px;">
                    <tr>
                        <th class="ps-3 py-3">Referrer</th>
                        <th class="py-3">Referred User</th>
                        <th class="py-3">Code Used</th>
                        <th class="py-3">Qualifying Order</th>
                        <th class="py-3">Status</th>
                        <th class="py-3">Rewards (Ref / User)</th>
                        <th class="py-3">Date</th>
                        <th class="pe-3 py-3 text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (referrals && referrals.length > 0) { %>
                        <% referrals.forEach(ref => { %>
                            <tr>
                                <td class="ps-3 py-3">
                                    <div class="fw-semibold text-dark"><%= ref.referrer?.fullName || 'Unknown' %></div>
                                    <div class="text-muted small"><%= ref.referrer?.email || 'N/A' %></div>
                                </td>
                                <td class="py-3">
                                    <div class="fw-semibold text-dark"><%= ref.referredUser?.fullName || 'Unknown' %></div>
                                    <div class="text-muted small"><%= ref.referredUser?.email || 'N/A' %></div>
                                </td>
                                <td class="py-3">
                                    <span class="badge bg-light text-dark font-monospace border"><%= ref.referralCode || ref.referralCodeUsed || 'N/A' %></span>
                                </td>
                                <td class="py-3">
                                    <% if (ref.qualifyingOrder) { %>
                                        <a href="/admin/orders/<%= ref.qualifyingOrder._id || ref.qualifyingOrder %>" class="text-decoration-none fw-semibold font-monospace small">
                                            #<%= ref.qualifyingOrder.orderNumber || String(ref.qualifyingOrder._id || ref.qualifyingOrder).slice(-8) %>
                                        </a>
                                        <% if (ref.qualifyingOrder.finalAmount) { %>
                                            <div class="text-muted small">₹<%= Number(ref.qualifyingOrder.finalAmount).toLocaleString('en-IN') %> (<%= ref.qualifyingOrder.orderStatus %>)</div>
                                        <% } %>
                                    <% } else { %>
                                        <span class="text-muted small fst-italic">None</span>
                                    <% } %>
                                </td>
                                <td class="py-3">
                                    <% if (ref.status === 'COMPLETED') { %>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">
                                            <i class="bi bi-check-circle me-1"></i> Completed
                                        </span>
                                    <% } else if (ref.status === 'ORDER_DELIVERED') { %>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1">
                                            <i class="bi bi-box-seam me-1"></i> Delivered
                                        </span>
                                    <% } else if (ref.status === 'QUALIFYING_ORDER_PLACED') { %>
                                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2.5 py-1">
                                            <i class="bi bi-bag-check me-1"></i> Order Placed
                                        </span>
                                    <% } else if (ref.status === 'REVERSED') { %>
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i> Reversed
                                        </span>
                                    <% } else if (ref.status === 'RECOVERY_REQUIRED') { %>
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2.5 py-1" title="<%= ref.recoveryReason || '' %>">
                                            <i class="bi bi-exclamation-triangle me-1"></i> Recovery Needed
                                        </span>
                                    <% } else { %>
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2.5 py-1">
                                            <i class="bi bi-clock me-1"></i> Pending Order
                                        </span>
                                    <% } %>
                                </td>
                                <td class="py-3">
                                    <div class="fw-semibold text-dark">
                                        ₹<%= Number(ref.referrerRewardAmountSnapshot || 200).toLocaleString('en-IN') %> /
                                        ₹<%= Number(ref.referredUserRewardAmountSnapshot || 200).toLocaleString('en-IN') %>
                                    </div>
                                    <div class="text-muted small" style="font-size: 0.72rem;">
                                        Min Order: ₹<%= Number(ref.minimumOrderAmountSnapshot || 1000).toLocaleString('en-IN') %>
                                    </div>
                                </td>
                                <td class="py-3 text-secondary small">
                                    <%= new Date(ref.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                </td>
                                <td class="pe-3 py-3 text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a href="/admin/referrals/<%= ref._id %>" class="btn btn-sm btn-outline-secondary px-2.5" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <% if (ref.status === 'ORDER_DELIVERED' || ref.status === 'RECOVERY_REQUIRED') { %>
                                            <button type="button" class="btn btn-sm btn-outline-primary px-2" title="Retry Reward" onclick="retryReward('<%= ref._id %>')">
                                                <i class="bi bi-arrow-clockwise"></i>
                                            </button>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-gift fs-2 d-block mb-2"></i>
                                No referral records found.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
            <div class="card-footer bg-white border-top py-3 px-3 d-flex justify-content-between align-items-center">
                <span class="text-muted small">
                    Showing <%= ((currentPage - 1) * 15) + 1 %> to <%= Math.min(currentPage * 15, totalCount) %> of <%= totalCount %> referrals
                </span>
                <nav aria-label="Referral pagination">
                    <ul class="pagination pagination-sm mb-0 gap-1">
                        <% if (currentPage > 1) { %>
                            <li class="page-item">
                                <a class="page-link rounded" href="/admin/referrals?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(search || '') %>&status=<%= encodeURIComponent(status || '') %>">&laquo;</a>
                            </li>
                        <% } %>
                        <% for (let p = 1; p <= totalPages; p++) { %>
                            <li class="page-item <%= p === currentPage ? 'active' : '' %>">
                                <a class="page-link rounded" href="/admin/referrals?page=<%= p %>&search=<%= encodeURIComponent(search || '') %>&status=<%= encodeURIComponent(status || '') %>"><%= p %></a>
                            </li>
                        <% } %>
                        <% if (currentPage < totalPages) { %>
                            <li class="page-item">
                                <a class="page-link rounded" href="/admin/referrals?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(search || '') %>&status=<%= encodeURIComponent(status || '') %>">&raquo;</a>
                            </li>
                        <% } %>
                    </ul>
                </nav>
            </div>
        <% } %>
    </div>
</div>

<script>
function retryReward(referralId) {
    Swal.fire({
        title: 'Retry Reward Disbursement?',
        text: 'This will attempt to credit wallet rewards to both the referrer and referred user.',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#0d6efd',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Yes, Process Reward'
    }).then((result) => {
        if (result.isConfirmed) {
            Swal.fire({
                title: 'Processing...',
                text: 'Credit in progress...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            fetch(`/admin/referrals/${referralId}/retry-reward`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: data.message || 'Rewards processed successfully.'
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Failed',
                        text: data.message || 'Unable to disburse rewards.'
                    });
                }
            })
            .catch(err => {
                Swal.fire({
                    icon: 'error',
                    title: 'Network Error',
                    text: 'An error occurred while contacting the server.'
                });
            });
        }
    });
}
</script>
