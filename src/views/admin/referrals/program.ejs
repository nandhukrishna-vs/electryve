<div class="container-fluid p-0">
    <!-- Header & Navigation -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <a href="/admin/referrals" class="btn btn-outline-secondary btn-sm rounded-circle p-2 d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h2 class="h3 fw-bold text-dark mb-0">Referral Program Configuration</h2>
                <p class="text-muted small mb-0">Configure rules, reward amounts, and qualifying conditions for new referrals.</p>
            </div>
        </div>
    </div>

    <!-- Flash Messages -->
    <% if (typeof successMessage !== "undefined" && successMessage) { %>
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <%= successMessage %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <% if (typeof errorMessage !== "undefined" && errorMessage) { %>
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <%= errorMessage %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-4">
                <form action="/admin/referrals/program" method="POST" id="programSettingsForm">
                    <!-- Program Status Switch -->
                    <div class="d-flex align-items-center justify-content-between p-3 rounded-3 bg-light mb-4 border">
                        <div>
                            <h6 class="fw-bold text-dark mb-1">Referral Program Status</h6>
                            <p class="text-muted small mb-0">When disabled, new signups will not be attributed with referral rewards.</p>
                        </div>
                        <div class="form-check form-switch fs-4">
                            <input class="form-check-input" type="checkbox" role="switch" id="isActive" name="isActive" value="true" <%= program?.isActive ? 'checked' : '' %>>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <!-- Referrer Reward Amount -->
                        <div class="col-md-6">
                            <label for="referrerRewardAmount" class="form-label fw-semibold text-dark small">
                                Referrer Reward Amount (₹) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">₹</span>
                                <input
                                    type="number"
                                    class="form-control"
                                    id="referrerRewardAmount"
                                    name="referrerRewardAmount"
                                    min="0"
                                    step="1"
                                    value="<%= program?.referrerRewardAmount || 200 %>"
                                    required
                                >
                            </div>
                            <span class="text-muted small" style="font-size: 0.75rem;">Credited to existing user's wallet when friend's order is delivered.</span>
                        </div>

                        <!-- Referred User Reward Amount -->
                        <div class="col-md-6">
                            <label for="referredUserRewardAmount" class="form-label fw-semibold text-dark small">
                                Referred User Cashback (₹) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">₹</span>
                                <input
                                    type="number"
                                    class="form-control"
                                    id="referredUserRewardAmount"
                                    name="referredUserRewardAmount"
                                    min="0"
                                    step="1"
                                    value="<%= program?.referredUserRewardAmount || 200 %>"
                                    required
                                >
                            </div>
                            <span class="text-muted small" style="font-size: 0.75rem;">Credited to new user's wallet when first order is delivered.</span>
                        </div>

                        <!-- Minimum Order Amount -->
                        <div class="col-md-6">
                            <label for="minimumOrderAmount" class="form-label fw-semibold text-dark small">
                                Minimum Qualifying Order Amount (₹) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">₹</span>
                                <input
                                    type="number"
                                    class="form-control"
                                    id="minimumOrderAmount"
                                    name="minimumOrderAmount"
                                    min="0"
                                    step="1"
                                    value="<%= program?.minimumOrderAmount || 1000 %>"
                                    required
                                >
                            </div>
                            <span class="text-muted small" style="font-size: 0.75rem;">Minimum order final amount required for rewards to trigger.</span>
                        </div>

                        <!-- Reward Trigger -->
                        <div class="col-md-6">
                            <label for="rewardTrigger" class="form-label fw-semibold text-dark small">
                                Reward Trigger Event <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="rewardTrigger" name="rewardTrigger">
                                <option value="ORDER_DELIVERED" <%= program?.rewardTrigger === 'ORDER_DELIVERED' ? 'selected' : '' %>>On Order Delivery (Recommended)</option>
                                <option value="ORDER_PLACED" <%= program?.rewardTrigger === 'ORDER_PLACED' ? 'selected' : '' %>>On Order Placement</option>
                            </select>
                            <span class="text-muted small" style="font-size: 0.75rem;">Triggering on delivery prevents fraud and returns abuse.</span>
                        </div>

                        <!-- Max Referrals Per User -->
                        <div class="col-md-6">
                            <label for="maxSuccessfulReferralsPerUser" class="form-label fw-semibold text-dark small">
                                Max Successful Referrals Per User
                            </label>
                            <input
                                type="number"
                                class="form-control"
                                id="maxSuccessfulReferralsPerUser"
                                name="maxSuccessfulReferralsPerUser"
                                min="0"
                                step="1"
                                value="<%= program?.maxSuccessfulReferralsPerUser || 0 %>"
                            >
                            <span class="text-muted small" style="font-size: 0.75rem;">Set to 0 for unlimited successful referrals.</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top">
                        <a href="/admin/referrals" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-medium">
                            <i class="bi bi-save me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Information / Guidance Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-4 h-100">
                <h5 class="fs-6 fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle-fill text-primary"></i>
                    Important Information
                </h5>

                <div class="d-flex flex-column gap-3 text-secondary small" style="font-size: 0.83rem; line-height: 1.5;">
                    <div>
                        <strong class="text-dark d-block mb-1">Snapshot Integrity:</strong>
                        Changes made here apply to future referral relationships and qualifying orders. Existing relationships retain their locked snapshot terms.
                    </div>

                    <div class="pt-2 border-top">
                        <strong class="text-dark d-block mb-1">Reversal Protection:</strong>
                        If a delivered order is subsequently returned or cancelled, the wallet rewards are safely reversed. If a user's wallet has insufficient balance, it is placed in <code>RECOVERY_REQUIRED</code> to prevent negative balances.
                    </div>

                    <div class="pt-2 border-top">
                        <strong class="text-dark d-block mb-1">Financial Isolation:</strong>
                        Referral bonuses are promotional store credits recorded as <code>REFERRAL_REWARD</code> in wallet transactions. They do not pollute sales reports or revenue figures.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
