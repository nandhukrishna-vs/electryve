<section class="hero-section">

    <div class="hero-content">

        <span class="hero-tag">
            Premium Electronics
        </span>

        <h1>
            Welcome to <br> Electryve
        </h1>

        <p>
            Discover smartphones, laptops, gaming accessories
            and premium gadgets at the best prices.
        </p>

        <a href="/shop" class="shop-btn">
            Shop Now
            <i class="bi bi-arrow-right"></i>
        </a>

    </div>

    <div class="hero-image">

        <img
            src="/images/electryve-hero-transparent.png"
            alt="Electryve Premium Electronics"
        >

    </div>

</section>

<section class="categories-section">

    <h2>Categories</h2>

    <div class="category-grid">

        <% categories.forEach(category => { %>

            <div class="category-card">

                <div class="category-icon">

                    <% if(category.name.toLowerCase() === "phones"){ %>

                        <i class="bi bi-phone"></i>

                    <% } else if(category.name.toLowerCase() === "laptops"){ %>

                        <i class="bi bi-laptop"></i>

                    <% } else if(category.name.toLowerCase() === "earbuds"){ %>

                        <i class="bi bi-headphones"></i>

                    <% } else { %>

                        <i class="bi bi-controller"></i>

                    <% } %>

                </div>

                <h3><%= category.name %></h3>

            </div>

        <% }) %>

    </div>

</section>

<section class="featured-section">
  <h2>Featured Products</h2>

  <div class="product-grid">
    <div class="product-card">
      <h3>Galaxy S26 Ultra</h3>
      <p>₹1,29,999</p>
    </div>

    <div class="product-card">
      <h3>iPhone 17 Pro</h3>
      <p>₹1,39,999</p>
    </div>

    <div class="product-card">
      <h3>MacBook Pro</h3>
      <p>₹1,89,999</p>
    </div>
  </div>
</section>