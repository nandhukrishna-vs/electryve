<!-- Storefront Client Scripts -->
<script>
document.addEventListener("DOMContentLoaded", () => {
    /* ----------------------------------------------------
       A. Interactive Promotional Carousel Slider
       ---------------------------------------------------- */
    const sliderContainer = document.getElementById("homePromoSlider");
    const track = document.getElementById("promoSliderTrack");
    const slides = document.querySelectorAll(".promo-slide");
    const prevBtn = document.getElementById("sliderPrevBtn");
    const nextBtn = document.getElementById("sliderNextBtn");
    const dots = document.querySelectorAll(".carousel-dot");

    if (sliderContainer && track && slides.length > 1) {
        let currentIndex = 0;
        const totalSlides = slides.length;
        let slideInterval = null;
        let isPaused = false;

        const updateSlide = (newIndex) => {
            if (newIndex < 0) {
                currentIndex = totalSlides - 1;
            } else if (newIndex >= totalSlides) {
                currentIndex = 0;
            } else {
                currentIndex = newIndex;
            }

            track.style.transform = `translateX(-${currentIndex * 100}%)`;

            dots.forEach((dot, idx) => {
                dot.classList.toggle("active", idx === currentIndex);
            });
        };

        const startAutoSlide = () => {
            stopAutoSlide();
            slideInterval = setInterval(() => {
                if (!isPaused) {
                    updateSlide(currentIndex + 1);
                }
            }, 5000);
        };

        const stopAutoSlide = () => {
            if (slideInterval) {
                clearInterval(slideInterval);
                slideInterval = null;
            }
        };

        if (nextBtn) {
            nextBtn.addEventListener("click", () => {
                updateSlide(currentIndex + 1);
                startAutoSlide();
            });
        }

        if (prevBtn) {
            prevBtn.addEventListener("click", () => {
                updateSlide(currentIndex - 1);
                startAutoSlide();
            });
        }

        dots.forEach(dot => {
            dot.addEventListener("click", (e) => {
                const targetIdx = parseInt(e.currentTarget.dataset.index, 10);
                updateSlide(targetIdx);
                startAutoSlide();
            });
        });

        // Pause on mouse hover and keyboard focus
        sliderContainer.addEventListener("mouseenter", () => { isPaused = true; });
        sliderContainer.addEventListener("mouseleave", () => { isPaused = false; });
        sliderContainer.addEventListener("focusin", () => { isPaused = true; });
        sliderContainer.addEventListener("focusout", () => { isPaused = false; });

        // Keyboard arrow navigation when container is focused
        sliderContainer.setAttribute("tabindex", "0");
        sliderContainer.addEventListener("keydown", (e) => {
            if (e.key === "ArrowLeft") {
                updateSlide(currentIndex - 1);
                startAutoSlide();
            } else if (e.key === "ArrowRight") {
                updateSlide(currentIndex + 1);
                startAutoSlide();
            }
        });

        // Touch Swipe Gestures
        let touchStartX = 0;
        let touchEndX = 0;

        sliderContainer.addEventListener("touchstart", (e) => {
            touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        sliderContainer.addEventListener("touchend", (e) => {
            touchEndX = e.changedTouches[0].screenX;
            const diff = touchStartX - touchEndX;
            if (Math.abs(diff) > 50) {
                if (diff > 0) {
                    updateSlide(currentIndex + 1); // Swipe left -> Next
                } else {
                    updateSlide(currentIndex - 1); // Swipe right -> Prev
                }
                startAutoSlide();
            }
        }, { passive: true });

        startAutoSlide();
    }

    /* ----------------------------------------------------
       B. Add to Cart Handling (Delegated)
       ---------------------------------------------------- */
    document.addEventListener("click", (e) => {
        const btn = e.target.closest(".shop-add-to-cart-btn");
        if (!btn) return;
        e.preventDefault();

        const productId = btn.dataset.productId;
        const variantId = btn.dataset.variantId;
        if (!productId || !variantId) return;

        btn.disabled = true;

        fetch("/cart/add", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                productId,
                variantId,
                quantity: 1
            })
        })
        .then(res => {
            if (res.status === 401) {
                Swal.fire({
                    title: 'Log In Required',
                    text: 'You need to log in to add items to your cart.',
                    icon: 'info',
                    showCancelButton: true,
                    confirmButtonText: 'Log In',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#111827'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = "/auth/login";
                    }
                });
                return null;
            }
            return res.json();
        })
        .then(data => {
            btn.disabled = false;
            if (!data) return;

            if (data.success) {
                if (window.showSuccess) {
                    window.showSuccess(data.message || "Product added to cart!");
                } else {
                    Swal.fire({
                        icon: 'success',
                        title: 'Added to Cart',
                        text: data.message || "Product added to cart!",
                        confirmButtonColor: '#111827',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
                if (typeof refreshNavbarCartCount === "function") {
                    refreshNavbarCartCount();
                }
            } else {
                if (window.showError) {
                    window.showError(data.message || "Failed to add product to cart.");
                } else {
                    Swal.fire({
                        title: 'Unable to Add',
                        text: data.message || "Failed to add product to cart.",
                        icon: 'error',
                        confirmButtonColor: '#111827'
                    });
                }
            }
        })
        .catch(err => {
            btn.disabled = false;
            console.error("Home page add to cart error:", err);
            Swal.fire({
                title: 'Error',
                text: 'An error occurred while adding the product to your cart.',
                icon: 'error',
                confirmButtonColor: '#111827'
            });
        });
    });

    /* ----------------------------------------------------
       C. Wishlist Heart Button Toggle (Delegated)
       ---------------------------------------------------- */
    document.addEventListener("click", function(e) {
        const btn = e.target.closest(".wishlist-heart-btn");
        if (!btn) return;
        e.preventDefault();

        const productId = btn.dataset.productId;
        const variantId = btn.dataset.variantId;
        const icon = btn.querySelector("i");

        if (!productId || !variantId) return;

        const inWishlist = icon.classList.contains("bi-heart-fill");
        const url = inWishlist ? "/wishlist/remove" : "/wishlist/add";

        btn.disabled = true;

        fetch(url, {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({ productId, variantId })
        })
        .then(res => {
            if (res.status === 401) {
                Swal.fire({
                    title: 'Log In Required',
                    text: 'You need to log in to manage your wishlist.',
                    icon: 'info',
                    showCancelButton: true,
                    confirmButtonText: 'Log In',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#111827'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = "/auth/login";
                    }
                });
                return null;
            }
            return res.json();
        })
        .then(data => {
            btn.disabled = false;
            if (!data) return;

            if (data.success) {
                if (inWishlist) {
                    icon.className = "bi bi-heart";
                    icon.classList.remove("text-danger");
                } else {
                    icon.className = "bi bi-heart-fill text-danger";
                }

                if (window.showSuccess) {
                    window.showSuccess(data.message || (inWishlist ? "Removed from wishlist" : "Added to wishlist"));
                } else {
                    Swal.fire({
                        icon: 'success',
                        title: inWishlist ? 'Removed from Wishlist' : 'Added to Wishlist',
                        text: data.message || (inWishlist ? "Product removed from wishlist" : "Product added to wishlist"),
                        timer: 1500,
                        showConfirmButton: false
                    });
                }

                if (typeof refreshNavbarWishlistCount === "function") {
                    refreshNavbarWishlistCount();
                }
            } else {
                Swal.fire({
                    title: 'Oops...',
                    text: data.message || "Failed to update wishlist.",
                    icon: 'error',
                    confirmButtonColor: '#111827'
                });
            }
        })
        .catch(err => {
            btn.disabled = false;
            console.error("Home page wishlist error:", err);
            Swal.fire({
                title: 'Error',
                text: 'An error occurred while updating your wishlist.',
                icon: 'error',
                confirmButtonColor: '#111827'
            });
        });
    });
});
</script>