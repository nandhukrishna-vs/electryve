<style>
    .details-section-wrapper {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background-color: #f8f9fa;
        min-height: 85vh;
    }
    .details-card {
        background-color: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
    }
    .details-img-wrapper {
        width: 60px;
        height: 60px;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        background-color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }
    .details-img-wrapper img {
        max-width: 90%;
        max-height: 90%;
        object-fit: contain;
    }
    
    @media (max-width: 768px) {
        .details-item-row {
            flex-direction: column;
            text-align: center;
        }
        .details-img-wrapper {
            margin: 0 auto 8px;
        }
        .details-price-block {
            text-align: center !important;
            margin-top: 8px;
        }
    }
</style>

<div class="details-section-wrapper py-5">
    <div class="container-xl" style="max-width: 1400px; margin: 0 auto; width: 100%;">
        <!-- Back Navigation -->
        <div class="mb-4">
            <a href="/orders" class="text-decoration-none text-dark small fw-medium">
                <i class="bi bi-arrow-left me-1"></i> Back to Orders
            </a>
        </div>

        <!-- Page Header -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h1 class="fw-bold text-dark mb-1 fs-3">Order details</h1>
                <p class="text-secondary small mb-0">Order ID: <strong class="text-dark"><%= order.orderNumber %></strong> • Placed on <%= new Date(order.createdAt).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <% if (order.orderStatus === 'PLACED') { %>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 fw-bold text-uppercase" style="font-size: 0.75rem;">
                        🔵 PLACED
                    </span>
                <% } else if (order.orderStatus === 'SHIPPED') { %>
                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-3 py-2 fw-bold text-uppercase" style="font-size: 0.75rem;">
                        ✈️ SHIPPED
                    </span>
                <% } else if (order.orderStatus === 'OUT_FOR_DELIVERY') { %>
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-2 fw-bold text-uppercase" style="font-size: 0.75rem;">
                        🚚 OUT FOR DELIVERY
                    </span>
                <% } else if (order.orderStatus === 'DELIVERED') { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 fw-bold text-uppercase" style="font-size: 0.75rem;">
                        🟢 DELIVERED
                    </span>
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1.5 shadow-sm" onclick="promptReturnOrder('<%= order._id %>')">
                        <i class="bi bi-arrow-return-left"></i>
                        <span>Return Order</span>
                    </button>
                <% } else if (order.orderStatus === 'CANCELLED') { %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2 fw-bold text-uppercase" style="font-size: 0.75rem;">
                        🔴 CANCELLED
                    </span>
                <% } else if (order.orderStatus === 'RETURNED') { %>
                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-3 py-2 fw-bold text-uppercase" style="font-size: 0.75rem;">
                        ↩️ RETURNED
                    </span>
                <% } %>
            </div>
        </div>

        <!-- Returned Notice (shown when order has been returned) -->
        <% if (order.orderStatus === 'RETURNED') { %>
            <div class="alert alert-secondary border rounded-3 p-3 mb-4 d-flex align-items-start gap-2.5">
                <i class="bi bi-info-circle-fill fs-5 text-secondary flex-shrink-0 mt-0.5"></i>
                <div>
                    <strong class="d-block text-dark small">Order Returned</strong>
                    <span class="text-secondary small">
                        Reason: "<%= order.returnReason || 'No reason specified' %>"
                        <% if (order.returnedAt) { %>
                            • Returned on <%= new Date(order.returnedAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                        <% } %>
                    </span>
                </div>
            </div>
        <% } %>

        <div class="row g-4">
            <!-- Left Column: Order Items & Delivery Address -->
            <div class="col-lg-8">
                <div class="card details-card shadow-sm p-4 mb-4">
                    <h5 class="fw-bold text-dark mb-3">Items Ordered</h5>
                    <div class="d-flex flex-column gap-3">
                        <% order.items.forEach(item => { %>
                            <div class="d-flex align-items-center gap-3 py-2.5 border-bottom last-border-none details-item-row">
                                <div class="details-img-wrapper flex-shrink-0">
                                    <img src="<%= item.image %>" alt="<%= item.productName %>">
                                </div>
                                <div class="flex-grow-1 min-w-0 text-start">
                                    <span class="text-uppercase text-muted fw-bold d-block mb-0.5" style="font-size: 0.65rem; letter-spacing: 0.5px;"><%= item.brandName %></span>
                                    <h6 class="fw-bold text-dark text-truncate mb-1" style="font-size: 0.95rem;"><%= item.productName %></h6>
                                    <div class="text-secondary small d-flex align-items-center gap-2 flex-wrap" style="font-size: 0.8rem;">
                                        <span><%= item.variantDetails %></span>
                                        <span>•</span>
                                        <span>Qty: <%= item.quantity %></span>
                                    </div>
                                </div>
                                <div class="text-dark fw-bold text-end flex-shrink-0 details-price-block small">
                                    ₹<%= item.itemTotal.toLocaleString() %>
                                    <div class="text-secondary small fw-normal" style="font-size: 0.75rem;">₹<%= item.salePrice.toLocaleString() %> each</div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <div class="card details-card shadow-sm p-4">
                    <h5 class="fw-bold text-dark mb-3">Shipping Address</h5>
                    <div class="text-dark" style="font-size: 0.9rem; line-height: 1.5;">
                        <div class="fw-bold text-capitalize mb-1.5"><%= order.shippingAddress.fullName %></div>
                        <div class="text-secondary mb-1">
                            <%= order.shippingAddress.addressLine1 %>
                            <% if (order.shippingAddress.addressLine2) { %>, <%= order.shippingAddress.addressLine2 %><% } %>
                            <% if (order.shippingAddress.landmark) { %><br><span class="text-muted">Landmark: <%= order.shippingAddress.landmark %></span><% } %>
                        </div>
                        <div class="text-secondary mb-2">
                            <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> - <strong class="text-dark"><%= order.shippingAddress.pinCode %></strong>
                        </div>
                        <div class="text-secondary">
                            <i class="bi bi-telephone-fill me-1"></i> Phone: <%= order.shippingAddress.phone %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Payment & Cost Summary -->
            <div class="col-lg-4">
                <div class="card details-card shadow-sm p-4 mb-4">
                    <h5 class="fw-bold text-dark mb-3">Payment Summary</h5>
                    <div class="d-flex flex-column gap-2.5 mb-3" style="font-size: 0.85rem;">
                        <div class="d-flex justify-content-between text-secondary">
                            <span>Subtotal</span>
                            <span class="text-dark fw-medium">₹<%= order.subtotal.toLocaleString() %></span>
                        </div>
                        <% if (order.discount > 0) { %>
                            <div class="d-flex justify-content-between text-danger">
                                <span>Discount</span>
                                <span>-₹<%= order.discount.toLocaleString() %></span>
                            </div>
                        <% } %>
                        <div class="d-flex justify-content-between text-secondary">
                            <span>Shipping</span>
                            <% if (order.shippingCharge === 0) { %>
                                <span class="text-success fw-medium">FREE</span>
                            <% } else { %>
                                <span class="text-dark fw-medium">₹<%= order.shippingCharge.toLocaleString() %></span>
                            <% } %>
                        </div>
                        <div class="d-flex justify-content-between text-secondary">
                            <span>Tax</span>
                            <span class="text-dark fw-medium">₹<%= order.tax.toLocaleString() %></span>
                        </div>
                    </div>

                    <hr class="my-3 text-muted opacity-25">

                    <div class="d-flex justify-content-between text-dark fs-6 fw-bold mb-4 align-items-center">
                        <span>Total Paid</span>
                        <span>₹<%= order.finalAmount.toLocaleString() %></span>
                    </div>

                    <div class="border rounded-3 p-3 bg-light text-center small">
                        <span class="text-secondary d-block mb-1">Payment Method</span>
                        <strong class="text-dark text-uppercase">Cash on Delivery (COD)</strong>
                        <div class="text-warning-emphasis fw-bold mt-1.5">Status: <%= order.paymentStatus %></div>
                    </div>

                    <% if (order.orderStatus === 'DELIVERED') { %>
                        <div class="mt-3">
                            <button type="button" class="btn btn-outline-danger w-100 rounded-3 py-2.5 fw-semibold d-inline-flex align-items-center justify-content-center gap-2 shadow-sm" onclick="promptReturnOrder('<%= order._id %>')">
                                <i class="bi bi-arrow-return-left"></i>
                                <span>Return Order</span>
                            </button>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
/**
 * Prompt for return reason and submit AJAX PATCH request to return delivered order
 */
async function promptReturnOrder(orderId) {
    const { value: reason, isConfirmed } = await Swal.fire({
        title: "Return Order",
        text: "Please provide a reason for returning this delivered order:",
        input: "textarea",
        inputPlaceholder: "Please provide a reason for returning this order.",
        inputAttributes: {
            "aria-label": "Please provide a reason for returning this order",
            maxlength: 500,
            rows: 3
        },
        showCancelButton: true,
        confirmButtonColor: "#dc3545",
        cancelButtonColor: "#6c757d",
        confirmButtonText: "Confirm Return",
        cancelButtonText: "Cancel",
        inputValidator: (value) => {
            if (!value || value.trim().length < 3) {
                return "A valid return reason (at least 3 characters) is required!";
            }
        }
    });

    if (!isConfirmed || !reason) return;

    try {
        Swal.fire({
            title: "Processing Return...",
            text: "Submitting your return request, please wait.",
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        const res = await fetch(`/order/${orderId}/return`, {
            method: "PATCH",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({ reason: reason.trim() })
        });

        const data = await res.json();

        if (data.success) {
            await Swal.fire({
                icon: "success",
                title: "Order Returned",
                text: data.message || "Order returned successfully.",
                timer: 1800,
                showConfirmButton: false
            });
            window.location.reload();
        } else {
            Swal.fire({
                icon: "error",
                title: "Return Failed",
                text: data.message || "Could not process your return request."
            });
        }
    } catch (err) {
        console.error("Return order error:", err);
        Swal.fire({
            icon: "error",
            title: "Network Error",
            text: "Failed to communicate with server. Please try again."
        });
    }
}
</script>
