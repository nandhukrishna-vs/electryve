/**
 * Prompt for return reason and submit AJAX PATCH request to submit an item return request
 */
async function promptReturnItem(orderId, itemId, productName) {
    const { value: reason, isConfirmed } = await Swal.fire({
        title: "Request Item Return",
        text: `Please provide a reason for returning "${productName}". Your request will be submitted for admin review:`,
        input: "textarea",
        inputPlaceholder: "Please provide a reason for returning this item.",
        inputAttributes: {
            "aria-label": "Please provide a reason for returning this item",
            maxlength: 500,
            rows: 3
        },
        showCancelButton: true,
        confirmButtonColor: "#dc3545",
        cancelButtonColor: "#6c757d",
        confirmButtonText: "Submit Return Request",
        cancelButtonText: "Cancel",
        inputValidator: (value) => {
            if (!value || value.trim().length < 3) {
                return "A valid return reason (at least 3 characters) is required!";
            }
        }
    });

    if (!isConfirmed || !reason) return;

    try {
        Swal.fire({
            title: "Submitting Request...",
            text: "Sending your return request for review, please wait.",
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        const res = await fetch(`/order/${orderId}/items/${itemId}/return`, {
            method: "PATCH",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({ reason: reason.trim() })
        });

        const data = await res.json();

        if (data.success) {
            await Swal.fire({
                icon: "success",
                title: "Return Request Submitted",
                text: data.message || "Your return request has been submitted for review.",
                timer: 2000,
                showConfirmButton: false
            });
            window.location.reload();
        } else {
            Swal.fire({
                icon: "error",
                title: "Request Failed",
                text: data.message || "Could not submit your return request."
            });
        }
    } catch (err) {
        console.error("Return item error:", err);
        Swal.fire({
            icon: "error",
            title: "Network Error",
            text: "Failed to communicate with server. Please try again."
        });
    }
}
</script>
