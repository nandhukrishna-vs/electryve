<style>
    .details-section-wrapper {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background-color: #f8f9fa;
        min-height: 85vh;
    }
    .details-card {
        background-color: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
    }
    .details-img-wrapper {
        width: 60px;
        height: 60px;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        background-color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }
    .details-img-wrapper img {
        max-width: 90%;
        max-height: 90%;
        object-fit: contain;
    }
    
    .order-status-badge {
        font-size: 0.72rem;
        letter-spacing: 0.3px;
        user-select: none;
        pointer-events: none;
    }
    .order-header-actions .btn {
        white-space: nowrap;
    }
    @media (max-width: 575.98px) {
        .order-header-actions {
            width: 100%;
        }
        .order-header-actions .btn,
        .order-header-actions .badge {
            width: 100%;
        }
    }
    @media (max-width: 768px) {
        .details-item-row {
            flex-direction: column;
            text-align: center;
        }
        .details-img-wrapper {
            margin: 0 auto 8px;
        }
        .details-price-block {
            text-align: center !important;
            margin-top: 8px;
        }
    }
</style>

<div class="details-section-wrapper py-5">
    <div class="container-xl" style="max-width: 1400px; margin: 0 auto; width: 100%;">
        <!-- Back Navigation -->
        <div class="mb-4">
            <a href="/orders" class="text-decoration-none text-dark small fw-medium">
                <i class="bi bi-arrow-left me-1"></i> Back to Orders
            </a>
        </div>

        <!-- Page Header: Separates Order Information (Left) and Actions (Right) -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
            <div>
                <h1 class="fw-bold text-dark mb-1 fs-3">Order details</h1>
                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                    <span class="text-secondary small">Order ID: <strong class="text-dark"><%= order.orderNumber %></strong></span>
                    <% if (order.orderStatus === 'PLACED') { %>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 fw-bold text-uppercase order-status-badge">
                            🔵 PLACED
                        </span>
                    <% } else if (order.orderStatus === 'SHIPPED') { %>
                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-2.5 py-1 fw-bold text-uppercase order-status-badge">
                            ✈️ SHIPPED
                        </span>
                    <% } else if (order.orderStatus === 'OUT_FOR_DELIVERY') { %>
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1 fw-bold text-uppercase order-status-badge">
                            🚚 OUT FOR DELIVERY
                        </span>
                    <% } else if (order.orderStatus === 'DELIVERED') { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 fw-bold text-uppercase order-status-badge">
                            🟢 DELIVERED
                        </span>
                    <% } else if (order.orderStatus === 'CANCELLED') { %>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1 fw-bold text-uppercase order-status-badge">
                            ✕ CANCELLED
                        </span>
                    <% } else if (order.orderStatus === 'RETURNED' || (order.returnRequest && order.returnRequest.status === 'APPROVED')) { %>
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-2.5 py-1 fw-bold text-uppercase order-status-badge">
                            ↩️ RETURNED
                        </span>
                    <% } %>
                </div>
                <p class="text-secondary small mb-0">
                    Placed on <%= new Date(order.createdAt).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) %>
                </p>
            </div>

            <!-- Action Buttons Group -->
            <div class="order-header-actions d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2 mt-2 mt-md-0">
                <!-- Download Invoice -->
                <a href="/order/<%= order._id %>/invoice" class="btn btn-outline-dark btn-sm rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-1.5 shadow-sm">
                    <i class="bi bi-file-earmark-arrow-down"></i>
                    <span>Download Invoice</span>
                </a>

                <!-- Pre-Delivery Order Cancellation: Allowed ONLY while PLACED -->
                <% if (order.orderStatus === 'PLACED') { %>
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-1.5 shadow-sm" onclick="promptCancelOrder('<%= order._id %>')">
                        <i class="bi bi-x-circle"></i>
                        <span>Cancel Order</span>
                    </button>
                <% } %>

                <!-- Post-Delivery Return Actions -->
                <% if (order.orderStatus === 'DELIVERED') { %>
                    <% if (!order.returnRequest || order.returnRequest.status === 'NONE') { %>
                        <button type="button" class="btn btn-outline-danger btn-sm rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-1.5 shadow-sm" onclick="promptReturnOrder('<%= order._id %>')">
                            <i class="bi bi-arrow-return-left"></i>
                            <span>Request Return</span>
                        </button>
                    <% } else if (order.returnRequest.status === 'PENDING') { %>
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-1.5 shadow-sm" style="font-size: 0.78rem;">
                            <i class="bi bi-clock-history"></i>
                            <span>Return Request Pending</span>
                        </span>
                    <% } else if (order.returnRequest.status === 'REJECTED') { %>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-1.5 shadow-sm" style="font-size: 0.78rem;">
                            <i class="bi bi-x-circle"></i>
                            <span>Return Request Rejected</span>
                        </span>
                    <% } %>
                <% } %>
            </div>
        </div>

        <!-- Return Notices (Returned, Pending Request, or Rejected Request) -->
        <% if (order.orderStatus === 'RETURNED' || (order.returnRequest && order.returnRequest.status === 'APPROVED')) { %>
            <div class="alert alert-secondary border rounded-3 p-3 mb-4 d-flex align-items-start gap-2.5">
                <i class="bi bi-info-circle-fill fs-5 text-secondary flex-shrink-0 mt-0.5"></i>
                <div>
                    <strong class="d-block text-dark small">Order Returned</strong>
                    <span class="text-secondary small">
                        Reason: "<%= order.returnReason || (order.returnRequest && order.returnRequest.reason) || 'No reason specified' %>"
                        <% if (order.returnedAt) { %>
                            • Returned on <%= new Date(order.returnedAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                        <% } %>
                    </span>
                </div>
            </div>
        <% } else if (order.orderStatus === 'DELIVERED' && order.returnRequest && order.returnRequest.status === 'PENDING') { %>
            <div class="alert alert-warning border-warning-subtle rounded-3 p-3 mb-4 d-flex align-items-start gap-2.5">
                <i class="bi bi-clock-history fs-5 text-warning flex-shrink-0 mt-0.5"></i>
                <div>
                    <strong class="d-block text-dark small">Return Request Under Review</strong>
                    <span class="text-secondary small">
                        You submitted a return request on <%= order.returnRequest.requestedAt ? new Date(order.returnRequest.requestedAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '' %>.
                        <br>Reason provided: "<%= order.returnRequest.reason %>". Our team is currently reviewing your request.
                    </span>
                </div>
            </div>
        <% } else if (order.orderStatus === 'DELIVERED' && order.returnRequest && order.returnRequest.status === 'REJECTED') { %>
            <div class="alert alert-danger border-danger-subtle rounded-3 p-3 mb-4 d-flex align-items-start gap-2.5">
                <i class="bi bi-exclamation-octagon-fill fs-5 text-danger flex-shrink-0 mt-0.5"></i>
                <div>
                    <strong class="d-block text-dark small">Return Request Rejected</strong>
                    <span class="text-secondary small">
                        Your return request was reviewed and rejected.
                        <% if (order.returnRequest.rejectionReason) { %>
                            <br>Reason: "<%= order.returnRequest.rejectionReason %>".
                        <% } %>
                        <% if (order.returnRequest.reviewedAt) { %>
                            • Reviewed on <%= new Date(order.returnRequest.reviewedAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                        <% } %>
                    </span>
                </div>
            </div>
        <% } else if (order.orderStatus === 'CANCELLED') { %>
            <div class="alert alert-danger border-danger-subtle rounded-3 p-3 mb-4 d-flex align-items-start gap-2.5">
                <i class="bi bi-x-circle-fill fs-5 text-danger flex-shrink-0 mt-0.5"></i>
                <div>
                    <strong class="d-block text-dark small">Order Cancelled</strong>
                    <span class="text-secondary small">
                        Reason: "<%= order.cancellationReason || 'No reason specified' %>"
                        <% if (order.cancelledAt) { %>
                            • Cancelled on <%= new Date(order.cancelledAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                        <% } %>
                    </span>
                </div>
            </div>
        <% } %>

        <div class="row g-4">
            <!-- Left Column: Order Items & Delivery Address -->
            <div class="col-lg-8">
                <div class="card details-card shadow-sm p-4 mb-4">
                    <h5 class="fw-bold text-dark mb-3">Items Ordered</h5>
                    <div class="d-flex flex-column gap-3">
                        <% order.items.forEach(item => { %>
                            <div class="d-flex align-items-center gap-3 py-2.5 border-bottom last-border-none details-item-row">
                                <div class="details-img-wrapper flex-shrink-0">
                                    <img src="<%= item.image %>" alt="<%= item.productName %>">
                                </div>
                                <div class="flex-grow-1 min-w-0 text-start">
                                    <span class="text-uppercase text-muted fw-bold d-block mb-0.5" style="font-size: 0.65rem; letter-spacing: 0.5px;"><%= item.brandName %></span>
                                    <h6 class="fw-bold text-dark text-truncate mb-1" style="font-size: 0.95rem;"><%= item.productName %></h6>
                                    <div class="text-secondary small d-flex align-items-center gap-2 flex-wrap" style="font-size: 0.8rem;">
                                        <span><%= item.variantDetails %></span>
                                        <span>•</span>
                                        <span>Qty: <%= item.quantity %></span>
                                        <% if (item.itemStatus === 'CANCELLED') { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-0.5 fw-semibold" style="font-size: 0.7rem;">CANCELLED</span>
                                            <% if (item.refundAmount && item.refundAmount > 0) { %>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5 fw-semibold" style="font-size: 0.7rem;">
                                                    <i class="bi bi-wallet2 me-1"></i>Refunded ₹<%= item.refundAmount.toLocaleString() %> to Wallet
                                                </span>
                                            <% } %>
                                        <% } else if (item.itemStatus === 'RETURNED') { %>
                                            <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-2 py-0.5 fw-semibold" style="font-size: 0.7rem;">RETURNED</span>
                                            <% if (item.refundAmount && item.refundAmount > 0) { %>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5 fw-semibold" style="font-size: 0.7rem;">
                                                    <i class="bi bi-wallet2 me-1"></i>Refunded ₹<%= item.refundAmount.toLocaleString() %> to Wallet
                                                </span>
                                            <% } %>
                                        <% } else if (item.returnRequest && item.returnRequest.status === 'PENDING') { %>
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-0.5 fw-semibold" style="font-size: 0.7rem;">
                                                <i class="bi bi-clock-history me-0.5"></i>Return Requested
                                            </span>
                                        <% } else if (item.returnRequest && item.returnRequest.status === 'REJECTED') { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-0.5 fw-semibold" style="font-size: 0.7rem;">
                                                <i class="bi bi-x-circle me-0.5"></i>Return Rejected
                                            </span>
                                        <% } %>
                                    </div>
                                    <% if (item.returnRequest && item.returnRequest.status === 'REJECTED' && item.returnRequest.rejectionReason) { %>
                                        <div class="text-danger small mt-1" style="font-size: 0.72rem;">
                                            <i class="bi bi-info-circle me-1"></i>Rejection reason: "<%= item.returnRequest.rejectionReason %>"
                                        </div>
                                    <% } %>
                                    <% if (item.appliedOfferName) { %>
                                        <div class="mt-1">
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-0.5" style="font-size: 0.7rem;">
                                                <i class="bi bi-tag-fill me-1"></i><%= item.appliedOfferName %>
                                                <% if (item.offerDiscount > 0) { %> (-₹<%= item.offerDiscount.toLocaleString('en-IN') %>)<% } %>
                                            </span>
                                        </div>
                                    <% } %>
                                    <% if (item.cancellationReason) { %>
                                        <div class="text-secondary small mt-0.5" style="font-size: 0.72rem;">
                                            <i class="bi bi-info-circle me-1"></i>Cancelled: <%= item.cancellationReason %>
                                        </div>
                                    <% } %>
                                </div>
                                <div class="text-dark fw-bold text-end flex-shrink-0 details-price-block small">
                                    ₹<%= item.itemTotal.toLocaleString('en-IN') %>
                                    <% if (item.appliedOfferName && item.offerDiscount > 0) { %>
                                        <div class="text-success small fw-medium" style="font-size: 0.75rem;">₹<%= (item.effectiveItemPrice || Math.round(item.itemTotal / item.quantity)).toLocaleString('en-IN') %> each</div>
                                        <div class="text-muted text-decoration-line-through small mb-2" style="font-size: 0.7rem;">₹<%= item.salePrice.toLocaleString('en-IN') %> each</div>
                                    <% } else { %>
                                        <div class="text-secondary small fw-normal mb-2" style="font-size: 0.75rem;">₹<%= item.salePrice.toLocaleString('en-IN') %> each</div>
                                    <% } %>

                                    <!-- Item-level Actions -->
                                    <% if (order.orderStatus === 'PLACED' && item.itemStatus === 'ACTIVE') { %>
                                        <button
                                            type="button"
                                            class="btn btn-outline-danger btn-sm rounded-3 py-1 px-2 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm"
                                            style="font-size: 0.75rem;"
                                            onclick='promptCancelItem("<%= order._id %>", "<%= item._id %>", <%- JSON.stringify(item.productName) %>)'>
                                            Cancel Item
                                        </button>
                                    <% } else if (order.orderStatus === 'DELIVERED' && item.itemStatus === 'ACTIVE') { %>
                                        <% if (!item.returnRequest || item.returnRequest.status === 'NONE') { %>
                                            <button
                                                type="button"
                                                class="btn btn-outline-warning btn-sm rounded-3 py-1 px-2 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm"
                                                style="font-size: 0.75rem;"
                                                onclick='promptReturnItem("<%= order._id %>", "<%= item._id %>", <%- JSON.stringify(item.productName) %>)'>
                                                Request Return
                                            </button>
                                        <% } %>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <div class="card details-card shadow-sm p-4">
                    <h5 class="fw-bold text-dark mb-3">Shipping Address</h5>
                    <div class="text-dark" style="font-size: 0.9rem; line-height: 1.5;">
                        <div class="fw-bold text-capitalize mb-1.5"><%= order.shippingAddress.fullName %></div>
                        <div class="text-secondary mb-1">
                            <%= order.shippingAddress.addressLine1 %>
                            <% if (order.shippingAddress.addressLine2) { %>, <%= order.shippingAddress.addressLine2 %><% } %>
                            <% if (order.shippingAddress.landmark) { %><br><span class="text-muted">Landmark: <%= order.shippingAddress.landmark %></span><% } %>
                        </div>
                        <div class="text-secondary mb-2">
                            <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> - <strong class="text-dark"><%= order.shippingAddress.pinCode %></strong>
                        </div>
                        <div class="text-secondary">
                            <i class="bi bi-telephone-fill me-1"></i> Phone: <%= order.shippingAddress.phone %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Payment & Cost Summary -->
            <div class="col-lg-4">
                <div class="card details-card shadow-sm p-4 mb-4">
                    <h5 class="fw-bold text-dark mb-3">Payment Summary</h5>
                    <div class="d-flex flex-column gap-2.5 mb-3" style="font-size: 0.85rem;">
                        <div class="d-flex justify-content-between text-secondary">
                            <span>Subtotal</span>
                            <span class="text-dark fw-medium">₹<%= order.subtotal.toLocaleString('en-IN') %></span>
                        </div>
                        <% if (order.totalOfferDiscount && order.totalOfferDiscount > 0) { %>
                            <div class="d-flex justify-content-between text-success fw-medium">
                                <span>Offer Savings</span>
                                <span>-₹<%= order.totalOfferDiscount.toLocaleString('en-IN') %></span>
                            </div>
                        <% } %>
                        <% if (order.discount > 0) { %>
                            <div class="d-flex justify-content-between text-danger">
                                <span>Discount</span>
                                <span>-₹<%= order.discount.toLocaleString('en-IN') %></span>
                            </div>
                        <% } %>
                        <div class="d-flex justify-content-between text-secondary">
                            <span>Shipping</span>
                            <% if (order.shippingCharge === 0) { %>
                                <span class="text-success fw-medium">FREE</span>
                            <% } else { %>
                                <span class="text-dark fw-medium">₹<%= order.shippingCharge.toLocaleString() %></span>
                            <% } %>
                        </div>
                        <div class="d-flex justify-content-between text-secondary">
                            <span>Tax</span>
                            <span class="text-dark fw-medium">₹<%= order.tax.toLocaleString() %></span>
                        </div>
                    </div>

                    <hr class="my-3 text-muted opacity-25">

                    <div class="d-flex justify-content-between text-dark fs-6 fw-bold mb-4 align-items-center">
                        <span>Total Paid</span>
                        <span>₹<%= order.finalAmount.toLocaleString() %></span>
                    </div>

                    <div class="border rounded-3 p-3 bg-light text-center small mb-3">
                        <span class="text-secondary d-block mb-1">Payment Method</span>
                        <strong class="text-dark">
                            <% if (order.paymentMethod === 'COD') { %>
                                Cash on Delivery (COD)
                            <% } else if (order.paymentMethod === 'WALLET') { %>
                                <i class="bi bi-wallet2 me-1 text-primary"></i> Electryve Wallet
                            <% } else if (order.paymentMethod === 'RAZORPAY') { %>
                                <i class="bi bi-credit-card me-1 text-primary"></i> Online Payment (Razorpay)
                            <% } else { %>
                                <%= order.paymentMethod %>
                            <% } %>
                        </strong>
                        <div class="fw-bold mt-1.5 <%= (order.paymentStatus === 'PAID' || order.paymentStatus === 'COMPLETED') ? 'text-success' : (order.paymentStatus === 'FAILED' ? 'text-danger' : 'text-warning-emphasis') %>">
                            Status: <%= order.paymentStatus %>
                        </div>
                    </div>

                    <% if (order.refundAmount && order.refundAmount > 0) { %>
                        <div class="border border-success-subtle rounded-3 p-3 bg-success-subtle text-start small">
                            <div class="d-flex align-items-center gap-2 mb-1 text-success fw-bold">
                                <i class="bi bi-check-circle-fill"></i>
                                <span><%= order.refundStatus === 'REFUNDED' ? 'Full Refund Processed' : 'Partial Refund Processed' %></span>
                            </div>
                            <div class="text-secondary" style="font-size: 0.8rem;">
                                Refund Amount: <strong class="text-dark">₹<%= order.refundAmount.toLocaleString() %></strong>
                            </div>
                            <div class="text-secondary" style="font-size: 0.8rem;">
                                Credited To: <strong class="text-dark"><i class="bi bi-wallet2 me-1"></i>Electryve Wallet</strong>
                            </div>
                            <% if (order.refundedAt) { %>
                                <div class="text-muted mt-1" style="font-size: 0.72rem;">
                                    Processed on <%= new Date(order.refundedAt).toLocaleDateString() %>
                                </div>
                            <% } %>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
/**
 * Prompt for return reason and submit AJAX PATCH request to submit a return request
 */
async function promptReturnOrder(orderId) {
    const { value: reason, isConfirmed } = await Swal.fire({
        title: "Request Return",
        text: "Please provide a reason for returning this delivered order. Your request will be submitted for admin review:",
        input: "textarea",
        inputPlaceholder: "Please provide a reason for returning this order.",
        inputAttributes: {
            "aria-label": "Please provide a reason for returning this order",
            maxlength: 500,
            rows: 3
        },
        showCancelButton: true,
        confirmButtonColor: "#dc3545",
        cancelButtonColor: "#6c757d",
        confirmButtonText: "Submit Return Request",
        cancelButtonText: "Cancel",
        inputValidator: (value) => {
            if (!value || value.trim().length < 3) {
                return "A valid return reason (at least 3 characters) is required!";
            }
        }
    });

    if (!isConfirmed || !reason) return;

    try {
        Swal.fire({
            title: "Submitting Request...",
            text: "Sending your return request for review, please wait.",
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        const res = await fetch(`/order/${orderId}/return`, {
            method: "PATCH",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({ reason: reason.trim() })
        });

        const data = await res.json();

        if (data.success) {
            await Swal.fire({
                icon: "success",
                title: "Return Request Submitted",
                text: data.message || "Your return request has been submitted for review.",
                timer: 2000,
                showConfirmButton: false
            });
            window.location.reload();
        } else {
            Swal.fire({
                icon: "error",
                title: "Request Failed",
                text: data.message || "Could not submit your return request."
            });
        }
    } catch (err) {
        console.error("Return order error:", err);
        Swal.fire({
            icon: "error",
            title: "Network Error",
            text: "Failed to communicate with server. Please try again."
        });
    }
}

/**
 * Prompt for optional cancellation reason and submit AJAX PATCH request to cancel order
 */
async function promptCancelOrder(orderId) {
    const { value: reason, isConfirmed } = await Swal.fire({
        title: "Cancel Order?",
        text: "Are you sure you want to cancel this order? This action cannot be undone.",
        input: "textarea",
        inputPlaceholder: "Reason for cancellation (optional)...",
        inputAttributes: {
            "aria-label": "Reason for cancellation (optional)",
            maxlength: 500,
            rows: 3
        },
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#dc3545",
        cancelButtonColor: "#6c757d",
        confirmButtonText: "Confirm Cancellation",
        cancelButtonText: "Keep Order"
    });

    if (!isConfirmed) return;

    try {
