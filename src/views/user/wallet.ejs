<div class="container-xl py-4" style="max-width: 1400px; margin: 0 auto; width: 100%;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0" style="font-size: 0.85rem;">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-secondary">Home</a></li>
            <li class="breadcrumb-item"><a href="/profile" class="text-decoration-none text-secondary">My Account</a></li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Wallet</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="mb-4">
        <h1 class="fw-bold text-dark mb-1 fs-3">Electryve Wallet</h1>
        <p class="text-secondary small mb-0">Track your store credits, cancellation refunds, and wallet purchases.</p>
    </div>

    <!-- Balance & Stats Cards -->
    <div class="row g-3 mb-4">
        <!-- Main Balance Card -->
        <div class="col-lg-6">
            <div class="card border-0 rounded-4 shadow-sm text-white p-4 h-100" style="background: linear-gradient(135deg, #111827 0%, #1f2937 100%);">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="text-white-50 text-uppercase fw-semibold" style="font-size: 0.72rem; letter-spacing: 0.8px;">Available Balance</span>
                        <div class="display-6 fw-bold mt-1 text-white">
                            ₹<%= Number(balance || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                        </div>
                    </div>
                    <div class="rounded-circle p-2.5 bg-white bg-opacity-10 text-white fs-4 d-inline-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-wallet2"></i>
                    </div>
                </div>
                <div class="mt-auto pt-2 border-top border-secondary border-opacity-25 d-flex align-items-center justify-content-between">
                    <span class="text-white-50 small" style="font-size: 0.78rem;">
                        <i class="bi bi-shield-check me-1 text-success"></i> 100% Secure Store Credit
                    </span>
                    <a href="/shop" class="btn btn-sm btn-light rounded-pill px-3 py-1 fw-semibold text-dark" style="font-size: 0.75rem;">
                        Shop with Wallet
                    </a>
                </div>
            </div>
        </div>

        <!-- Quick Summary Cards -->
        <div class="col-lg-3 col-sm-6">
            <div class="card border-0 rounded-4 shadow-sm p-4 h-100 bg-white">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="rounded-circle p-2 bg-success-subtle text-success fs-5 d-inline-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-arrow-down-left"></i>
                    </div>
                    <div>
                        <span class="text-secondary small d-block" style="font-size: 0.75rem;">Total Refunded</span>
                        <strong class="text-success fs-5 fw-bold">
                            +₹<%= Number(totalRefunded || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                        </strong>
                    </div>
                </div>
                <span class="text-muted small mt-auto" style="font-size: 0.72rem;">Refunds from cancelled/returned orders</span>
            </div>
        </div>

        <div class="col-lg-3 col-sm-6">
            <div class="card border-0 rounded-4 shadow-sm p-4 h-100 bg-white">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="rounded-circle p-2 bg-primary-subtle text-primary fs-5 d-inline-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-arrow-up-right"></i>
                    </div>
                    <div>
                        <span class="text-secondary small d-block" style="font-size: 0.75rem;">Total Spent</span>
                        <strong class="text-dark fs-5 fw-bold">
                            -₹<%= Number(totalSpent || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                        </strong>
                    </div>
                </div>
                <span class="text-muted small mt-auto" style="font-size: 0.72rem;">Payments made via Electryve Wallet</span>
            </div>
        </div>
    </div>

    <!-- Transactions Section -->
    <div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold text-dark mb-0 fs-6">
                    <i class="bi bi-clock-history me-1.5 text-muted"></i> Transaction History
                </h5>
                <span class="text-secondary small" style="font-size: 0.78rem;">
                    Showing <%= transactions.length %> of <%= totalCount %> total transactions
                </span>
            </div>
        </div>

        <% if (!transactions || transactions.length === 0) { %>
            <!-- Empty State -->
            <div class="text-center py-5">
                <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 72px; height: 72px;">
                    <i class="bi bi-wallet2 fs-2 text-secondary opacity-50"></i>
                </div>
                <h6 class="fw-bold text-dark mb-1">No Transactions Yet</h6>
                <p class="text-secondary small mb-3" style="max-width: 380px; margin: 0 auto;">
                    When you cancel or return paid orders, or make purchases using your wallet balance, transactions will appear here.
                </p>
                <a href="/shop" class="btn btn-dark btn-sm rounded-pill px-3 py-2 fw-semibold">
                    Start Shopping
                </a>
            </div>
        <% } else { %>
            <!-- Desktop / Tablet Table -->
            <div class="table-responsive d-none d-md-block">
                <table class="table align-middle mb-0">
                    <thead class="table-light text-secondary text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                        <tr>
                            <th class="border-0 py-2.5">Date & Time</th>
                            <th class="border-0 py-2.5">Type</th>
                            <th class="border-0 py-2.5">Description</th>
                            <th class="border-0 py-2.5">Order</th>
                            <th class="border-0 py-2.5 text-end">Amount</th>
                            <th class="border-0 py-2.5 text-end">Balance After</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0" style="font-size: 0.82rem;">
                        <% transactions.forEach(tx => { %>
                            <tr>
                                <td class="text-secondary py-3">
                                    <%= new Date(tx.createdAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                                    <span class="text-muted d-block" style="font-size: 0.72rem;">
                                        <%= new Date(tx.createdAt).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %>
                                    </span>
                                </td>
                                <td class="py-3">
                                    <% if (tx.type === 'CREDIT') { %>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.68rem;">
                                            <i class="bi bi-plus-lg me-0.5"></i> CREDIT
                                        </span>
                                    <% } else { %>
                                        <span class="badge bg-dark-subtle text-dark border border-dark-subtle rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.68rem;">
                                            <i class="bi bi-dash me-0.5"></i> DEBIT
                                        </span>
                                    <% } %>
                                </td>
                                <td class="py-3 text-dark fw-medium">
                                    <%= tx.description %>
                                </td>
                                <td class="py-3">
                                    <% if (tx.orderId) { %>
                                        <a href="/order/<%= tx.orderId._id || tx.orderId %>" class="text-decoration-none fw-semibold text-dark d-inline-flex align-items-center gap-1">
                                            <span>#<%= tx.orderId.orderNumber || 'Order' %></span>
                                            <i class="bi bi-box-arrow-up-right" style="font-size: 0.7rem;"></i>
                                        </a>
                                    <% } else { %>
                                        <span class="text-muted">—</span>
                                    <% } %>
                                </td>
                                <td class="py-3 text-end fw-bold">
                                    <% if (tx.type === 'CREDIT') { %>
                                        <span class="text-success">+₹<%= Number(tx.amount).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                                    <% } else { %>
                                        <span class="text-dark">-₹<%= Number(tx.amount).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                                    <% } %>
                                </td>
                                <td class="py-3 text-end text-secondary fw-medium">
                                    ₹<%= Number(tx.balanceAfter).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <!-- Mobile View: Transaction Cards -->
            <div class="d-md-none d-flex flex-column gap-2.5">
                <% transactions.forEach(tx => { %>
                    <div class="border rounded-3 p-3 bg-light bg-opacity-50">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <% if (tx.type === 'CREDIT') { %>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5 fw-bold" style="font-size: 0.65rem;">
                                        CREDIT
                                    </span>
                                <% } else { %>
                                    <span class="badge bg-dark-subtle text-dark border border-dark-subtle rounded-pill px-2 py-0.5 fw-bold" style="font-size: 0.65rem;">
                                        DEBIT
                                    </span>
                                <% } %>
                                <div class="text-muted small mt-1" style="font-size: 0.72rem;">
                                    <%= new Date(tx.createdAt).toLocaleString('en-IN', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold fs-6 <%= tx.type === 'CREDIT' ? 'text-success' : 'text-dark' %>">
                                    <%= tx.type === 'CREDIT' ? '+' : '-' %>₹<%= Number(tx.amount).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                </div>
                                <span class="text-muted small" style="font-size: 0.7rem;">
                                    Bal: ₹<%= Number(tx.balanceAfter).toLocaleString('en-IN') %>
                                </span>
                            </div>
                        </div>
                        <div class="text-dark small fw-medium">
                            <%= tx.description %>
                        </div>
                        <% if (tx.orderId) { %>
                            <div class="mt-1.5 pt-1.5 border-top d-flex justify-content-between align-items-center">
                                <span class="text-muted small" style="font-size: 0.72rem;">Related Order:</span>
                                <a href="/order/<%= tx.orderId._id || tx.orderId %>" class="text-decoration-none fw-semibold text-dark small" style="font-size: 0.75rem;">
                                    #<%= tx.orderId.orderNumber || 'View Order' %> <i class="bi bi-chevron-right" style="font-size: 0.65rem;"></i>
                                </a>
                            </div>
                        <% } %>
                    </div>
                <% }) %>
            </div>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
                <div class="d-flex justify-content-center align-items-center gap-2 mt-4 pt-2 border-top">
                    <% if (currentPage > 1) { %>
                        <a href="/wallet?page=<%= currentPage - 1 %>" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                            <i class="bi bi-chevron-left me-1"></i> Previous
                        </a>
                    <% } %>

                    <span class="text-secondary small px-2">
                        Page <strong class="text-dark"><%= currentPage %></strong> of <strong class="text-dark"><%= totalPages %></strong>
                    </span>

                    <% if (currentPage < totalPages) { %>
                        <a href="/wallet?page=<%= currentPage + 1 %>" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                            Next <i class="bi bi-chevron-right ms-1"></i>
                        </a>
                    <% } %>
                </div>
            <% } %>
        <% } %>
    </div>
</div>
