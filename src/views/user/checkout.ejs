function placeOrder() {
    const radio = document.querySelector("input[name='checkoutAddressRadio']:checked");
    if (!radio) {
        Swal.fire({
            icon: 'warning',
            title: 'No Address Selected',
            text: 'Please select a delivery address.'
        });
        return;
    }

    const addressId = radio.value;
    const checkoutAttemptId = document.getElementById("checkoutAttemptId")?.value || "";
    const btn = document.getElementById("btnPlaceCODOrder");
    if (btn) btn.disabled = true;

    fetch("/checkout/place-order", {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify({ addressId, checkoutAttemptId })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            Swal.fire({
                icon: 'success',
                title: 'Order Placed!',
                text: 'Your Cash on Delivery order was placed successfully.',
                timer: 2000,
                showConfirmButton: false
            }).then(() => {
                window.location.href = `/checkout/success?orderNumber=${data.orderNumber}`;
            });
        } else {
            btn.disabled = false;
            Swal.fire({
                icon: 'error',
                title: 'Order Failed',
                text: data.message || "Failed to place your order."
            });
        }
    })
    .catch(err => {
        btn.disabled = false;
        console.error("Place Order Error:", err);
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'An error occurred while placing your order.'
        });
    });
}

let selectedPaymentMethod = "COD";
const userWalletBalance = <%= typeof walletBalance !== 'undefined' ? walletBalance : 0 %>;

function updateWalletEligibility(grandTotal) {
    const walletRadio = document.getElementById("paymentMethodWallet");
    const walletLabel = document.getElementById("walletOptionLabel");
    const walletBadge = document.getElementById("walletBalanceBadge");
    const walletHelp = document.getElementById("walletHelpText");
    if (!walletRadio || !walletLabel) return;

    const canPay = userWalletBalance >= grandTotal;
    walletRadio.disabled = !canPay;

    if (canPay) {
        walletLabel.classList.remove("opacity-75");
        if (walletBadge) {
            walletBadge.className = "badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5";
        }
        if (walletHelp) {
            walletHelp.textContent = "Pay instantly using your available wallet funds.";
        }
    } else {
        walletLabel.classList.add("opacity-75");
        if (walletBadge) {
            walletBadge.className = "badge bg-secondary-subtle text-secondary border rounded-pill px-2 py-0.5";
        }
        if (walletHelp) {
            walletHelp.textContent = "Insufficient balance to pay for this order.";
        }
        if (selectedPaymentMethod === "WALLET") {
            const codRadio = document.getElementById("paymentMethodCOD");
            if (codRadio) {
                codRadio.checked = true;
                handlePaymentMethodChange("COD");
            }
        }
    }
}

function handlePaymentMethodChange(method) {
    selectedPaymentMethod = method;
    const btn = document.getElementById("btnPlaceCODOrder");
    if (!btn) return;
    if (method === "RAZORPAY") {
        btn.textContent = "Pay Securely";
    } else if (method === "WALLET") {
        btn.textContent = "Pay with Wallet";
    } else {
        btn.textContent = "Place Order (Cash on Delivery)";
    }
}

function handleOrderAction() {
    if (selectedPaymentMethod === "RAZORPAY") {
        initiateRazorpayPayment();
    } else if (selectedPaymentMethod === "WALLET") {
        placeWalletOrder();
    } else {
        placeOrder();
    }
}

