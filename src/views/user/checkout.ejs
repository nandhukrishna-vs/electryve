</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
let addressModalInstance = null;
let addressFormSubmitted = false;
const addressFieldTouched = {};

// Field mapping for address modal inputs and feedback containers
const addressFieldMap = {
    fullName: { inputId: "modalFullName", errorId: "fullNameFeedback" },
    phone: { inputId: "modalPhone", errorId: "phoneFeedback" },
    addressLine1: { inputId: "modalAddressLine1", errorId: "addressLine1Feedback" },
    addressLine2: { inputId: "modalAddressLine2", errorId: "addressLine2Feedback" },
    landmark: { inputId: "modalLandmark", errorId: "landmarkFeedback" },
    city: { inputId: "modalCity", errorId: "cityFeedback" },
    state: { inputId: "modalState", errorId: "stateFeedback" },
    pinCode: { inputId: "modalPinCode", errorId: "pinCodeFeedback" },
    pincode: { inputId: "modalPinCode", errorId: "pinCodeFeedback" }
};

// Client-side field validation rules matching backend specifications
const addressFieldValidators = {
    fullName: (value) => {
        const v = (value || "").trim();
        if (!v) return "Full name is required.";
        if (v.length < 3 || v.length > 50) return "Full name must be between 3 and 50 characters.";
        if (!/^[a-zA-Z\s.'-]+$/.test(v)) return "Full name can only contain letters and spaces.";
        return "";
    },
    phone: (value) => {
        const v = (value || "").trim();
        if (!v) return "Phone number is required.";
        if (!/^[0-9]{10}$/.test(v)) return "Phone number must be exactly 10 digits.";
        return "";
    },
    addressLine1: (value) => {
        const v = (value || "").trim();
        if (!v) return "Address Line 1 is required.";
        if (v.length < 5) return "Address Line 1 must be at least 5 characters.";
        if (v.length > 150) return "Address Line 1 cannot exceed 150 characters.";
        return "";
    },
    addressLine2: (value) => {
        const v = (value || "").trim();
        if (v.length > 150) return "Address Line 2 cannot exceed 150 characters.";
        return "";
    },
    landmark: (value) => {
        const v = (value || "").trim();
        if (v.length > 100) return "Landmark cannot exceed 100 characters.";
        return "";
    },
    city: (value) => {
        const v = (value || "").trim();
        if (!v) return "City is required.";
        if (v.length < 2) return "City must be at least 2 characters.";
        if (!/^[a-zA-Z\s.-]+$/.test(v)) return "City can only contain letters and spaces.";
        return "";
    },
    state: (value) => {
        const v = (value || "").trim();
        if (!v) return "State is required.";
        if (v.length < 2) return "State must be at least 2 characters.";
        if (!/^[a-zA-Z\s.-]+$/.test(v)) return "State can only contain letters and spaces.";
        return "";
    },
    pinCode: (value) => {
        const v = (value || "").trim();
        if (!v) return "Pin Code is required.";
        if (!/^[0-9]{6}$/.test(v)) return "Pin Code must be a 6-digit number.";
        return "";
    }
};

function setAddressFieldError(fieldName, errorMessage) {
    const config = addressFieldMap[fieldName];
    if (!config) return;
    const input = document.getElementById(config.inputId);
    const feedback = document.getElementById(config.errorId);
    if (!input || !feedback) return;

    input.classList.add("is-invalid");
    input.classList.remove("is-valid");
    input.setAttribute("aria-invalid", "true");
    feedback.textContent = errorMessage;
    feedback.style.display = "block";
}

function clearAddressFieldError(fieldName) {
    const config = addressFieldMap[fieldName];
    if (!config) return;
    const input = document.getElementById(config.inputId);
    const feedback = document.getElementById(config.errorId);
    if (!input || !feedback) return;

    input.classList.remove("is-invalid");
    input.removeAttribute("aria-invalid");
    feedback.textContent = "";
    feedback.style.display = "";
}

function clearAllAddressErrors() {
    Object.keys(addressFieldMap).forEach(key => {
        clearAddressFieldError(key);
    });
}

function validateSingleAddressField(field) {
    const validator = addressFieldValidators[field];
    const config = addressFieldMap[field];
    if (!validator || !config) return "";
    const input = document.getElementById(config.inputId);
    if (!input) return "";

    const error = validator(input.value);
    if (error) {
        setAddressFieldError(field, error);
    } else {
        clearAddressFieldError(field);
    }
    return error;
}

function initAddressValidationListeners() {
    Object.keys(addressFieldValidators).forEach(field => {
        const config = addressFieldMap[field];
        if (!config) return;
        const input = document.getElementById(config.inputId);
        if (!input) return;

        // Auto-sanitize numeric fields on typing
        if (field === "phone") {
            input.addEventListener("input", () => {
                input.value = input.value.replace(/\D/g, '').slice(0, 10);
            });
        } else if (field === "pinCode") {
            input.addEventListener("input", () => {
                input.value = input.value.replace(/\D/g, '').slice(0, 6);
            });
        }

        // Live blur validation
        input.addEventListener("blur", () => {
            addressFieldTouched[field] = true;
            validateSingleAddressField(field);
        });

        // Live input validation: remove error immediately when user corrects value
        input.addEventListener("input", () => {
            if (input.classList.contains("is-invalid") || addressFormSubmitted || addressFieldTouched[field]) {
                const error = addressFieldValidators[field](input.value);
                if (!error) {
                    clearAddressFieldError(field);
                } else if (addressFormSubmitted || input.classList.contains("is-invalid")) {
                    setAddressFieldError(field, error);
                }
            }
        });
    });
}

document.addEventListener("DOMContentLoaded", () => {
    addressModalInstance = new bootstrap.Modal(document.getElementById('addressModal'));
    initAddressValidationListeners();

    // Form submit listener
    const form = document.getElementById("addressForm");
    form.addEventListener("submit", function(e) {
        e.preventDefault();
        saveAddress();
    });
});

function selectAddressCard(element, addressId) {
    // Unselect other boxes
    document.querySelectorAll(".address-box").forEach(box => {
        box.classList.remove("selected");
    });
    element.classList.add("selected");

    // Check the radio input
    const radio = element.querySelector("input[name='checkoutAddressRadio']");
    if (radio) {
        radio.checked = true;
    }
}

function openAddAddressModal() {
    document.getElementById("addressModalLabel").textContent = "Add Shipping Address";
    document.getElementById("editAddressId").value = "";
    document.getElementById("modalFullName").value = "";
    document.getElementById("modalPhone").value = "";
    document.getElementById("modalAddressLine1").value = "";
    document.getElementById("modalAddressLine2").value = "";
    document.getElementById("modalLandmark").value = "";
    document.getElementById("modalCity").value = "";
    document.getElementById("modalState").value = "";
    document.getElementById("modalPinCode").value = "";
    document.getElementById("modalAddressType").value = "HOME";
    document.getElementById("modalIsDefault").checked = false;

    addressFormSubmitted = false;
    Object.keys(addressFieldTouched).forEach(k => delete addressFieldTouched[k]);
    clearAllAddressErrors();

    const btn = document.getElementById("btnSaveAddress");
    if (btn) {
        btn.disabled = false;
        btn.innerHTML = "Save Address";
    }

    addressModalInstance.show();
}

function openEditAddressModal(addrJson) {
    const addr = typeof addrJson === "string" ? JSON.parse(addrJson) : addrJson;
    document.getElementById("addressModalLabel").textContent = "Edit Shipping Address";
    document.getElementById("editAddressId").value = addr._id;
    document.getElementById("modalFullName").value = addr.fullName || "";
    document.getElementById("modalPhone").value = addr.phone || "";
    document.getElementById("modalAddressLine1").value = addr.addressLine1 || "";
    document.getElementById("modalAddressLine2").value = addr.addressLine2 || "";
    document.getElementById("modalLandmark").value = addr.landmark || "";
    document.getElementById("modalCity").value = addr.city || "";
    document.getElementById("modalState").value = addr.state || "";
    document.getElementById("modalPinCode").value = addr.pinCode || "";
    document.getElementById("modalAddressType").value = addr.addressType || "HOME";
    document.getElementById("modalIsDefault").checked = !!addr.isDefault;

    addressFormSubmitted = false;
    Object.keys(addressFieldTouched).forEach(k => delete addressFieldTouched[k]);
    clearAllAddressErrors();

    const btn = document.getElementById("btnSaveAddress");
    if (btn) {
        btn.disabled = false;
        btn.innerHTML = "Save Address";
    }

    addressModalInstance.show();
}

function saveAddress() {
    addressFormSubmitted = true;
    clearAllAddressErrors();

    // Validate all fields client-side
    let hasError = false;
    let firstInvalidInput = null;

    Object.keys(addressFieldValidators).forEach(field => {
        const config = addressFieldMap[field];
        if (!config) return;
        const input = document.getElementById(config.inputId);
        if (!input) return;

        const error = addressFieldValidators[field](input.value);
        if (error) {
            setAddressFieldError(field, error);
            hasError = true;
            if (!firstInvalidInput) {
                firstInvalidInput = input;
            }
        }
    });

    if (hasError) {
        if (firstInvalidInput) {
            firstInvalidInput.focus();
        }
        return; // Halt: do not send AJAX, do not show SweetAlert popup
    }

    const editId = document.getElementById("editAddressId").value;
    const body = {
        fullName: document.getElementById("modalFullName").value.trim(),
        phone: document.getElementById("modalPhone").value.trim(),
        addressLine1: document.getElementById("modalAddressLine1").value.trim(),
        addressLine2: document.getElementById("modalAddressLine2").value.trim(),
        landmark: document.getElementById("modalLandmark").value.trim(),
        city: document.getElementById("modalCity").value.trim(),
        state: document.getElementById("modalState").value.trim(),
        pinCode: document.getElementById("modalPinCode").value.trim(),
        addressType: document.getElementById("modalAddressType").value,
        isDefault: document.getElementById("modalIsDefault").checked
    };

    const url = editId ? `/checkout/address/${editId}` : "/checkout/address";
    const method = editId ? "PATCH" : "POST";

    const btn = document.getElementById("btnSaveAddress");
    const originalBtnText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Saving...';

    fetch(url, {
        method: method,
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify(body)
    })
    .then(res => res.json())
    .then(data => {
        btn.disabled = false;
        btn.innerHTML = originalBtnText;

        if (data.success) {
            addressModalInstance.hide();
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: data.message || "Address saved successfully.",
                timer: 1500,
                showConfirmButton: false
            }).then(() => {
                location.reload(); // Reload to refresh list and defaults
            });
        } else {
            // Check if server returned field-level errors
            if (data.errors && typeof data.errors === "object" && Object.keys(data.errors).length > 0) {
                let firstServerInvalidInput = null;
                for (const [key, msg] of Object.entries(data.errors)) {
                    setAddressFieldError(key, msg);
                    const config = addressFieldMap[key];
                    if (config && !firstServerInvalidInput) {
                        firstServerInvalidInput = document.getElementById(config.inputId);
                    }
                }
                if (firstServerInvalidInput) {
                    firstServerInvalidInput.focus();
                }
                // NO SweetAlert popup for normal field-level validation errors!
            } else {
                // Non-field / system / server error
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: data.message || "Failed to save address."
                });
            }
        }
    })
    .catch(err => {
        console.error("Save Address Error:", err);
        btn.disabled = false;
        btn.innerHTML = originalBtnText;
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'An error occurred while saving the address.'
        });
    });
}

function setDefaultAddress(addressId) {
    fetch(`/checkout/address/${addressId}/default`, {
        method: "POST"
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: data.message,
                timer: 1000,
                showConfirmButton: false
            }).then(() => {
                location.reload();
            });
        } else {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: data.message || "Failed to update default address."
            });
        }
    })
    .catch(err => {
        console.error("Set Default Address Error:", err);
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'An error occurred while setting default address.'
        });
    });
}

let currentEligibleCoupons = [];
let currentIneligibleCoupons = [];
let activeAppliedCode = '<%= (typeof appliedCoupon !== "undefined" && appliedCoupon) ? appliedCoupon.code : "" %>';

function escapeHtml(str) {
    if (str == null) return '';
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
}

function openCouponModal() {
    const modalEl = document.getElementById('couponModal');
    if (!modalEl) return;
    const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
    bsModal.show();
    loadEligibleCoupons();
}

function loadEligibleCoupons() {
    const loadingEl = document.getElementById('couponModalLoading');
    const errorEl = document.getElementById('couponModalError');
    const contentEl = document.getElementById('couponModalContent');
    const searchInput = document.getElementById('couponSearchInput');

    if (searchInput) searchInput.value = '';
    if (loadingEl) loadingEl.classList.remove('d-none');
    if (errorEl) errorEl.classList.add('d-none');
    if (contentEl) contentEl.classList.add('d-none');

    fetch('/checkout/eligible-coupons')
        .then(res => {
            if (!res.ok) throw new Error('Failed to load eligible coupons');
            return res.json();
        })
        .then(data => {
            if (loadingEl) loadingEl.classList.add('d-none');
            if (data.success) {
                currentEligibleCoupons = Array.isArray(data.eligibleCoupons) ? data.eligibleCoupons : [];
                currentIneligibleCoupons = Array.isArray(data.ineligibleCoupons) ? data.ineligibleCoupons : [];
                if (data.appliedCouponCode) {
                    activeAppliedCode = data.appliedCouponCode;
                }
                renderCouponsList(currentEligibleCoupons, currentIneligibleCoupons, activeAppliedCode);
                if (contentEl) contentEl.classList.remove('d-none');
            } else {
                if (errorEl) {
                    document.getElementById('couponModalErrorText').textContent = data.message || 'Unable to load coupons.';
                    errorEl.classList.remove('d-none');
                }
            }
        })
        .catch(err => {
            console.error('Eligible coupons load error:', err);
            if (loadingEl) loadingEl.classList.add('d-none');
            if (errorEl) {
                document.getElementById('couponModalErrorText').textContent = 'An error occurred while loading coupons. Please try again.';
                errorEl.classList.remove('d-none');
            }
        });
}

function renderCouponsList(eligible, ineligible, appliedCode) {
    const eligibleCountEl = document.getElementById('eligibleCouponsCount');
    const eligibleSection = document.getElementById('eligibleCouponsSection');
    const eligibleListEl = document.getElementById('eligibleCouponsList');
    const ineligibleSection = document.getElementById('ineligibleCouponsSection');
    const ineligibleListEl = document.getElementById('ineligibleCouponsList');
    const emptyEl = document.getElementById('couponModalEmpty');

    const totalCoupons = eligible.length + ineligible.length;
    if (totalCoupons === 0) {
        if (eligibleSection) eligibleSection.classList.add('d-none');
        if (ineligibleSection) ineligibleSection.classList.add('d-none');
        if (emptyEl) emptyEl.classList.remove('d-none');
        return;
    }

    if (emptyEl) emptyEl.classList.add('d-none');

    // Render Eligible Section
    if (eligible.length > 0) {
        if (eligibleSection) eligibleSection.classList.remove('d-none');
        if (eligibleCountEl) eligibleCountEl.textContent = `${eligible.length} available`;

        let html = '';
        eligible.forEach(c => {
            const isApplied = appliedCode && (c.code.toUpperCase() === appliedCode.toUpperCase());
            const discountText = c.discountType === 'PERCENTAGE'
                ? `${c.discountValue}% OFF${c.maxDiscountAmount ? ` (Up to ₹${c.maxDiscountAmount.toLocaleString('en-IN')})` : ''}`
                : `₹${c.discountValue.toLocaleString('en-IN')} OFF`;
            const validDate = c.validTo ? new Date(c.validTo).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '';

            html += `
                <div class="card border rounded-3 p-3 ${isApplied ? 'border-success bg-success bg-opacity-10' : 'bg-white shadow-sm'}">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge bg-dark font-monospace text-uppercase px-2.5 py-1.5" style="letter-spacing: 0.5px;">${escapeHtml(c.code)}</span>
                                <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold rounded-pill px-2 py-0.5" style="font-size: 0.72rem;">Save ₹${Number(c.projectedDiscount || 0).toLocaleString('en-IN')}</span>
                            </div>
                            <h6 class="fw-bold text-dark small mb-1">${escapeHtml(discountText)}</h6>
                            ${c.description ? `<p class="text-secondary small mb-1" style="font-size: 0.78rem;">${escapeHtml(c.description)}</p>` : ''}
                            <div class="d-flex flex-wrap align-items-center gap-2 text-muted" style="font-size: 0.72rem;">
                                ${c.minimumPurchaseAmount > 0 ? `<span>Min Order: ₹${c.minimumPurchaseAmount.toLocaleString('en-IN')}</span>` : '<span>No min order</span>'}
                                ${validDate ? `<span>•</span><span>Valid till ${validDate}</span>` : ''}
                            </div>
                        </div>
                        <div class="flex-shrink-0 ms-2">
                            ${isApplied ? `
                                <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold" disabled>
                                    <i class="bi bi-check2 me-1"></i>Applied
                                </button>
                            ` : `
                                <button type="button" class="btn btn-sm btn-dark rounded-pill px-3 fw-bold" onclick="applyCouponFromModal('${escapeHtml(c.code)}', this)">
                                    Apply
                                </button>
                            `}
                        </div>
                    </div>
                </div>
            `;
        });
        if (eligibleListEl) eligibleListEl.innerHTML = html;
    } else {
        if (eligibleSection) eligibleSection.classList.add('d-none');
        if (eligibleCountEl) eligibleCountEl.textContent = '0 available';
    }

    // Render Ineligible Section
    if (ineligible.length > 0) {
        if (ineligibleSection) ineligibleSection.classList.remove('d-none');

        let inHtml = '';
        ineligible.forEach(c => {
            const discountText = c.discountType === 'PERCENTAGE'
                ? `${c.discountValue}% OFF${c.maxDiscountAmount ? ` (Up to ₹${c.maxDiscountAmount.toLocaleString('en-IN')})` : ''}`
                : `₹${c.discountValue.toLocaleString('en-IN')} OFF`;
            const reason = c.ineligibleReason || 'Requirements not met';

            inHtml += `
                <div class="card border rounded-3 p-3 bg-light opacity-75">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge bg-secondary font-monospace text-uppercase px-2.5 py-1.5" style="letter-spacing: 0.5px;">${escapeHtml(c.code)}</span>
                                <span class="text-secondary small fw-medium" style="font-size: 0.75rem;">${escapeHtml(discountText)}</span>
                            </div>
                            ${c.description ? `<p class="text-secondary small mb-1" style="font-size: 0.78rem;">${escapeHtml(c.description)}</p>` : ''}
                            <div class="text-danger small fw-semibold d-flex align-items-center gap-1 mt-1" style="font-size: 0.75rem;">
                                <i class="bi bi-info-circle"></i>
                                <span>${escapeHtml(reason)}</span>
                            </div>
                        </div>
                        <div class="flex-shrink-0 ms-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold" disabled>
                                Apply
                            </button>
                        </div>
                    </div>
                </div>
            `;
        });
        if (ineligibleListEl) ineligibleListEl.innerHTML = inHtml;
    } else {
        if (ineligibleSection) ineligibleSection.classList.add('d-none');
    }
}

function filterCouponsList() {
    const q = (document.getElementById('couponSearchInput')?.value || '').trim().toUpperCase();
    if (!q) {
        renderCouponsList(currentEligibleCoupons, currentIneligibleCoupons, activeAppliedCode);
        return;
    }

    const filteredEligible = currentEligibleCoupons.filter(c => {
        const codeMatch = (c.code || '').toUpperCase().includes(q);
        const descMatch = (c.description || '').toUpperCase().includes(q);
        return codeMatch || descMatch;
    });

    const filteredIneligible = currentIneligibleCoupons.filter(c => {
        const codeMatch = (c.code || '').toUpperCase().includes(q);
        const descMatch = (c.description || '').toUpperCase().includes(q);
        return codeMatch || descMatch;
    });

    renderCouponsList(filteredEligible, filteredIneligible, activeAppliedCode);
}

function applyCouponFromModal(couponCode, btn) {
    executeCouponApplication(couponCode, btn, true);
}

function applyManualCoupon() {
    const input = document.getElementById("couponCodeInput");
    const couponCode = (input ? input.value : "").trim().toUpperCase();

    if (!couponCode) {
        Swal.fire({
            icon: 'warning',
            title: 'Coupon Code Required',
            text: 'Please enter a coupon code.'
        });
        return;
    }

    const btn = document.getElementById("btnApplyManualCoupon") || document.getElementById("btnApplyCoupon");
    executeCouponApplication(couponCode, btn, false);
}

// Backward-compatibility alias
function applyCoupon() {
    applyManualCoupon();
}

function executeCouponApplication(couponCode, btn, fromModal) {
    let originalText = '';
    if (btn) {
        btn.disabled = true;
        originalText = btn.innerHTML;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Applying...';
    }

    fetch("/checkout/apply-coupon", {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify({ couponCode })
    })
    .then(res => res.json())
    .then(data => {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = originalText;
        }

        if (data.success) {
            activeAppliedCode = data.couponCode;

            // Update UI State: trigger card vs applied badge
            const trigger = document.getElementById("couponTriggerWrapper");
            if (trigger) trigger.style.setProperty("display", "none", "important");

            const badge = document.getElementById("appliedCouponBadge");
            if (badge) badge.style.setProperty("display", "block", "important");

            const codeEl = document.getElementById("appliedCouponCode");
            if (codeEl) codeEl.textContent = data.couponCode;

            const savingsEl = document.getElementById("appliedCouponSavings");
            if (savingsEl) savingsEl.textContent = `You saved ₹${Number(data.discountAmount || 0).toLocaleString('en-IN')}`;

            // Reset manual input
            const input = document.getElementById("couponCodeInput");
            if (input) input.value = "";

            // Update Price Details
            const discountRow = document.getElementById("couponDiscountRow");
            if (discountRow) discountRow.className = "d-flex justify-content-between text-success fw-medium";

            const codeWrap = document.getElementById("summaryCouponCodeWrapper");
            if (codeWrap) codeWrap.style.display = "inline";

            const sumCode = document.getElementById("summaryCouponCode");
            if (sumCode) sumCode.textContent = data.couponCode;

            const sumDisc = document.getElementById("summaryCouponDiscount");
            if (sumDisc) sumDisc.textContent = `-₹${Number(data.discountAmount || 0).toLocaleString('en-IN')}`;

            const sumGrand = document.getElementById("summaryGrandTotal");
            if (sumGrand) sumGrand.textContent = `₹${Number(data.finalAmount || 0).toLocaleString('en-IN')}`;

            // Dynamically recalculate Wallet eligibility
            updateWalletEligibility(data.finalAmount);

            // Close modal if applied from modal
            if (fromModal) {
                const modalEl = document.getElementById('couponModal');
                if (modalEl) {
                    const inst = bootstrap.Modal.getInstance(modalEl);
                    if (inst) inst.hide();
                }
            }

            Swal.fire({
                icon: 'success',
                title: 'Coupon Applied!',
                text: data.message || `Coupon "${data.couponCode}" applied successfully!`,
                timer: 1500,
                showConfirmButton: false
            });
        } else {
            Swal.fire({
                icon: 'error',
                title: 'Cannot Apply Coupon',
                text: data.message || 'Failed to apply coupon.'
            });
        }
    })
    .catch(err => {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = originalText;
        }
        console.error("Apply Coupon Error:", err);
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'An error occurred while applying the coupon.'
        });
    });
}

function removeCoupon() {
    const btn = document.getElementById("btnRemoveCoupon");
    let originalText = '';
    if (btn) {
        btn.disabled = true;
        originalText = btn.innerHTML;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Removing...';
    }

    fetch("/checkout/remove-coupon", {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        }
    })
    .then(res => res.json())
    .then(data => {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = originalText || "Remove";
        }
        if (data.success) {
            activeAppliedCode = null;

            // Reset UI state
            const input = document.getElementById("couponCodeInput");
            if (input) input.value = "";

            const trigger = document.getElementById("couponTriggerWrapper");
            if (trigger) trigger.style.setProperty("display", "block", "important");

            const badge = document.getElementById("appliedCouponBadge");
            if (badge) badge.style.setProperty("display", "none", "important");

            // Reset Price Details to ₹0
            const discountRow = document.getElementById("couponDiscountRow");
            if (discountRow) discountRow.className = "d-flex justify-content-between text-secondary";

            const codeWrap = document.getElementById("summaryCouponCodeWrapper");
            if (codeWrap) codeWrap.style.display = "none";

            const sumDisc = document.getElementById("summaryCouponDiscount");
            if (sumDisc) sumDisc.textContent = "₹0";

            const sumGrand = document.getElementById("summaryGrandTotal");
            if (sumGrand) sumGrand.textContent = `₹${Number(data.finalAmount || 0).toLocaleString('en-IN')}`;

            // Recalculate Wallet eligibility with restored amount
            updateWalletEligibility(data.finalAmount);

            Swal.fire({
                icon: 'info',
                title: 'Coupon Removed',
                text: data.message || 'Coupon has been removed.',
                timer: 1200,
                showConfirmButton: false
            });
        } else {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: data.message || 'Failed to remove coupon.'
            });
        }
    })
    .catch(err => {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = originalText || "Remove";
        }
        console.error("Remove Coupon Error:", err);
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'An error occurred while removing the coupon.'
        });
    });
}

function placeOrder() {
    const radio = document.querySelector("input[name='checkoutAddressRadio']:checked");
    if (!radio) {
        Swal.fire({
            icon: 'warning',
            title: 'No Address Selected',
            text: 'Please select a delivery address.'
        });
        return;
    }

    const addressId = radio.value;
    const checkoutAttemptId = document.getElementById("checkoutAttemptId")?.value || "";
    const btn = document.getElementById("btnPlaceCODOrder");
    if (btn) btn.disabled = true;

    fetch("/checkout/place-order", {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify({ addressId, checkoutAttemptId })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            Swal.fire({
                icon: 'success',
                title: 'Order Placed!',
                text: 'Your Cash on Delivery order was placed successfully.',
                timer: 2000,
                showConfirmButton: false
            }).then(() => {
                window.location.href = `/checkout/success?orderNumber=${data.orderNumber}`;
            });
        } else {
            btn.disabled = false;
            Swal.fire({
                icon: 'error',
                title: 'Order Failed',
                text: data.message || "Failed to place your order."
            });
        }
    })
    .catch(err => {
        btn.disabled = false;
        console.error("Place Order Error:", err);
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'An error occurred while placing your order.'
        });
    });
}

let selectedPaymentMethod = "COD";
const userWalletBalance = <%= typeof walletBalance !== 'undefined' ? walletBalance : 0 %>;

function updateWalletEligibility(grandTotal) {
    const walletRadio = document.getElementById("paymentMethodWallet");
    const walletLabel = document.getElementById("walletOptionLabel");
    const walletBadge = document.getElementById("walletBalanceBadge");
    const walletHelp = document.getElementById("walletHelpText");
    if (!walletRadio || !walletLabel) return;

    const canPay = userWalletBalance >= grandTotal;
    walletRadio.disabled = !canPay;

    if (canPay) {
        walletLabel.classList.remove("opacity-75");
        if (walletBadge) {
            walletBadge.className = "badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5";
        }
        if (walletHelp) {
            walletHelp.textContent = "Pay instantly using your available wallet funds.";
        }
    } else {
        walletLabel.classList.add("opacity-75");
        if (walletBadge) {
            walletBadge.className = "badge bg-secondary-subtle text-secondary border rounded-pill px-2 py-0.5";
        }
        if (walletHelp) {
            walletHelp.textContent = "Insufficient balance to pay for this order.";
        }
        if (selectedPaymentMethod === "WALLET") {
            const codRadio = document.getElementById("paymentMethodCOD");
            if (codRadio) {
                codRadio.checked = true;
                handlePaymentMethodChange("COD");
            }
        }
    }
}

function handlePaymentMethodChange(method) {
    selectedPaymentMethod = method;
    const btn = document.getElementById("btnPlaceCODOrder");
    if (!btn) return;
    if (method === "RAZORPAY") {
        btn.textContent = "Pay Securely";
    } else if (method === "WALLET") {
        btn.textContent = "Pay with Wallet";
    } else {
        btn.textContent = "Place Order (Cash on Delivery)";
    }
}

function handleOrderAction() {
    if (selectedPaymentMethod === "RAZORPAY") {
        initiateRazorpayPayment();
    } else if (selectedPaymentMethod === "WALLET") {
        placeWalletOrder();
    } else {
        placeOrder();
    }
}

