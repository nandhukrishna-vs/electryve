function initiateRazorpayPayment() {
    const radio = document.querySelector("input[name='checkoutAddressRadio']:checked");
    if (!radio) {
        Swal.fire({
            icon: 'warning',
            title: 'No Address Selected',
            text: 'Please select a delivery address.'
        });
        return;
    }

    const addressId = radio.value;
    const checkoutAttemptId = document.getElementById("checkoutAttemptId")?.value || "";
    const btn = document.getElementById("btnPlaceCODOrder");
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Initiating Payment...';
    }

    fetch("/payment/create-order", {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify({ addressId, checkoutAttemptId })
    })
    .then(res => res.json())
    .then(data => {
        if (!data.success) {
            if (btn) {
                btn.disabled = false;
                btn.textContent = "Pay Securely";
            }
            Swal.fire({
                icon: 'error',
                title: 'Checkout Error',
                text: data.message || "Failed to initialize payment."
            });
            return;
        }

        if (data.isAlreadyFinalized && data.orderNumber) {
            window.location.href = `/checkout/success?orderNumber=${data.orderNumber}`;
            return;
        }

        const options = {
            key: data.keyId,
            amount: data.amount,
            currency: data.currency || "INR",
            name: "Electryve",
            description: "Order Payment",
            order_id: data.orderId,
            prefill: data.prefill || {},
            theme: {
                color: "#111827"
            },
            handler: function (response) {
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Verifying Payment...';
                }

                fetch("/payment/verify", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        razorpay_order_id: response.razorpay_order_id,
                        razorpay_payment_id: response.razorpay_payment_id,
                        razorpay_signature: response.razorpay_signature,
                        checkoutAttemptId
                    })
                })
                .then(res => res.json())
                .then(verifyData => {
                    if (verifyData.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Payment Successful!',
                            text: 'Your payment was verified and your order has been placed.',
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.href = `/checkout/success?orderNumber=${verifyData.orderNumber}`;
                        });
                    } else if (verifyData.status === "FULFILLMENT_BLOCKED") {
                        window.location.href = `/payment/failure?orderId=${encodeURIComponent(response.razorpay_order_id)}&attemptId=${encodeURIComponent(checkoutAttemptId)}`;
                    } else {
                        if (btn) {
                            btn.disabled = false;
                            btn.textContent = "Pay Securely";
                        }
                        Swal.fire({
                            icon: 'error',
                            title: 'Payment Verification Failed',
                            text: verifyData.message || "Payment could not be verified."
                        });
                    }
                })
                .catch(err => {
                    if (btn) {
                        btn.disabled = false;
                        btn.textContent = "Pay Securely";
                    }
                    console.error("Verification Error:", err);
                    Swal.fire({
                        icon: 'error',
                        title: 'Verification Error',
                        text: 'An error occurred while verifying your payment.'
                    });
                });
            },
            modal: {
                ondismiss: function () {
                    if (btn) {
                        btn.disabled = false;
                        btn.textContent = "Pay Securely";
                    }
                    fetch("/payment/failure", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            razorpay_order_id: data.orderId,
                            failureReason: "Payment cancelled by user"
                        })
                    }).catch(() => {});
                }
            }
        };

        const rzp = new window.Razorpay(options);
        rzp.on("payment.failed", function (failResponse) {
            if (btn) {
                btn.disabled = false;
                btn.textContent = "Pay Securely";
            }
            fetch("/payment/failure", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    razorpay_order_id: data.orderId,
                    failureReason: failResponse.error?.description || "Payment failed at gateway"
                })
            }).catch(() => {});

            window.location.href = `/payment/failure?orderId=${encodeURIComponent(data.orderId)}&attemptId=${encodeURIComponent(checkoutAttemptId)}`;
        });
        rzp.open();
    })
    .catch(err => {
        if (btn) {
            btn.disabled = false;
            btn.textContent = "Pay Securely";
        }
        console.error("Initiate Payment Error:", err);
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'An unexpected error occurred while setting up your payment.'
        });
    });
}
</script>
