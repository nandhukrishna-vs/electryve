<style>
    .cart-section-wrapper {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background-color: #f8f9fa;
        min-height: 80vh;
    }
    .cart-grid-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) minmax(320px, 0.8fr);
        gap: 24px;
        align-items: start;
    }
    .cart-item-modern-card {
        background-color: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .cart-item-modern-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
    }
    .cart-image-wrapper {
        width: 100px;
        height: 100px;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        background-color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }
    .cart-image-wrapper img {
        max-width: 90%;
        max-height: 90%;
        object-fit: contain;
    }
    .btn-qty-action {
        width: 32px;
        height: 32px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.15s, color 0.15s;
    }
    .btn-qty-action:hover:not(:disabled) {
        background-color: #f3f4f6;
        color: #111827;
    }
    .btn-qty-input {
        width: 42px !important;
        height: 32px;
        font-size: 0.9rem;
        font-weight: 600;
        text-align: center;
        padding: 0;
    }
    .badge-discount-percent {
        font-size: 0.72rem;
        background-color: #fee2e2;
        color: #dc3545;
        border: 1px solid #fecaca;
        border-radius: 6px;
        padding: 3px 6px;
    }
    .sticky-summary {
        position: sticky;
        top: 24px;
    }

    @media (max-width: 991px) {
        .cart-grid-layout {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 768px) {
        .cart-item-card-row {
            flex-direction: column;
            text-align: center;
        }
        .cart-image-wrapper {
            margin: 0 auto;
        }
        .cart-item-actions-row {
            flex-direction: column;
            align-items: center !important;
            gap: 12px;
            width: 100%;
        }
        .qty-controls-wrapper {
            justify-content: center !important;
        }
    }
</style>

<div class="cart-section-wrapper py-5">
    <div class="container-xl" id="pdpCartMainContainer" style="max-width: 1400px; margin: 0 auto; width: 100%;">

        <!-- Page Header -->
        <div class="mb-4">
            <h1 class="fw-bold text-dark mb-1">Shopping Cart</h1>
            <p class="text-secondary small">Review items, adjust quantities, and checkout securely.</p>
        </div>

        <!-- Warning Price Alerts -->
        <% if (priceChanges && priceChanges.length > 0) { %>
            <div class="alert alert-warning alert-dismissible fade show rounded-3 mb-4 shadow-sm border-warning-subtle" role="alert">
                <div class="d-flex align-items-center mb-1">
                    <i class="bi bi-exclamation-triangle-fill text-warning fs-5 me-2"></i>
                    <strong class="text-dark">Cart Price / Quantity Alerts</strong>
                </div>
                <ul class="mb-0 small text-secondary ps-3">
                    <% priceChanges.forEach(msg => { %>
                        <li><%= msg %></li>
                    <% }) %>
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <% if (items && items.length > 0) { %>
            <!-- 2-column layout -->
            <div class="cart-grid-layout" id="pdpCartItemsRow">
                
                <!-- Left Grid: Cart items list -->
                <div class="d-flex flex-column gap-3">
                    <% items.forEach(item => { %>
                        <div class="card cart-item-modern-card p-3 shadow-sm border-light-subtle" id="cart-row-<%= item.product._id %>-<%= item.variantId %>">
                            <div class="d-flex align-items-center gap-3.5 cart-item-card-row">
                                
                                <!-- Image -->
                                <div class="flex-shrink-0">
                                    <div class="cart-image-wrapper shadow-sm">
                                        <img src="<%= item.imageSnapshot %>" alt="<%= item.nameSnapshot %>">
                                    </div>
                                </div>

                                <!-- Detail info -->
                                <div class="flex-grow-1 min-w-0 text-start">
                                    <% if (item.product?.brand) { %>
                                        <span class="text-uppercase text-muted fw-bold d-block mb-0.5" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                            <%= item.product.brand.name %>
                                        </span>
                                    <% } %>
                                    
                                    <h5 class="fw-bold text-dark mb-1 text-truncate" style="font-size: 1.05rem;" title="<%= item.nameSnapshot %>">
                                        <%= item.nameSnapshot %>
                                    </h5>

                                    <div class="text-secondary small mb-2">
                                        <%= item.variantSnapshot %>
                                    </div>

                                    <div>
                                        <% if (item.isUnavailable) { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1 small">
                                                ⚠️ Unavailable
                                            </span>
                                        <% } else if (item.isOutOfStock) { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1 small">
                                                🔴 Out of Stock
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 small">
                                                🟢 In Stock
                                            </span>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Pricing, Quantity and Actions -->
                                <div class="cart-item-actions-row d-flex flex-column align-items-end justify-content-between gap-3 text-end flex-shrink-0">
                                    
                                    <!-- Pricing -->
                                    <div>
                                        <% if (!item.isUnavailable && !item.isOutOfStock) { %>
                                            <div class="d-flex align-items-baseline gap-1.5 justify-content-end flex-wrap">
                                                <span class="fw-bold text-dark fs-5">
                                                    ₹<%= item.priceSnapshot.toLocaleString() %>
                                                </span>
                                                <% if (item.regularPrice && item.regularPrice > item.priceSnapshot) { %>
                                                    <span class="text-muted text-decoration-line-through small" style="font-size: 0.8rem;">
                                                        ₹<%= item.regularPrice.toLocaleString() %>
                                                    </span>
                                                    <span class="badge-discount-percent fw-semibold">
                                                        <%= item.discountPercentage %>% OFF
                                                    </span>
                                                <% } %>
                                            </div>
                                            <div class="text-secondary small mt-0.5">
                                                Total: <strong class="text-dark">₹<span id="pdp-item-subtotal-<%= item.product._id %>-<%= item.variantId %>"><%= (item.quantity * item.priceSnapshot).toLocaleString() %></span></strong>
                                            </div>
                                        <% } else { %>
                                            <div class="text-danger small fw-semibold">
                                                <%= item.isUnavailable ? 'This product is no longer available.' : 'Currently unavailable.' %>
                                            </div>
                                        <% } %>
                                    </div>

                                    <!-- Quantity Controls & Trash -->
                                    <div class="d-flex align-items-center gap-2.5 qty-controls-wrapper w-100 justify-content-end">
                                        <% if (!item.isUnavailable && !item.isOutOfStock) { %>
                                            <div class="d-flex align-items-center rounded-3 overflow-hidden border" style="height: 32px; width: fit-content;">
                                                <button 
                                                    class="btn btn-qty-action border-0" 
                                                    type="button" 
                                                    id="pdp-minus-<%= item.product._id %>-<%= item.variantId %>"
                                                    onclick="adjustCartQtyAjax('<%= item.product._id %>', '<%= item.variantId %>', -1)"
                                                    <%= item.quantity <= 1 ? 'disabled' : '' %>
                                                >
                                                    <i class="bi bi-minus"></i>
                                                </button>
                                                <input 
                                                    type="text" 
                                                    id="pdp-qty-<%= item.product._id %>-<%= item.variantId %>"
                                                    value="<%= item.quantity %>" 
                                                    class="btn-qty-input border-0 bg-white" 
                                                    readonly
                                                >
                                                <button 
                                                    class="btn btn-qty-action border-0" 
                                                    type="button" 
                                                    id="pdp-plus-<%= item.product._id %>-<%= item.variantId %>"
                                                    onclick="adjustCartQtyAjax('<%= item.product._id %>', '<%= item.variantId %>', 1)"
                                                    <%= item.quantity >= 5 ? 'disabled' : '' %>
                                                >
                                                    <i class="bi bi-plus"></i>
                                                </button>
                                            </div>
                                        <% } %>

                                        <button 
                                            class="btn btn-outline-danger btn-sm border-0 rounded-circle d-flex align-items-center justify-content-center" 
                                            style="width: 32px; height: 32px;"
                                            type="button"
                                            title="Remove Item"
                                            onclick="confirmRemoveCartItem('<%= item.product._id %>', '<%= item.variantId %>')"
                                        >
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <!-- Right Grid: Price Summary stickies -->
                <div class="sticky-summary d-flex flex-column gap-4">
                    
                    <!-- Coupon Information Card -->
                    <div class="card border-light-subtle shadow-sm p-4 rounded-4 bg-white">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-tag-fill text-dark fs-5"></i>
                            <h6 class="fw-bold text-dark mb-0">Have a Coupon?</h6>
                        </div>
                        <p class="text-secondary small mb-3">
                            You can apply discount coupons directly at checkout on the final order review step.
                        </p>
                        <a href="/checkout" class="btn btn-outline-dark btn-sm rounded-3 fw-semibold w-100 py-2 d-flex align-items-center justify-content-center gap-2">
                            <span>Proceed to Apply at Checkout</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>

                    <!-- Sticky Summary Card -->
                    <div class="card border-light-subtle shadow-sm p-4 rounded-4 bg-white">
                        <h5 class="fw-bold text-dark mb-3.5">Price Details</h5>
                        
                        <div class="d-flex flex-column gap-3 mb-4" style="font-size: 0.9rem;">
                            
                            <div class="d-flex justify-content-between text-secondary">
                                <span>Total Items</span>
                                <% 
                                const totalItemsCount = items.reduce((acc, it) => acc + (it.isUnavailable || it.isOutOfStock ? 0 : it.quantity), 0);
                                %>
                                <span class="fw-bold text-dark" id="summaryTotalItems"><%= totalItemsCount %> Items</span>
                            </div>

                            <div class="d-flex justify-content-between text-secondary">
                                <span>Subtotal</span>
                                <span class="fw-bold text-dark">₹<span id="summarySubtotal"><%= cartSummary.subtotal.toLocaleString() %></span></span>
                            </div>

                            <div class="d-flex justify-content-between text-secondary">
                                <span>Discount Savings</span>
                                <span class="fw-bold text-success">-₹<span id="summaryDiscount"><%= cartSummary.discount.toLocaleString() %></span></span>
                            </div>

                            <div class="d-flex justify-content-between text-secondary">
                                <span>Shipping Delivery</span>
                                <span class="fw-bold text-dark" id="summaryShipping">
                                    <%= cartSummary.shipping === 0 ? 'FREE' : '₹' + cartSummary.shipping.toLocaleString() %>
                                </span>
                            </div>

                            <% if (cartSummary.discount > 0) { %>
                                <div class="alert alert-success border-0 px-3 py-2 d-flex align-items-center gap-2 mb-0" style="font-size: 0.8rem;" id="summarySavingsAlert">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span>You will save <strong>₹<span id="summaryTotalSavings"><%= cartSummary.discount.toLocaleString() %></span></strong> on this order.</span>
                                </div>
                            <% } else { %>
                                <div class="alert alert-success border-0 px-3 py-2 d-flex align-items-center gap-2 mb-0" style="font-size: 0.8rem; display: none;" id="summarySavingsAlert">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span>You will save <strong>₹<span id="summaryTotalSavings">0</span></strong> on this order.</span>
                                </div>
                            <% } %>

                            <hr class="my-2 text-muted opacity-25">

                            <div class="d-flex justify-content-between text-secondary fs-5 align-items-center">
                                <span class="fw-bold text-dark">Total Amount</span>
                                <span class="fw-bold text-dark">₹<span id="summaryGrandTotal"><%= cartSummary.grandTotal.toLocaleString() %></span></span>
                            </div>

                        </div>

                        <!-- Checkout Trigger Button -->
                        <button 
                            type="button" 
                            id="checkoutBtn"
                            class="btn btn-dark w-100 rounded-3 py-2.5 fw-bold shadow-sm mb-2"
                            <%= canCheckout ? '' : 'disabled' %>
                            onclick="proceedToCheckout()"
                        >
                            Proceed to Checkout
                        </button>
                        
                        <div 
                            class="text-danger small text-center mt-2" 
                            id="checkoutWarning" 
                            style="<%= canCheckout ? 'display: none;' : 'display: block;' %>"
                        >
                            <i class="bi bi-exclamation-circle me-1"></i>
                            Remove unavailable or out-of-stock items to proceed.
                        </div>

                    </div>
                </div>
            </div>
        <% } else { %>
            <!-- Empty cart layout block -->
            <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-4 bg-white mt-4 mx-auto" style="max-width: 600px;">
                <div class="text-muted mb-3.5">
                    <span class="display-1 text-secondary opacity-50"><i class="bi bi-cart-x"></i></span>
                </div>
                <h3 class="fw-bold text-dark mb-2">Your cart is empty.</h3>
                <p class="text-secondary small mb-4">Add products to your cart to explore items and checkout.</p>
                <div class="d-flex justify-content-center">
                    <a href="/shop" class="btn btn-dark rounded-3 px-4.5 py-2.5 fw-bold shadow-sm">
                        Continue Shopping
                    </a>
                </div>
            </div>
        <% } %>
    </div>
</div>

<script>
/**
 * AJAX adjust cart quantity handler
 */
async function adjustCartQtyAjax(productId, variantId, change) {
    const qtyInput = document.getElementById(`pdp-qty-${productId}-${variantId}`);
    const minusBtn = document.getElementById(`pdp-minus-${productId}-${variantId}`);
    const plusBtn = document.getElementById(`pdp-plus-${productId}-${variantId}`);

    if (!qtyInput) return;

    const currentVal = parseInt(qtyInput.value, 10) || 0;
    const newVal = currentVal + change;

    // Client-side bounds safety checks
    if (newVal < 1 || newVal > 5) return;

    // Temporarily disable buttons
    if (minusBtn) minusBtn.disabled = true;
    if (plusBtn) plusBtn.disabled = true;

    try {
        const response = await fetch('/cart/update-qty', {
            method: 'PATCH',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                productId,
                variantId,
                quantity: newVal
            })
        });

        if (response.status === 401) {
            Swal.fire({
                title: 'Log In Required',
                text: 'Please log in to manage your cart.',
                icon: 'info',
                confirmButtonColor: '#111827'
            }).then(() => {
                window.location.href = "/auth/login";
            });
            return;
        }

        let data;
        try {
            data = await response.json();
        } catch (e) {
            throw new Error(`Server returned status ${response.status}: Unable to parse response.`);
        }
        if (!response.ok || !data.success) {
            throw new Error(data.message || "Failed to update quantity.");
        }

        // Update input value
        qtyInput.value = newVal;

        // Update item subtotal
        const itemSubtotal = document.getElementById(`pdp-item-subtotal-${productId}-${variantId}`);
        if (itemSubtotal) {
            itemSubtotal.textContent = data.itemTotal.toLocaleString();
        }

        // Update summary fields
        updateCartSummary(data.cartSummary, data.count);

        // Toast Alert
        if (window.showSuccess) {
            window.showSuccess('Quantity updated successfully!');
        } else {
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: 'Quantity updated successfully!',
                confirmButtonColor: '#111827'
            });
        }

        // Update navbar count badge
        if (typeof refreshNavbarCartCount === "function") {
            refreshNavbarCartCount();
        }
    } catch (error) {
        console.error("Quantity adjust cart AJAX error:", error);
        Swal.fire({
            title: 'Error',
            text: error.message || 'An error occurred while updating quantity.',
            icon: 'error',
            confirmButtonColor: '#111827'
        });
    } finally {
        setTimeout(() => {
            const inputVal = parseInt(qtyInput.value, 10);
            if (minusBtn) minusBtn.disabled = (inputVal <= 1);
            if (plusBtn) plusBtn.disabled = (inputVal >= 5);
        }, 100);
    }
}

/**
 * SweetAlert2 confirmation modal before removing item
 */
function confirmRemoveCartItem(productId, variantId) {
    Swal.fire({
        title: 'Remove Item?',
        text: "Are you sure you want to remove this item from your cart?",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Remove'
    }).then((result) => {
        if (result.isConfirmed) {
            removeCartItemAjax(productId, variantId);
        }
    });
}

/**
 * AJAX remove item from cart
 */
async function removeCartItemAjax(productId, variantId) {
    try {
        const response = await fetch('/cart/remove', {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                productId,
                variantId
            })
        });

        if (response.status === 401) {
            window.location.href = "/auth/login";
            return;
        }

        let data;
        try {
            data = await response.json();
        } catch (e) {
            throw new Error(`Server returned status ${response.status}: Unable to parse response.`);
        }
        if (!response.ok || !data.success) {
            throw new Error(data.message || "Failed to remove item.");
        }

        // Remove the product card element from the DOM
        const rowEl = document.getElementById(`cart-row-${productId}-${variantId}`);
        if (rowEl) {
            rowEl.style.transition = 'opacity 0.25s, transform 0.25s';
            rowEl.style.opacity = '0';
            rowEl.style.transform = 'translateY(10px)';
            setTimeout(() => {
                rowEl.remove();
                checkEmptyCartState();
            }, 250);
        }

        // Update summary fields
        updateCartSummary(data.cartSummary, data.count);

        if (window.showSuccess) {
            window.showSuccess('Item removed from cart!');
        }

        // Update navbar count badge
        if (typeof refreshNavbarCartCount === "function") {
            refreshNavbarCartCount();
        }
    } catch (error) {
        console.error("Remove cart item AJAX error:", error);
        Swal.fire({
            title: 'Error',
            text: error.message || 'An error occurred while removing the item.',
            icon: 'error',
            confirmButtonColor: '#111827'
        });
    }
}

/**
 * Update the billing breakdown card fields
 */
function updateCartSummary(summary, totalCount) {
    const subtotalEl = document.getElementById('summarySubtotal');
    const discountEl = document.getElementById('summaryDiscount');
    const shippingEl = document.getElementById('summaryShipping');
    const totalEl = document.getElementById('summaryGrandTotal');
    const totalSavingsEl = document.getElementById('summaryTotalSavings');
    const savingsAlert = document.getElementById('summarySavingsAlert');
    const totalItemsEl = document.getElementById('summaryTotalItems');

    if (subtotalEl) subtotalEl.textContent = summary.subtotal.toLocaleString();
    if (discountEl) discountEl.textContent = summary.discount.toLocaleString();
    
    if (shippingEl) {
        shippingEl.textContent = summary.shipping === 0 ? 'FREE' : '₹' + summary.shipping.toLocaleString();
    }
    if (totalEl) totalEl.textContent = summary.grandTotal.toLocaleString();

    if (totalItemsEl) {
        totalItemsEl.textContent = `${totalCount} Items`;
    }

    if (summary.discount > 0) {
        if (totalSavingsEl) totalSavingsEl.textContent = summary.discount.toLocaleString();
        if (savingsAlert) savingsAlert.style.display = 'flex';
    } else {
        if (savingsAlert) savingsAlert.style.display = 'none';
    }
}

/**
 * Check checkout viability based on remaining cards
 */
function checkEmptyCartState() {
    const remainingCards = document.querySelectorAll(".cart-item-modern-card");
    if (remainingCards.length === 0) {
        displayEmptyCartLayout();
    } else {
        // Also check if any card is out of stock or unlisted to disable/enable checkout trigger
        // Just reload the page once as a backup, or let the server EJS render handle it cleanly
        // Better: let EJS handle the layout refresh
    }
}

/**
 * Proceeds to Checkout flow
 */
function proceedToCheckout() {
    window.location.href = "/checkout";
}

/**
 * Show empty cart layout block
 */
function displayEmptyCartLayout() {
    const container = document.getElementById("pdpCartMainContainer");
    container.innerHTML = `
        <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-4 bg-white mt-4 mx-auto" style="max-width: 600px;" id="emptyCartState">
            <div class="text-muted mb-3.5">
                <span class="display-1 text-secondary opacity-50"><i class="bi bi-cart-x"></i></span>
            </div>
            <h3 class="fw-bold text-dark mb-2">Your cart is empty.</h3>
            <p class="text-secondary small mb-4">Add products to your cart to explore items and checkout.</p>
            <div class="d-flex justify-content-center">
                <a href="/shop" class="btn btn-dark rounded-3 px-4.5 py-2.5 fw-bold shadow-sm">
                    Continue Shopping
                </a>
            </div>
        </div>
    `;
}
</script>
