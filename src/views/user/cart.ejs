<style>
    .cart-section-wrapper {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background-color: #f8f9fa;
        min-height: 80vh;
    }
    .cart-grid-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(320px, 0.9fr);
        gap: 24px;
        align-items: start;
    }
    .cart-item-card {
        background-color: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 1.25rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .cart-item-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.04);
    }
    .cart-item-grid {
        display: grid;
        grid-template-columns: 96px minmax(0, 1fr) auto;
        gap: 20px;
        align-items: center;
    }
    .cart-image-wrapper {
        width: 96px;
        height: 96px;
        border-radius: 12px;
        border: 1px solid #f1f5f9;
        background-color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 6px;
    }
    .cart-image-wrapper img {
        max-width: 90%;
        max-height: 90%;
        object-fit: contain;
    }
    /* Modern Segmented Quantity Control */
    .cart-qty-control {
        display: inline-flex;
        align-items: center;
        background-color: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        overflow: hidden;
        height: 36px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        transition: opacity 0.15s ease;
    }
    .btn-qty-action {
        width: 36px;
        height: 36px;
        background-color: #ffffff;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #0f172a;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        transition: background-color 0.15s, color 0.15s;
    }
    .btn-qty-minus {
        border-right: 1px solid #e2e8f0 !important;
    }
    .btn-qty-plus {
        border-left: 1px solid #e2e8f0 !important;
    }
    .btn-qty-action:hover:not(:disabled) {
        background-color: #f1f5f9;
        color: #0f172a;
    }
    .btn-qty-action:disabled {
        background-color: #f8fafc !important;
        color: #94a3b8 !important;
        cursor: not-allowed !important;
        opacity: 1 !important; /* CRITICAL: Ensure minus/plus glyphs remain clearly visible when disabled */
    }
    .btn-qty-input {
        width: 44px !important;
        height: 36px;
        border: none;
        background-color: #ffffff;
        font-size: 0.95rem;
        font-weight: 700;
        color: #0f172a;
        text-align: center;
        padding: 0;
        cursor: default;
    }
    .btn-qty-input:focus {
        outline: none;
    }
    .btn-remove-item {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        border: 1px solid #fee2e2;
        background-color: #fff5f5;
        color: #ef4444;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .btn-remove-item:hover {
        background-color: #fee2e2;
        color: #b91c1c;
        border-color: #fca5a5;
    }
    .badge-discount-percent {
        font-size: 0.72rem;
        background-color: #fee2e2;
        color: #dc3545;
        border: 1px solid #fecaca;
        border-radius: 6px;
        padding: 2px 6px;
    }
    .sticky-summary {
        position: sticky;
        top: 24px;
    }

    @media (max-width: 991px) {
        .cart-grid-layout {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 640px) {
        .cart-item-grid {
            grid-template-columns: 80px minmax(0, 1fr);
            gap: 14px;
        }
        .cart-item-actions-col {
            grid-column: 1 / -1;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 12px;
            border-top: 1px solid #f1f5f9;
            margin-top: 6px;
        }
    }
</style>

<div class="cart-section-wrapper py-5">
    <div class="container-fluid px-3 px-md-4 px-xl-5" id="pdpCartMainContainer" style="max-width: 1400px; margin: 0 auto; width: 100%;">

        <!-- Page Header -->
        <div class="mb-4">
            <h1 class="fw-bold text-dark mb-1">Shopping Cart</h1>
            <p class="text-secondary small">Review items, adjust quantities, and checkout securely.</p>
        </div>

        <!-- Warning Price Alerts -->
        <% if (priceChanges && priceChanges.length > 0) { %>
            <div class="alert alert-warning alert-dismissible fade show rounded-3 mb-4 shadow-sm border-warning-subtle" role="alert">
                <div class="d-flex align-items-center mb-1">
                    <i class="bi bi-exclamation-triangle-fill text-warning fs-5 me-2"></i>
                    <strong class="text-dark">Cart Price / Quantity Alerts</strong>
                </div>
                <ul class="mb-0 small text-secondary ps-3">
                    <% priceChanges.forEach(msg => { %>
                        <li><%= msg %></li>
                    <% }) %>
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <% if (items && items.length > 0) { %>
            <!-- 2-column layout -->
            <div class="cart-grid-layout" id="pdpCartItemsRow">
                
                <!-- Left Grid: Cart items list -->
                <div class="d-flex flex-column gap-3">
                    <% items.forEach(item => { %>
                        <% const maxStock = Math.min(5, item.availableStock || 5); %>
                        <div class="card cart-item-card shadow-sm border-light-subtle" id="cart-row-<%= item.product._id %>-<%= item.variantId %>">
                            <div class="cart-item-grid">
                                
                                <!-- Column 1: Image -->
                                <div class="cart-image-wrapper shadow-sm">
                                    <img src="<%= item.imageSnapshot %>" alt="<%= item.nameSnapshot %>" loading="lazy">
                                </div>

                                <!-- Column 2: Detail info -->
                                <div class="min-w-0 text-start">
                                    <% if (item.product?.brand) { %>
                                        <span class="text-uppercase text-muted fw-bold d-block mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                            <%= item.product.brand.name %>
                                        </span>
                                    <% } %>
                                    
                                    <h5 class="fw-bold text-dark mb-1 text-truncate" style="font-size: 1.02rem;" title="<%= item.nameSnapshot %>">
                                        <a href="/product/<%= item.product._id %>" class="text-dark text-decoration-none">
                                            <%= item.nameSnapshot %>
                                        </a>
                                    </h5>

                                    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                                        <span class="badge bg-light text-secondary border px-2 py-0.5" style="font-size: 0.72rem;">
                                            <%= item.variantSnapshot %>
                                        </span>

                                        <% if (item.isUnavailable) { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-0.5" style="font-size: 0.72rem;">
                                                ⚠️ Unavailable
                                            </span>
                                        <% } else if (item.isOutOfStock) { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-0.5" style="font-size: 0.72rem;">
                                                🔴 Out of Stock
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-0.5" style="font-size: 0.72rem;">
                                                🟢 In Stock
                                            </span>
                                        <% } %>
                                    </div>

                                    <% if (item.appliedOffer && item.unitOfferDiscount > 0) { %>
                                        <div>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-0.5" style="font-size: 0.68rem;">
                                                <i class="bi bi-tag-fill me-1"></i><%= item.appliedOffer.offerName %> (-₹<%= item.offerDiscount.toLocaleString('en-IN') %>)
                                            </span>
                                        </div>
                                    <% } %>

                                    <% if (item.priceChanged) { %>
                                        <div class="mt-1">
                                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-2 py-0.5" style="font-size: 0.68rem;">
                                                <i class="bi bi-arrow-repeat me-1"></i>Price updated
                                            </span>
                                        </div>
                                    <% } %>
                                </div>

                                <!-- Column 3: Pricing, Quantity Controls & Trash -->
                                <div class="cart-item-actions-col d-flex flex-column align-items-end justify-content-between gap-3 text-end">
                                    
                                    <!-- Pricing -->
                                    <div>
                                        <% if (!item.isUnavailable && !item.isOutOfStock) { %>
                                            <div class="d-flex align-items-baseline gap-1.5 justify-content-end flex-wrap">
                                                <% if (item.appliedOffer && item.unitOfferDiscount > 0) { %>
                                                    <span class="fw-bold text-success fs-5">
                                                        ₹<%= item.effectiveItemPrice.toLocaleString('en-IN') %>
                                                    </span>
                                                    <span class="text-muted text-decoration-line-through small" style="font-size: 0.8rem;">
                                                        ₹<%= item.priceSnapshot.toLocaleString('en-IN') %>
                                                    </span>
                                                <% } else { %>
                                                    <span class="fw-bold text-dark fs-5">
                                                        ₹<%= item.priceSnapshot.toLocaleString('en-IN') %>
                                                    </span>
                                                    <% if (item.regularPrice && item.regularPrice > item.priceSnapshot) { %>
                                                        <span class="text-muted text-decoration-line-through small" style="font-size: 0.8rem;">
                                                            ₹<%= item.regularPrice.toLocaleString('en-IN') %>
                                                        </span>
                                                        <span class="badge-discount-percent fw-semibold">
                                                            <%= item.discountPercentage %>% OFF
                                                        </span>
                                                    <% } %>
                                                <% } %>
                                            </div>
                                            <div class="text-secondary small mt-0.5">
                                                Item Total: <strong class="text-dark">₹<span id="pdp-item-subtotal-<%= item.product._id %>-<%= item.variantId %>"><%= item.itemTotal.toLocaleString('en-IN') %></span></strong>
                                            </div>
                                        <% } else { %>
                                            <div class="text-danger small fw-semibold">
                                                <%= item.isUnavailable ? 'This product is no longer available.' : 'Currently unavailable.' %>
                                            </div>
                                        <% } %>
                                    </div>

                                    <!-- Quantity Controls & Trash Button -->
                                    <div class="d-flex align-items-center gap-2.5">
                                        <% if (!item.isUnavailable && !item.isOutOfStock) { %>
                                            <!-- Modern Quantity Segment [ - ] [ 1 ] [ + ] -->
                                            <div class="cart-qty-control" data-available-stock="<%= maxStock %>">
                                                <button 
                                                    class="btn-qty-action btn-qty-minus"
                                                    type="button" 
                                                    id="pdp-minus-<%= item.product._id %>-<%= item.variantId %>"
                                                    onclick="adjustCartQtyAjax('<%= item.product._id %>', '<%= item.variantId %>', -1)"
                                                    <%= item.quantity <= 1 ? 'disabled' : '' %>
                                                    title="Decrease quantity"
                                                    aria-label="Decrease quantity"
                                                >
                                                    <i class="bi bi-dash-lg"></i>
                                                </button>
                                                <input 
                                                    type="text" 
                                                    id="pdp-qty-<%= item.product._id %>-<%= item.variantId %>"
                                                    value="<%= item.quantity %>" 
                                                    class="btn-qty-input"
                                                    readonly
                                                    aria-label="Quantity"
                                                >
                                                <button 
                                                    class="btn-qty-action btn-qty-plus"
                                                    type="button" 
                                                    id="pdp-plus-<%= item.product._id %>-<%= item.variantId %>"
                                                    onclick="adjustCartQtyAjax('<%= item.product._id %>', '<%= item.variantId %>', 1)"
                                                    <%= item.quantity >= maxStock ? 'disabled' : '' %>
                                                    title="Increase quantity"
                                                    aria-label="Increase quantity"
                                                >
                                                    <i class="bi bi-plus-lg"></i>
                                                </button>
                                            </div>
                                        <% } %>

                                        <button 
                                            class="btn-remove-item"
                                            type="button"
                                            title="Remove Item"
                                            aria-label="Remove <%= item.nameSnapshot %> from cart"
                                            onclick="confirmRemoveCartItem('<%= item.product._id %>', '<%= item.variantId %>')"
                                        >
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>

                                </div>

                            </div>
                        </div>
                    <% }) %>
                </div>

                <!-- Right Grid: Price Summary stickies -->
                <div class="sticky-summary d-flex flex-column gap-3.5">
                    
                    <!-- Coupon Information Card -->
                    <div class="card border-light-subtle shadow-sm p-4 rounded-4 bg-white">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-tag-fill text-dark fs-5"></i>
                            <h6 class="fw-bold text-dark mb-0">Have a Coupon?</h6>
                        </div>
                        <p class="text-secondary small mb-3">
                            You can apply discount coupons directly at checkout on the final order review step.
                        </p>
                        <a href="/checkout" class="btn btn-outline-dark btn-sm rounded-3 fw-semibold w-100 py-2 d-flex align-items-center justify-content-center gap-2">
                            <span>Proceed to Apply at Checkout</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>

                    <!-- Sticky Summary Card -->
                    <div class="card border-light-subtle shadow-sm p-4 rounded-4 bg-white">
                        <h5 class="fw-bold text-dark mb-3.5">Price Details</h5>
                        
                        <div class="d-flex flex-column gap-2.5 mb-4" style="font-size: 0.9rem;">
                            
                            <div class="d-flex justify-content-between text-secondary">
                                <span>Total Items</span>
                                <% 
                                const totalItemsCount = items.reduce((acc, it) => acc + (it.isUnavailable || it.isOutOfStock ? 0 : it.quantity), 0);
                                %>
                                <span class="fw-bold text-dark" id="summaryTotalItems"><%= totalItemsCount %> Items</span>
                            </div>

                            <div class="d-flex justify-content-between text-secondary">
                                <span>Subtotal</span>
                                <span class="fw-bold text-dark">₹<span id="summarySubtotal"><%= cartSummary.subtotal.toLocaleString('en-IN') %></span></span>
                            </div>

                            <% if (cartSummary.totalOfferDiscount > 0) { %>
                                <div class="d-flex justify-content-between text-success" id="summaryOfferDiscountRow">
                                    <span>Offer Savings</span>
                                    <span class="fw-bold">-₹<span id="summaryOfferDiscount"><%= cartSummary.totalOfferDiscount.toLocaleString('en-IN') %></span></span>
                                </div>
                            <% } else { %>
                                <div class="d-flex justify-content-between text-success" id="summaryOfferDiscountRow" style="display: none;">
                                    <span>Offer Savings</span>
                                    <span class="fw-bold">-₹<span id="summaryOfferDiscount">0</span></span>
                                </div>
                            <% } %>

                            <div class="d-flex justify-content-between text-secondary">
                                <span>Discount Savings</span>
                                <span class="fw-bold text-success">-₹<span id="summaryDiscount"><%= cartSummary.discount.toLocaleString('en-IN') %></span></span>
                            </div>

                            <div class="d-flex justify-content-between text-secondary">
                                <span>Delivery Charges</span>
                                <span class="fw-bold text-dark" id="summaryShipping">
                                    <%= cartSummary.shipping === 0 ? 'FREE' : '₹' + cartSummary.shipping.toLocaleString('en-IN') %>
                                </span>
                            </div>

                            <% if (cartSummary.discount > 0) { %>
                                <div class="alert alert-success border-0 px-3 py-2 d-flex align-items-center gap-2 mb-0 mt-1" style="font-size: 0.8rem;" id="summarySavingsAlert">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span>You will save <strong>₹<span id="summaryTotalSavings"><%= cartSummary.discount.toLocaleString('en-IN') %></span></strong> on this order.</span>
                                </div>
                            <% } else { %>
                                <div class="alert alert-success border-0 px-3 py-2 d-flex align-items-center gap-2 mb-0 mt-1" style="font-size: 0.8rem; display: none;" id="summarySavingsAlert">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span>You will save <strong>₹<span id="summaryTotalSavings">0</span></strong> on this order.</span>
                                </div>
                            <% } %>

                            <hr class="my-2 text-muted opacity-25">

                            <div class="d-flex justify-content-between text-secondary fs-5 align-items-center pt-1">
                                <span class="fw-bold text-dark">Total Amount</span>
                                <span class="fw-bold text-dark">₹<span id="summaryGrandTotal"><%= cartSummary.grandTotal.toLocaleString('en-IN') %></span></span>
                            </div>

                        </div>

                        <!-- Checkout Trigger Button -->
                        <button 
                            type="button" 
                            id="checkoutBtn"
                            class="btn btn-dark w-100 rounded-3 py-2.5 fw-bold shadow-sm mb-2"
                            <%= canCheckout ? '' : 'disabled' %>
                            onclick="proceedToCheckout()"
                        >
                            Proceed to Checkout
                        </button>
                        
                        <div 
                            class="text-danger small text-center mt-2" 
                            id="checkoutWarning" 
                            style="<%= canCheckout ? 'display: none;' : 'display: block;' %>"
                        >
                            <i class="bi bi-exclamation-circle me-1"></i>
                            Remove unavailable or out-of-stock items to proceed.
                        </div>

                    </div>
                </div>
            </div>
        <% } else { %>
            <!-- Empty cart layout block -->
            <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-4 bg-white mt-4 mx-auto" style="max-width: 600px;">
                <div class="text-muted mb-3.5">
                    <span class="display-1 text-secondary opacity-50"><i class="bi bi-cart-x"></i></span>
                </div>
                <h3 class="fw-bold text-dark mb-2">Your cart is empty.</h3>
                <p class="text-secondary small mb-4">Add products to your cart to explore items and checkout.</p>
                <div class="d-flex justify-content-center">
                    <a href="/shop" class="btn btn-dark rounded-3 px-4.5 py-2.5 fw-bold shadow-sm">
                        Continue Shopping
                    </a>
                </div>
            </div>
        <% } %>
    </div>
</div>

<script>
// Lock map to prevent rapid-click race conditions on quantity changes
const cartUpdateLocks = {};

/**
 * AJAX adjust cart quantity handler
 */
async function adjustCartQtyAjax(productId, variantId, change) {
    const itemKey = `${productId}-${variantId}`;
    if (cartUpdateLocks[itemKey]) return; // In-flight request lock

    const qtyInput = document.getElementById(`pdp-qty-${itemKey}`);
    const minusBtn = document.getElementById(`pdp-minus-${itemKey}`);
    const plusBtn = document.getElementById(`pdp-plus-${itemKey}`);
    const qtyContainer = qtyInput ? qtyInput.closest(".cart-qty-control") : null;

    if (!qtyInput) return;

    const currentVal = parseInt(qtyInput.value, 10) || 0;
    const maxStock = qtyContainer ? (parseInt(qtyContainer.dataset.availableStock, 10) || 5) : 5;
    const maxAllowed = Math.min(5, maxStock);
    const newVal = currentVal + change;

    // Client-side bounds checks
    if (change < 0 && currentVal <= 1) return;
    if (change > 0 && currentVal >= maxAllowed) {
        if (typeof Swal !== "undefined") {
            Swal.fire({
                title: "Stock Limit",
                text: currentVal >= 5 ? "Maximum limit of 5 units per order reached." : "Maximum available quantity reached.",
                icon: "info",
                confirmButtonColor: "#0f172a",
                timer: 2000,
                showConfirmButton: false
            });
        }
        return;
    }

    if (newVal < 1 || newVal > maxAllowed) return;

    // Acquire lock and disable buttons during in-flight request
    cartUpdateLocks[itemKey] = true;
    if (minusBtn) minusBtn.disabled = true;
    if (plusBtn) plusBtn.disabled = true;
    if (qtyContainer) qtyContainer.style.opacity = "0.6";

    try {
        const response = await fetch('/cart/update-qty', {
            method: 'PATCH',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({
                productId,
                variantId,
                quantity: newVal
            })
        });

        if (response.status === 401) {
            window.location.href = "/auth/login";
            return;
        }

        const contentType = response.headers.get("content-type") || "";
        if (!contentType.includes("application/json")) {
            throw new Error("Unable to update cart. Please try again.");
        }

        const data = await response.json();
        if (!response.ok || !data.success) {
            throw new Error(data.message || "Failed to update quantity.");
        }

        // Update input value
        qtyInput.value = newVal;

        // Update item subtotal
        const itemSubtotal = document.getElementById(`pdp-item-subtotal-${itemKey}`);
        if (itemSubtotal && typeof data.itemTotal === "number") {
            itemSubtotal.textContent = data.itemTotal.toLocaleString('en-IN');
        }

        // Update summary fields
        if (data.cartSummary) {
            updateCartSummary(data.cartSummary, data.count);
        }

        // Update checkout eligibility
        if (typeof data.canCheckout === "boolean") {
            updateCheckoutEligibility(data.canCheckout, data.count);
        }

        // Toast Alert
        if (window.showSuccess) {
            window.showSuccess('Quantity updated successfully!');
        }

        // Update navbar count badge
        if (typeof refreshNavbarCartCount === "function") {
            refreshNavbarCartCount();
        }
    } catch (error) {
        console.error("Quantity adjust cart AJAX error:", error);
        if (typeof Swal !== "undefined") {
            Swal.fire({
                title: 'Notice',
                text: error.message || 'An error occurred while updating quantity.',
                icon: 'warning',
                confirmButtonColor: '#0f172a'
            });
        }
    } finally {
        delete cartUpdateLocks[itemKey];
        if (qtyContainer) qtyContainer.style.opacity = "1";
        const finalVal = parseInt(qtyInput.value, 10);
        if (minusBtn) minusBtn.disabled = (finalVal <= 1);
        if (plusBtn) plusBtn.disabled = (finalVal >= maxAllowed);
    }
}

/**
 * SweetAlert2 confirmation modal before removing item
 */
function confirmRemoveCartItem(productId, variantId) {
    if (typeof Swal !== "undefined") {
        Swal.fire({
            title: 'Remove Item?',
            text: "Are you sure you want to remove this item from your cart?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Remove'
        }).then((result) => {
            if (result.isConfirmed) {
                removeCartItemAjax(productId, variantId);
            }
        });
    } else {
        if (confirm("Are you sure you want to remove this item from your cart?")) {
            removeCartItemAjax(productId, variantId);
        }
    }
}

/**
 * AJAX remove item from cart
 */
async function removeCartItemAjax(productId, variantId) {
    try {
        const response = await fetch('/cart/remove', {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({
                productId,
                variantId
            })
        });

        if (response.status === 401) {
            window.location.href = "/auth/login";
            return;
        }

        const contentType = response.headers.get("content-type") || "";
        if (!contentType.includes("application/json")) {
            throw new Error("Unable to remove item. Please try again.");
        }

        const data = await response.json();
        if (!response.ok || !data.success) {
            throw new Error(data.message || "Failed to remove item.");
        }

        // Update summary fields
        if (data.cartSummary) {
            updateCartSummary(data.cartSummary, data.count);
        }

        // Update checkout eligibility immediately
        if (typeof data.canCheckout === "boolean") {
            updateCheckoutEligibility(data.canCheckout, data.count);
        }

        // Remove the product card element from the DOM
        const rowEl = document.getElementById(`cart-row-${productId}-${variantId}`);
        if (rowEl) {
            rowEl.style.transition = 'opacity 0.2s, transform 0.2s';
            rowEl.style.opacity = '0';
            rowEl.style.transform = 'translateY(10px)';
            setTimeout(() => {
                rowEl.remove();
                checkEmptyCartState(data.canCheckout);
            }, 200);
        }

        if (window.showSuccess) {
            window.showSuccess('Item removed from cart!');
        }

        // Update navbar count badge
        if (typeof refreshNavbarCartCount === "function") {
            refreshNavbarCartCount();
        }
    } catch (error) {
        console.error("Remove cart item AJAX error:", error);
        if (typeof Swal !== "undefined") {
            Swal.fire({
                title: 'Error',
                text: error.message || 'An error occurred while removing the item.',
                icon: 'error',
                confirmButtonColor: '#0f172a'
            });
        }
    }
}

/**
 * Update the billing breakdown card fields
 */
function updateCartSummary(summary, totalCount) {
    const subtotalEl = document.getElementById('summarySubtotal');
    const discountEl = document.getElementById('summaryDiscount');
    const shippingEl = document.getElementById('summaryShipping');
    const totalEl = document.getElementById('summaryGrandTotal');
    const totalSavingsEl = document.getElementById('summaryTotalSavings');
    const savingsAlert = document.getElementById('summarySavingsAlert');
    const totalItemsEl = document.getElementById('summaryTotalItems');
    const offerRow = document.getElementById('summaryOfferDiscountRow');
    const offerEl = document.getElementById('summaryOfferDiscount');

    if (subtotalEl && typeof summary.subtotal === "number") subtotalEl.textContent = summary.subtotal.toLocaleString('en-IN');
    if (discountEl && typeof summary.discount === "number") discountEl.textContent = summary.discount.toLocaleString('en-IN');

    if (offerRow && offerEl) {
        if (summary.totalOfferDiscount > 0) {
            offerEl.textContent = summary.totalOfferDiscount.toLocaleString('en-IN');
            offerRow.style.display = 'flex';
        } else {
            offerRow.style.display = 'none';
        }
    }
    
    if (shippingEl && typeof summary.shipping === "number") {
        shippingEl.textContent = summary.shipping === 0 ? 'FREE' : '₹' + summary.shipping.toLocaleString('en-IN');
    }
    if (totalEl && typeof summary.grandTotal === "number") totalEl.textContent = summary.grandTotal.toLocaleString('en-IN');

    if (totalItemsEl && typeof totalCount === "number") {
        totalItemsEl.textContent = `${totalCount} Items`;
    }

    if (summary.discount > 0) {
        if (totalSavingsEl) totalSavingsEl.textContent = summary.discount.toLocaleString('en-IN');
        if (savingsAlert) savingsAlert.style.display = 'flex';
    } else {
        if (savingsAlert) savingsAlert.style.display = 'none';
    }
}

/**
 * Update checkout button and warning message based on eligibility
 */
function updateCheckoutEligibility(canCheckout, totalCount) {
    if (totalCount === 0) {
        displayEmptyCartLayout();
        return;
    }

    const checkoutBtn = document.getElementById('checkoutBtn');
    const checkoutWarning = document.getElementById('checkoutWarning');

    if (checkoutBtn) {
        if (canCheckout) {
            checkoutBtn.removeAttribute('disabled');
        } else {
            checkoutBtn.setAttribute('disabled', 'disabled');
        }
    }

    if (checkoutWarning) {
        checkoutWarning.style.display = canCheckout ? 'none' : 'block';
    }
}

/**
 * Check checkout viability based on remaining cards
 */
function checkEmptyCartState(canCheckoutFromServer) {
    const remainingCards = document.querySelectorAll(".cart-item-card");
    if (remainingCards.length === 0) {
        displayEmptyCartLayout();
        return;
    }

    if (typeof canCheckoutFromServer === "boolean") {
        updateCheckoutEligibility(canCheckoutFromServer, remainingCards.length);
    } else {
        const hasBlockers = Array.from(remainingCards).some(card => {
            const dangerBadges = card.querySelectorAll(".badge.bg-danger-subtle");
            return dangerBadges.length > 0;
        });
        updateCheckoutEligibility(!hasBlockers, remainingCards.length);
    }
}

/**
 * Proceeds to Checkout flow
 */
function proceedToCheckout() {
    window.location.href = "/checkout";
}

/**
 * Show empty cart layout block
 */
function displayEmptyCartLayout() {
    const container = document.getElementById("pdpCartMainContainer");
    if (!container) return;
    container.innerHTML = `
        <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-4 bg-white mt-4 mx-auto" style="max-width: 600px;" id="emptyCartState">
            <div class="text-muted mb-3.5">
                <span class="display-1 text-secondary opacity-50"><i class="bi bi-cart-x"></i></span>
            </div>
            <h3 class="fw-bold text-dark mb-2">Your cart is empty.</h3>
            <p class="text-secondary small mb-4">Add products to your cart to explore items and checkout.</p>
            <div class="d-flex justify-content-center">
                <a href="/shop" class="btn btn-dark rounded-3 px-4.5 py-2.5 fw-bold shadow-sm">
                    Continue Shopping
                </a>
            </div>
        </div>
    `;
}
</script>
