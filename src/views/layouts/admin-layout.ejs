<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >
  <title>Electryve Admin</title>

  <link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
rel="stylesheet">
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
  >

  <link rel="stylesheet" href="/css/admin.css">
  <% if (typeof title !== "undefined" && (title === "Add Product" || title === "Edit Product")) { %>
    <link rel="stylesheet" href="https://unpkg.com/cropperjs@1.6.2/dist/cropper.min.css">
  <% } %>
</head>
<body>
  <div class="admin-wrapper">
    <header class="admin-header">
      <div class="admin-header-brand">
        <% if (user && user.role === "ADMIN") { %>
          <button type="button" class="sidebar-toggle-btn d-md-none" id="adminSidebarToggle" aria-label="Toggle navigation">
            <i class="bi bi-list"></i>
          </button>
        <% } %>
        <h1 class="logo">ELECTRYVE</h1>
      </div>

      <% if (user && user.role === "ADMIN") { %>
        <a href="/admin/logout" class="logout-btn">
          LOGOUT
        </a>
      <% } %>
    </header>

    <div class="admin-container">
      <% if (user && user.role === "ADMIN") { %>
        <div class="sidebar-backdrop d-md-none" id="adminSidebarBackdrop"></div>
        <aside class="sidebar">
          <nav>
            <ul>
              <li>
                <a href="/admin/dashboard" class="<%= (typeof title !== 'undefined' && title === 'Dashboard') ? 'active' : '' %>">
                  <i class="bi bi-grid"></i>
                  Dashboard
                </a>
              </li>

              <li>
                <a href="/admin/users">
                  <i class="bi bi-people"></i>
                  Users
                </a>
              </li>

              <li>
                <a href="/admin/categories">
                  <i class="bi bi-folder"></i>
                  Categories
                </a>
              </li>

              <li>
                <a href="/admin/brands">
                  <i class="bi bi-tags"></i>
                  Brands
                </a>
              </li>

              <li>
                <a href="/admin/products">
                  <i class="bi bi-box"></i>
                  Products
                </a>
              </li>

              <li>
                <a href="/admin/inventory">
                  <i class="bi bi-box-seam"></i>
                  Inventory
                </a>
              </li>

              <li>
                <a href="/admin/orders">
                  <i class="bi bi-cart"></i>
                  Orders
                </a>
              </li>

              <li>
                <a href="/admin/coupons">
                  <i class="bi bi-ticket-perforated"></i>
                  Coupons
                </a>
              </li>

              <li>
                <a href="/admin/offers">
                  <i class="bi bi-tag"></i>
                  Offers
                </a>
              </li>

              <li>
                <a href="/admin/sales-report">
                  <i class="bi bi-file-earmark-bar-graph"></i>
                  Sales Report
                </a>
              </li>

              <li>
                <a href="/admin/referrals">
                  <i class="bi bi-gift"></i>
                  Referrals
                </a>
              </li>
            </ul>
          </nav>
        </aside>
      <% } %>

      <main class="admin-content">
        <%- body %>
      </main>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="/js/sweetAlert.js"></script>

<script src="/js/admin.js"></script>

<% if (typeof title !== "undefined" && (title === "Add Product" || title === "Edit Product")) { %>

    <script
src="https://unpkg.com/cropperjs@1.6.2/dist/cropper.min.js">
</script>
    <script src="/js/productImageManager.js"></script>
    <script src="/js/productForm.js"></script>

<% } %>

</body>
</html>